  "obj_shop3_2196": "* Signed^1,&  Bratty <3/*",
  "obj_shop3_2198": "* Signed^1,&  Catty <3/*",
  "obj_shop4_244": "\\E0* The customer is&  always right./*",
  "obj_shop4_245": "\\E0* Welcome to MTT-Brand&  Burger Emporium^1, home&  of the Glamburger^1.&* Sparkle up your&  day (TM)./*",
  "obj_shop4_249": "\\E3* Anything else you&  need?/*",
  "obj_shop4_250": "\\E3* What can I do for you^1,&  little buddy?/*",
  "obj_shop4_252": "\\E1* (Why do I always&  get the freaks?)/*",
  "obj_shop4_329": "\\E0How can&I help&you, O&customer?/*",
  "obj_shop4_330": "\\E2Thanksy!&Have a&FABU-FUL&day!!!/*",
  "obj_shop4_331": "\\E1So do&you want&it or&not???/*",
  "obj_shop4_332": "\\E1That's not&the right&amount of&money./*",
  "obj_shop4_333": "\\E1You&don't&have&room./*",
  "obj_shop4_334": "\\E1We don't&HAVE&any&more./*",
  "obj_shop4_338": "\\E6Take what&you want^1,&little&buddy./*",
  "obj_shop4_339": "\\E6Here you&go^1,&little&buddy./*",
  "obj_shop4_340": "\\E6Don't&worry&about&it./*",
  "obj_shop4_341": "\\E6Sorry...&You can't&take it&for free./*",
  "obj_shop4_342": "\\E6You gotta&drop some&stuff./*",
  "obj_shop4_343": "\\E6Like I'm&making&THAT&again./*",
  "obj_shop4_347": "\\E3Are you&gonna&order or&what?/*",
  "obj_shop4_348": "\\E6Here you&go^1,&little&weirdo./*",
  "obj_shop4_349": "\\E1So do&you want&it or&not???/*",
  "obj_shop4_350": "\\E1That's not&the right&amount of&money./*",
