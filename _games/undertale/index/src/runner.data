  "obj_papdate_1028": "I^1, PAPYRUS.../%%",
  "obj_papdate_1032": "HUMAN^1.&IT'S CLEAR NOW./",
  "obj_papdate_1033": "YOU'RE COMPLETELY&OBSESSED WITH ME./",
  "obj_papdate_1034": "EVERYTHING YOU DO^1.&EVERYTHING&YOU SAY./",
  "obj_papdate_1035": "IT'S ALL BEEN&FOR MY SAKE./",
  "obj_papdate_1036": "HUMAN^1. I WANT&YOU TO BE&HAPPY^1,TOO./",
  "obj_papdate_1037": "IT'S TIME FOR ME&TO EXPRESS MY&FEELINGS./",
  "obj_papdate_1038": "IT'S TIME THAT&I TOLD YOU./",
  "obj_papdate_1039": "\\E8I^1, PAPYRUS.../%%",
  "obj_papdate_1079": "I.../",
  "obj_papdate_1080": "UM.../",
  "obj_papdate_1081": "\\E4BOY^1, IS IT HOT&IN HERE^1, OR IS&IT JUST ME??/",
  "obj_papdate_1082": "\\E4.../",
  "obj_papdate_1083": "\\E5OH^1, SHOOT./",
  "obj_papdate_1084": "HUMAN^1, I.../",
  "obj_papdate_1085": "I'M SORRY./",
  "obj_papdate_1086": "I DON'T LIKE YOU&THE WAY YOU&LIKE ME./",
  "obj_papdate_1087": "\\E4ROMANTICALLY^1,&I MEAN./",
  "obj_papdate_1088": "\\E6I MEAN^1, I TRIED&VERY HARD TO!/",
  "obj_papdate_1089": "\\E8I THOUGHT THAT&BECAUSE YOU&FLIRTED WITH ME.../",
  "obj_papdate_1090": "THAT I WAS&SUPPOSED&TO GO ON A&DATE WITH YOU./",
  "obj_papdate_1091": "\\E0THEN^1, ON THE DATE^1,&FEELINGS WOULD&BLOSSOM FORTH!!!/",
  "obj_papdate_1092": "\\E2I WOULD BE ABLE&TO MATCH YOUR&PASSION FOR ME!/",
  "obj_papdate_1093": "\\E4BUT ALAS..^1.&I^1, THE GREAT&PAPYRUS.../",
  "obj_papdate_1094": "\\E5HAVE FAILED./",
  "obj_papdate_1095": "I FEEL JUST THE&SAME AS BEFORE./",
  "obj_papdate_1096": "AND INSTEAD^1, BY&DATING YOU.../",
  "obj_papdate_1097": "I HAVE ONLY DRAWN&YOU DEEPER.../",
  "obj_papdate_1098": "\\E6INTO YOUR INTENSE&LOVE FOR ME!/",
  "obj_papdate_1099": "\\E5A DARK PRISON OF&PASSION^1, WITH NO&ESCAPE./",
  "obj_papdate_1100": "HOW COULD I HAVE&DONE THIS TO MY&DEAR FRIEND...?/",
  "obj_papdate_1101": ".../",
  "obj_papdate_1102": "\\E6NO^1! WAIT^1!&THAT'S WRONG!/",
  "obj_papdate_1103": "I CAN'T FAIL AT&ANYTHING!!!/",
  "obj_papdate_1104": "\\E1HUMAN!!^1!&I'LL HELP YOU&THROUGH THESE&TRYING TIMES!!!/",
  "obj_papdate_1105": "\\E0I'LL KEEP BEING&YOUR COOL&FRIEND.../",
  "obj_papdate_1106": "\\E8AND ACT LIKE THIS&ALL NEVER&HAPPENED./",
  "obj_papdate_1107": "\\E0AFTER ALL^1, YOU&ARE VERY GREAT./",
  "obj_papdate_1108": "\\E5IT WOULD BE&TRAGIC TO LOSE&YOUR FRIENDSHIP./",
  "obj_papdate_1109": "\\E0SO PLEASE..../",
  "obj_papdate_1110": "\\E5DON'T CRY BECAUSE&I WON'T KISS YOU./",
  "obj_papdate_1111": "\\E4BECAUSE^1, I DON'T&EVEN HAVE LIPS./",
  "obj_papdate_1112": "\\E0AND HEY^1, SOMEDAY^1,&YOU'LL FIND&SOMEONE AS&GREAT AS ME./",
  "obj_papdate_1113": "\\E8WELL, NO^1.&THAT'S NOT TRUE./",
  "obj_papdate_1114": "\\E0BUT I'LL HELP YOU&SETTLE FOR&SECOND BEST!!!/",
  "obj_papdate_1115": "NYEH HEH HEH&HEH HEH!!!/%%",
  "obj_papdate_1121": "\\E8HMM.../",
  "obj_papdate_1122": "\\E0WELL^1, I'M FLATTERED&YOU CARE SO MUCH./",
  "obj_papdate_1123": "\\E4BUT MAYBE COOL&IT A LITTLE BIT...?/",
  "obj_papdate_1124": "\\E0YOU ARE A VERY&NICE PERSON./",
  "obj_papdate_1125": "I'M GLAD WE'RE&FRIENDS./",
  "obj_papdate_1126": "\\E8BUT^1, I THINK YOU&CAN REACH YOUR&MAX POTENTIAL,,,/",
  "obj_papdate_1127": "\\E0IF YOU LIVE MORE&FOR YOUR OWN SAKE^1,&RATHER THAN JUST&FOR MINE./",
  "obj_papdate_1128": "\\E8HMMM.../",
  "obj_papdate_1129": "\\E0HEY^1, I KNOW THE&SOLUTION!!!/",
  "obj_papdate_1130": "YOU SHOULD HANG&OUT WITH MY BOSS^1,&UNDYNE!!!/",
  "obj_papdate_1131": "I THINK IF YOU&SPREAD YOUR FRIEND-&ENERGY OUT MORE.../",
  "obj_papdate_1132": "YOU'LL HAVE A MORE&HEALTHY LIFESTYLE./",
  "obj_papdate_1133": "YEAH!!^1!&LET'S BE FRIENDS&WITH UNDYNE!!!/",
  "obj_papdate_1134": "NYEH HEH HEH&HEH HEH!!!/%%",
  "obj_papdate_1175": "OH^1, AND IF YOU&EVER NEED TO&REACH ME.../",
  "obj_papdate_1176": "\\XHERE'S MY \\RPHONE&NUMBER\\X./",
  "obj_papdate_1177": "YOU CAN CALL&ME ANY TIME!/",
  "obj_papdate_1178": "\\E4PLATONICALLY./",
  "obj_papdate_1179": "\\E0WELL^1, GOTTA GO^1!&NYEH HEH HEH!/%%",
  "obj_papfridge_71": "AH-HA^1!&INTERESTED IN&MY FOOD MUSEUM?/",
  "obj_papfridge_72": "PLEASE^1.&PERUSE MY&CULINARY ARTSHOW./",
  "obj_papfridge_73": "\\TS \\F0 \\T0 %",
  "obj_papfridge_74": "* (Half of the fridge is&  filled with containers&  all labelled \"spaghetti.\")/",
  "obj_papfridge_75": "* (The other half contains&  nothing but an empty&  bag of chips.)/%%",
  "obj_papfridge_77": "GREAT FRIDGE^1,&ISN'T IT?/%%",
  "obj_papfridge_81": "* (Half of the fridge is&  filled with containers&  all labelled \"spaghetti.\")/",
  "obj_papfridge_82": "* (The other half contains&  nothing but an empty&  bag of chips.)/%%",
  "obj_paphouse_entrance_91": "* (It's locked.)/%%",
  "obj_paphouse_entrance_96": "WOW^1, YOU'RE SO&EAGER TO DATE&ME.../",
  "obj_paphouse_entrance_97": "WOW^1, YOU'RE SO&EAGER TO HANG&OUT.../",
  "obj_paphouse_entrance_98": "YOU'RE TRYING TO&GO INTO MY HOUSE&WITHOUT ME!/",
  "obj_paphouse_entrance_99": "THAT'S REALLY&WEIRD!!!/%%",
  "obj_paphouse_entrance_103": "* (It's unlocked.)/%%",
  "obj_papmailbox_74": "HOW NICE OF YOU&TO CHECK MY MAIL&FOR ME./",
  "obj_papmailbox_75": "\\E3WAIT^1, NO^1.&THAT'S VERY&STRANGE./%%",
  "obj_papmailbox_78": "\\E3STOP LOOKING IN&MY EMPTY&MAILBOX./",
  "obj_papmailbox_79": "\\E0THAT'S MY&EMPTINESS^1, NOT&YOURS./%%",
  "obj_papmailbox_96": "* Oh my god^1!&* The letter's not&  to PAPYRUS!!!/",
  "obj_papmailbox_98": "YEAH^1, UNDYNE'S&GOT A POINT!/",
  "obj_papmailbox_99": "\\E0WHY DIDN'T SHE&WRITE A LETTER&TO ME INSTEAD?/",
  "obj_papmailbox_101": "* Fine^1, you want a&  letter!?/",
  "obj_papmailbox_102": "* I'll give you a&  letter!!!/",
  "obj_papmailbox_103": "\\E6* YOU GET AN \"F\"!/",
  "obj_papmailbox_105": "OH NO!!!/",
  "obj_papmailbox_106": "\\E3WHAT'S THE F&FOR?/",
  "obj_papmailbox_108": "* Friendship!!!/%%",
  "obj_papsink_100": "IMPRESSED^1?&I INCREASED THE&HEIGHT OF MY SINK./",
  "obj_papsink_101": "NOW I CAN FIT MORE&BONES UNDER IT^1!&TAKE A LOOKSY!/%%",
  "obj_papsink_106": "FORGET IT./%%",
  "obj_papsink_111": "* (This sink is so tall^1, you&  can't even wash your&  hands...)/%%",
  "obj_papsink_234": "WHAT!?!?/%%",
  "obj_papsink_244": "CATCH THAT&MEDDLING CANINE!/%%",
  "obj_papsink_284": "CURSES!!!/%%",
  "obj_papsink_313": "SANS!/",
  "obj_papsink_314": "STOP PLAGUING MY&LIFE WITH INCIDENTAL&MUSIC!!!/%%",
  "obj_papstove_71": "* (There's an empty pie tin&  inside the stove.)/%%",
  "obj_papstove_75": "\\E0MY BROTHER ALWAYS&GOES OUT TO EAT^1.&BUT.../",
  "obj_papstove_76": "\\E3RECENTLY^1, HE TRIED&'BAKING' SOMETHING./",
  "obj_papstove_77": "IT WAS LIKE..^1.&A QUICHE./",
  "obj_papstove_78": "BUT FILLED WITH A&SUGARY^1, NON-EGG&SUBSTANCE./",
  "obj_papstove_79": "\\E0HOW ABSURD!/%%",
  "obj_papstove_82": "* (There's an empty pie tin&  inside the stove.)/%%",
  "obj_paptrash_68": "* (You visited the trash&  can.)/%%",
  "obj_paptrash_72": "THAT'S THE TRASH&CAN./",
  "obj_paptrash_73": "FEEL FREE TO VISIT&IT ANY TIME./%%",
  "obj_paptv_152": "\\E0OOH, IT'S MY&FAVORITE&GAME-SHOW!/",
  "obj_paptv_153": "\\TS \\F0 \\T0 %",
  "obj_paptv_154": "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/",
  "obj_paptv_156": "\\E1WHAT!!^1!&IT'S USUALLY&BETTER THAN THIS!/",
  "obj_paptv_157": "\\E2THIS IS JUST&A BAD EPISODE!!^1!&DON'T JUDGE ME!!!/%%",
  "obj_paptv_159": "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/%%",
  "obj_paptv_160": "* (It says \"STAY TUNED FOR&  A NEW PROGRAM - MTT.\")/%%",
  "obj_papyrus1_407": "SO^1, AS I&WAS SAYING&ABOUT UNDYNE,/%%",
  "obj_papyrus1_411": "\\E2SO SANS^1!&WHEN'S THE HUMAN&SHOWING UP???/",
  "obj_papyrus1_412": "\\E3I WANT TO LOOK&MY SUNDAY BEST.../",
  "obj_papyrus1_413": "\\E0OR AT LEAST MY&TUESDAY&PRETTY-GOOD./",
  "obj_papyrus1_415": "\\E1* don't you only have&  one outfit?/",
  "obj_papyrus1_417": "\\E2YEAH^1, BUT I COULD&STYLE MY HAIR!/",
  "obj_papyrus1_419": "\\E0* oh^1. right^1.&* good idea./",
  "obj_papyrus1_420": "\\E1* say^1, why don't you&  look over there?/%%",
  "obj_papyrus1_443": "SANS!!&OH MY GOD!!&IS THAT.../",
  "obj_papyrus1_444": "A HUMAN!?!?&!??!?!/%%",
  "obj_papyrus1_453": "SANS!!&OH MY GOD!!&IS THAT.../",
  "obj_papyrus1_454": "A HUMAN!?!?&!??!?!/",
  "obj_papyrus1_455": "AND IT LOOKS SO&FAMILIAR...!!!/%%",
  "obj_papyrus1_459": "\\E0SANS!!^1!&OH MY GOD!!!!/",
  "obj_papyrus1_460": "\\E3I'M DIZZY^1.&WHAT AM I LOOKING&AT?/",
  "obj_papyrus1_462": "\\E1* behold./%%",
  "obj_papyrus1_496": "* uhhhh.../",
  "obj_papyrus1_497": "\\E1* actually^1, i think that's&  a rock./%%",
  "obj_papyrus1_500": "* uhhhh..^1.&* i think it looks&  familiar.../",
  "obj_papyrus1_501": "\\E1* because it's a rock?/%%",
  "obj_papyrus1_509": "\\E0OH MY GOD!!!/%%",
  "obj_papyrus1_532": "OH^1./%%",
  "obj_papyrus1_534": "WHY ARE YOU&TELLING ME TO&LOOK AT A ROCK./%%",
  "obj_papyrus1_547": "* hey^1, what's that in&  front of the rock?/%%",
  "obj_papyrus1_567": "OH MY GOD!!!/%%",
  "obj_papyrus1_579": "(IS... IS THAT&A HUMAN)/%%",
  "obj_papyrus1_581": "I HAVE NO IDEA&WHAT THAT IS./%%",
  "obj_papyrus1_592": "(yes)/%%",
  "obj_papyrus1_594": "* well^1.&* it's not a rock./%%",
  "obj_papyrus1_607": "OH MY GOD!!!/",
  "obj_papyrus1_608": "SANS!&I FINALLY&DID IT!!/",
  "obj_papyrus1_609": "UNDYNE WILL.../",
  "obj_papyrus1_610": "I'M GONNA.../",
  "obj_papyrus1_611": "I'LL BE SO.../",
  "obj_papyrus1_612": "POPULAR!!^1!&POPULAR!!^1!&POPULAR!!^1!/",
  "obj_papyrus1_613": "\\E3..^1.'AHEM'/",
  "obj_papyrus1_614": "\\E1HUMAN^1! YOU&SHALL NOT PASS&THIS AREA!/",
  "obj_papyrus1_615": "I^1, THE GREAT&PAPYRUS^1, WILL&STOP YOU!!!/",
  "obj_papyrus1_616": "I WILL THEN&CAPTURE YOU!/",
  "obj_papyrus1_617": "YOU WILL BE&DELIVERED TO&THE CAPITAL!/",
  "obj_papyrus1_618": "THEN..^1.&THEN!!^1!/",
  "obj_papyrus1_619": "\\E3I'M NOT SURE&WHAT'S NEXT./",
  "obj_papyrus1_620": "\\E1IN ANY CASE!/",
  "obj_papyrus1_621": "CONTINUE...&ONLY IF YOU&DARE!!!/%%",
  "obj_papyrus1_624": "\\E3NOT A ROCK...?/",
  "obj_papyrus1_625": "\\E0OH NO!!^1!&BY PROCESS OF&ELIMINATION!!!/",
  "obj_papyrus1_626": "\\E0THAT MEANS IT'S&A HUMAN!!!/",
  "obj_papyrus1_627": "\\E3AHEM!^1!&HUMAN!!/",
  "obj_papyrus1_628": "\\E4PREPARE YOURSELF!^1!&FOR HIGH JINKS^1!&FOR LOW JINKS!/",
  "obj_papyrus1_629": "DANGERS^1!&PUZZLES^1!&CAPERS^1! JAPERS!/",
  "obj_papyrus1_630": "BEING CAPTURED!^1!&AND OTHER SORTS OF&FUN ACTIVITIES./",
  "obj_papyrus1_631": "REFRESHMENTS WILL&BE PROVIDED.../",
  "obj_papyrus1_632": "IF YOU DARE!/%%",
  "obj_papyrus1_647": "NYEH HEH HEH&HEH HEH HEH&HEH HEH!!!/%%",
  "obj_papyrus1_667": "* well^1, that went well./",
  "obj_papyrus1_668": "* don't sweat it^1, kid./",
  "obj_papyrus1_669": "\\E2* i'll keep an eyesocket&  out for ya./%%",
  "obj_papyrus1_672": "* ... and you don't even&  bat an eye^1, huh?/%%",
  "obj_papyrus2_201": "YOU'RE SO&LAZY!!/",
  "obj_papyrus2_202": "YOU WERE&NAPPING&ALL NIGHT!!/",
  "obj_papyrus2_204": "* i think that's called.../",
  "obj_papyrus2_205": "\\E1* sleeping./",
  "obj_papyrus2_207": "EXCUSES^1,&EXCUSES!/%%",
  "obj_papyrus2_213": "REALLY THOUGH!!^1!&THAT HUMAN!!!/",
  "obj_papyrus2_214": "\\E2DO I KNOW THAT&PERSON???/",
  "obj_papyrus2_216": "* do you not know.../",
  "obj_papyrus2_217": "\\E1* who you know?/",
  "obj_papyrus2_219": "PBPBPPBPT!!/",
  "obj_papyrus2_220": "OF COURSE I KNOW&WHO I KNOW!!/",
  "obj_papyrus2_221": "I WANTED TO KNOW IF&YOU KNOW.../",
  "obj_papyrus2_222": "I KNOW WHO I KNOW&AS MUCH AS I KNOW&I KNOW WHO I KNOW!/",
  "obj_papyrus2_223": "\\E2...YOU KNOW?/%%",
  "obj_papyrus2_256": "OH-HO^1!&THE HUMAN&ARRIVES!/",
  "obj_papyrus2_259": "OH-HO^1!&SPEAK OF THE DEVIL!/",
  "obj_papyrus2_261": "IN ORDER TO&STOP YOU^1.../",
  "obj_papyrus2_262": "MY BROTHER AND&I HAVE CREATED&SOME PUZZLES!/",
  "obj_papyrus2_263": "I THINK YOU&WILL FIND&THIS ONE.../",
  "obj_papyrus2_264": "\\E2QUITE&SHOCKING!!!/",
  "obj_papyrus2_265": "\\E0FOR YOU SEE^1,&THIS IS THE&INVISIBLE.../",
  "obj_papyrus2_266": "ELECTRICITY&MAZE!!!/",
  "obj_papyrus2_267": "WHEN YOU TOUCH&THE WALLS OF&THIS MAZE,/",
  "obj_papyrus2_268": "THIS ORB WILL&ADMINISTER A&HEARTY ZAP!/",
  "obj_papyrus2_269": "\\E2SOUND LIKE&FUN???/",
  "obj_papyrus2_270": "BECAUSE!/",
  "obj_papyrus2_271": "THE AMOUNT OF&FUN YOU WILL&PROBABLY HAVE,/",
  "obj_papyrus2_272": "\\E3IS ACTUALLY&RATHER SMALL&I THINK./",
  "obj_papyrus2_273": "\\E0OK^1, YOU CAN&GO AHEAD NOW./%%",
  "obj_papyrus2_334": "SANS!!^1!&WHAT DID YOU&DO?!?!/%%",
  "obj_papyrus2_347": "* i think the human&  has to hold the orb./%%",
  "obj_papyrus2_359": "OH^1, OKAY./%%",
  "obj_papyrus2_396": "HOLD THIS PLEASE!/%%",
  "obj_papyrus2_430": "OKAY^1, TRY NOW!/%%",
  "obj_papyrus2_452": "\\E1INCREDIBLE!!&YOU SLIPPERY&SNAIL!!/",
  "obj_papyrus2_453": "\\E3YOU SOLVED IT&SO EASILY..^1.&TOO EASILY!/",
  "obj_papyrus2_454": "\\E0HOWEVER!!/",
  "obj_papyrus2_455": "THE NEXT&PUZZLE WILL&NOT BE EASY!/",
  "obj_papyrus2_456": "IT IS DESIGNED&BY MY BROTHER^1,&SANS!/",
  "obj_papyrus2_457": "YOU WILL&SURELY BE&CONFOUNDED!/",
  "obj_papyrus2_458": "I KNOW I AM!/",
  "obj_papyrus2_459": "NYEH HEH HEH&HEH HEH!!/%%",
  "obj_papyrus2_506": "OH-HO^1!&THE HUMAN&ARRIVES!/",
  "obj_papyrus2_507": "IN ORDER TO&STOP YOU^1.../",
  "obj_papyrus2_508": "MY BROTHER AND&I HAVE CREATED&SOME PUZZLES!/",
  "obj_papyrus2_509": "I THINK YOU&WILL FIND&THIS ONE.../",
  "obj_papyrus2_510": "\\E2QUITE&SHOCKING!!!/",
  "obj_papyrus2_511": "\\E5FOR YOU SEE^1,&THIS IS..^1.&THE^1, INVISIBLE.../%%",
  "obj_papyrus2_552": "\\E5UHHHHHHH...?/",
  "obj_papyrus2_553": "\\E3HMMM..^1. YOU MUST&BE HAVING&CULTURE SHOCK./",
  "obj_papyrus2_554": "\\E0YOU SEE^1, WHERE I&COME FROM^1, IT'S&A LOVING TRADITION./",
  "obj_papyrus2_555": "TO SUFFER THROUGH&HORRIBLE PUZZLES&FOR NO REASON./",
  "obj_papyrus2_556": "\\E5SO^1, UH^1, JUST&WALK BACK THERE^1,&AND.../",
  "obj_papyrus2_557": ".../%%",
  "obj_papyrus2_601": "\\E3SIGH.../",
  "obj_papyrus2_602": "\\E3WHY COULDN'T WE GET&A HUMAN THAT LIKES&PUZZLES???/%%",
  "obj_papyrus3_177": "HUMAN!!^1!&I HOPE YOU'RE&READY FOR.../%%",
  "obj_papyrus3_200": "SANS!^1!&WHERE'S THE&PUZZLE!!!/",
  "obj_papyrus3_202": "* it's right there^1.&* on the ground./",
  "obj_papyrus3_203": "\\E1* trust me^1.&* there's no way they can&  get past this one./%%",
  "obj_papyrus3_206": "\\E1* trust me^1.&* there's no way they'll&  skip this one./%%",
  "obj_papyrus3_245": "WHAT THE HECK!!^1!&THEY DIDN'T SKIP&IT!?!?/",
  "obj_papyrus3_247": "* i'm tellin' ya^1.&* everyone likes word&  searches./",
  "obj_papyrus3_249": "OH MY GOD!!!/",
  "obj_papyrus3_250": "I CAN'T WORK IN&THIS ENVIRONMENT!!/%%",
  "obj_papyrus3_254": "SANS!!^1!&THAT DID NOTHING!!!/",
  "obj_papyrus3_256": "* whoops./",
  "obj_papyrus3_257": "\\E2* knew i should have&  put down junior jumble&  instead./",
  "obj_papyrus3_259": "WHAT?!^1?&JUNIOR JUMBLE!?/",
  "obj_papyrus3_260": "\\E0FINALLY^1, SOMETHING&WE CAN BOTH&AGREE ON./%%",
  "obj_papyrus4_209": "HEY!/",
  "obj_papyrus4_210": "IT'S THE HUMAN!/",
  "obj_papyrus4_211": "\\E0YOU'RE GONNA&LOVE THIS&PUZZLE!/",
  "obj_papyrus4_212": "IT WAS MADE&BY THE GREAT.../%%",
  "obj_papyrus4_405": "\\E3... ARE YOU&SERIOUS?/",
  "obj_papyrus4_406": "\\E1SANS!!^1!&HELP!!!/",
  "obj_papyrus4_407": "THEY KEEP WALKING&THROUGH MY PUZZLES!/",
  "obj_papyrus4_408": "\\E3THEY'RE SUPPOSED&TO LET ME&EXPLAIN THEM./",
  "obj_papyrus4_409": "\\E0THEN THREATEN AND&BAFFLE THEM WITH&DANGEROUS JAPES./",
  "obj_papyrus4_411": "* well^1, maybe they&  don't like japes./",
  "obj_papyrus4_413": "EVERYONE LIKES&JAPES!!!/",
  "obj_papyrus4_415": "* what about undyne^1?&* doesn't she hate&  puzzles?/",
  "obj_papyrus4_417": "SHE HATES PUZZLES^1.&BUT SHE LOVES&JAPES./",
  "obj_papyrus4_419": "* that makes sense./",
  "obj_papyrus4_421": "HUMAN!^1!&WHAT DO YOU&THINK!?/",
  "obj_papyrus4_422": "PUZZLES OR JAPES?/",
  "obj_papyrus4_423": ".../",
  "obj_papyrus4_424": "\\E3.../",
  "obj_papyrus4_425": "OKAY^1, THIS IS&NORMALLY THE&PART./",
  "obj_papyrus4_426": "WHERE YOU EITHER&AGREE OR DISAGREE./",
  "obj_papyrus4_427": "AND DEPENDING ON&YOUR ANSWER./",
  "obj_papyrus4_428": "\\E0WE SAY SOMETHING&GREAT IN RESPONSE./",
  "obj_papyrus4_429": "\\E3.../",
  "obj_papyrus4_430": "\\E0HERE^1, WHY DON'T&YOU DO THIS&PUZZLE YOURSELF./%%",
  "obj_papyrus5_209": "HUMAN!/",
  "obj_papyrus5_210": "\\E3HMMM..^1.&HOW DO I SAY&THIS.../",
  "obj_papyrus5_211": "\\E0YOU WERE TAKING A&LONG TIME TO&ARRIVE^1, SO.../",
  "obj_papyrus5_212": "I DECIDED TO&IMPROVE THIS&PUZZLE.../",
  "obj_papyrus5_213": "BY ARRANGING THE&SNOW TO LOOK MORE&LIKE MY FACE./",
  "obj_papyrus5_214": "\\E3UNFORTUNATELY^1,&THE SNOW FROZE&TO THE GROUND./",
  "obj_papyrus5_215": "\\E1NOW THE SOLUTION&IS DIFFERENT!/",
  "obj_papyrus5_216": "AND^1,AS USUAL^1, MY&LAZY BROTHER IS&NOWHERE AROUND./",
  "obj_papyrus5_217": "\\E3I SUPPOSE WHAT&I AM SAYING&IS.../",
  "obj_papyrus5_218": "\\E0WORRY NOT^1, HUMAN!/",
  "obj_papyrus5_219": "I^1, THE GREAT&PAPYRUS^1, WILL SOLVE&THIS CONUNDRUM!/",
  "obj_papyrus5_220": "THEN WE CAN BOTH&PROCEED!/",
  "obj_papyrus5_221": "MEANWHILE^1, FEEL&FREE TO TRY THE&PUZZLE YOURSELF!/",
  "obj_papyrus5_222": "I'LL TRY NOT TO&GIVE AWAY THE&ANSWER!!!/%%",
  "obj_papyrus5_281": "WOW!!^1!&YOU SOLVED IT!!/",
  "obj_papyrus5_282": "AND YOU DID IT&ALL WITHOUT MY&HELP.../",
  "obj_papyrus5_283": "MY ADVICE HELPED^1!&IT REALLY HELPED&YOU!!/",
  "obj_papyrus5_289": "INCREDIBLE^1!&I'M IMPRESSED!!/",
  "obj_papyrus5_290": "YOU MUST CARE&ABOUT PUZZLES&LIKE I DO!/",
  "obj_papyrus5_291": "WELL^1, I'M SURE&YOU'LL LOVE THE&NEXT PUZZLE THEN!/",
  "obj_papyrus5_292": "IT MIGHT EVEN&BE TOO EASY FOR&YOU!!/",
  "obj_papyrus5_293": "NYEH^1!&HEH HEH^1!&HEHEHEH!!!/%%",
  "obj_papyrus6_138": "HUMAN!/%%",
  "obj_papyrus7_156": "HUMAN!/",
  "obj_papyrus7_157": "THIS IS YOUR FINAL&AND MOST DANGEROUS&CHALLENGE!/",
  "obj_papyrus7_158": "BEHOLD^1!&THE GAUNTLET OF&DEADLY TERROR!/%%",
  "obj_papyrus7_194": "WHEN I SAY THE&WORD^1, IT WILL&FULLY ACTIVATE!!!/",
  "obj_papyrus7_195": "CANNONS WILL FIRE^1!&SPIKES WILL SWING^1!&BLADES WILL SLICE^1!/",
  "obj_papyrus7_196": "EACH PART WILL&SWING VIOLENTLY&UP AND DOWN!/",
  "obj_papyrus7_197": "ONLY THE TINIEST&CHANCE OF VICTORY&WILL REMAIN!!!/",
  "obj_papyrus7_198": "ARE YOU READY!?/",
  "obj_papyrus7_199": "BECAUSE!/",
  "obj_papyrus7_200": "I!/",
  "obj_papyrus7_201": "AM!/",
  "obj_papyrus7_202": "ABOUT!/",
  "obj_papyrus7_203": "TO DO IT!/%%",
  "obj_papyrus7_221": " %",
  "obj_papyrus7_222": "* well^1?&* what's the holdup?/",
  "obj_papyrus7_224": "HOLDUP!^1?&WHAT HOLDUP!?/",
  "obj_papyrus7_225": "I'M..^1.&I'M ABOUT TO&ACTIVATE IT NOW!/%%",
  "obj_papyrus7_244": " %",
  "obj_papyrus7_245": "* that^1, uh^1, doesn't look&  very activated./",
  "obj_papyrus7_247": "WELL!!!/",
  "obj_papyrus7_248": "THIS CHALLENGE!!!/",
  "obj_papyrus7_249": "\\E3IT SEEMS.../",
  "obj_papyrus7_250": "MAYBE..^1. TOO EASY&TO DEFEAT THE&HUMAN WITH./",
  "obj_papyrus7_251": "\\E1YEAH^1!&WE CAN'T USE&THIS ONE!!!/",
  "obj_papyrus7_252": "I AM A SKELETON&WITH STANDARDS!!!/",
  "obj_papyrus7_253": "MY PUZZLES ARE&VERY FAIR!/",
  "obj_papyrus7_254": "AND MY TRAPS ARE&EXPERTLY COOKED!/",
  "obj_papyrus7_255": "BUT THIS METHOD&IS TOO DIRECT^1!&NO CLASS AT ALL!/",
  "obj_papyrus7_256": "\\E0AWAY IT GOES!/%%",
  "obj_papyrus7_260": "WELL!!!/",
  "obj_papyrus7_261": "\\E3... THEY'RE PROBABLY&GOING TO WALK&THROUGH IT./",
  "obj_papyrus7_262": "AND IT WON'T BE&ANY FUN AT ALL./",
  "obj_papyrus7_264": "* hmmm...&* so this human thing&  was a bust^1, huh?/",
  "obj_papyrus7_266": "WELL^1. I MEAN^1.&I'M EXCITED TO&CAPTURE THEM./",
  "obj_papyrus7_267": "\\E0SO I'LL BECOME&A FAMOUS ROYAL&GUARDSMAN!!!/",
  "obj_papyrus7_268": "\\E3BUT ALL THE TIME&I PUT INTO THESE&PUZZLES.../",
  "obj_papyrus7_269": "IT'S KIND OF LIKE&THROWING A&BIRTHDAY PARTY.../",
  "obj_papyrus7_271": "* without traps and fire?/",
  "obj_papyrus7_273": "EXACTLY!^1!&IT'S POINTLESS!!!/",
  "obj_papyrus7_274": "\\E3MAYBE YOU WERE&RIGHT TO BE LAZY&ABOUT PUZZLES./",
  "obj_papyrus7_276": "* me^1?&* right about something^1?&* really?/",
  "obj_papyrus7_278": ".../",
  "obj_papyrus7_279": "\\E0YEAH!^1!&WHAT AM I SAYING!/",
  "obj_papyrus7_280": "YOU'RE STILL&COMPLETELY WRONG!/",
  "obj_papyrus7_281": "I JUST HAVE THE&WRONG AUDIENCE!/",
  "obj_papyrus7_282": "THINK ABOUT HOW&MUCH FUN UNDYNE&WOULD HAVE HERE!/",
  "obj_papyrus7_283": "FLAMES^1, VIOLENCE^1.&IT'S RIGHT UP HER&ALLEY!/",
  "obj_papyrus7_284": "SO I WON'T WASTE&THIS PUZZLE ON&YOU./",
  "obj_papyrus7_285": "I JUST HAVE TO&APPRECIATE.../",
  "obj_papyrus7_286": "THE FRIEND I&ALREADY HAVE!!!/%%",
  "obj_papyrus7_316": "PHEW!/%%",
  "obj_papyrus7_333": "WHAT ARE YOU&LOOKING AT!?/",
  "obj_papyrus7_334": "THIS WAS ANOTHER&DECISIVE VICTORY&FOR PAPYRUS!!/",
  "obj_papyrus7_335": "NYEH!!/",
  "obj_papyrus7_336": "HEH!!/",
  "obj_papyrus7_337": ".../",
  "obj_papyrus7_338": "\\E3HEH???/%%",
  "obj_papyrus7_341": "A VALUABLE LIFE&LESSON!!!/",
  "obj_papyrus7_342": "NYEH HEH HEH!!!/%%",
  "obj_papyrus8_184": "HUMAN./",
  "obj_papyrus8_185": "ALLOW ME TO TELL&YOU ABOUT SOME&COMPLEX FEELINGS./",
  "obj_papyrus8_188": "SOMEHOW^1, I FEEL LIKE&YOU'RE AN OLD FRIEND.../",
  "obj_papyrus8_189": "EVEN THOUGH I'VE&NEVER ACTUALLY MET&YOU BEFORE!!/",
  "obj_papyrus8_190": "I CAN'T EXPLAIN&WHY I FEEL THIS&WAY.../",
  "obj_papyrus8_191": "DID I MEET YOU&ONLINE???/",
  "obj_papyrus8_192": "I HAVE MANY \"SOCIAL&MEDIA CONNECTIONS.\"/",
  "obj_papyrus8_193": "IT'S HARD TO KEEP&TRACK OF THEM&ALL./",
  "obj_papyrus8_194": "JUST A DOZEN MORE^1,&AND.../",
  "obj_papyrus8_195": "I'LL FINALLY REACH&DOUBLE DIGITS!!!/",
  "obj_papyrus8_196": "... HEY^1, WAIT A&SECOND!/",
  "obj_papyrus8_197": "YOU CAN'T BE MY&FRIEND!!^1!&YOU'RE HUMAN!/",
  "obj_papyrus8_198": "I CAN'T BELIEVE YOU&ALMOST TRICKED ME INTO&NOT DEFEATING YOU!!!/",
  "obj_papyrus8_199": "WHOOPSIE DOOPSIE!/%%",
  "obj_papyrus8_202": "FEELINGS LIKE.../",
  "obj_papyrus8_203": "THE JOY OF FINDING&ANOTHER PASTA&LOVER./",
  "obj_papyrus8_204": "THE ADMIRATION FOR&ANOTHER'S PUZZLE-&SOLVING SKILLS./",
  "obj_papyrus8_205": "THE DESIRE TO HAVE&A COOL^1, SMART PERSON&THINK YOU ARE COOL./",
  "obj_papyrus8_206": "THESE FEELINGS.../",
  "obj_papyrus8_207": "THEY MUST BE WHAT&YOU ARE FEELING&RIGHT NOW!!!/",
  "obj_papyrus8_208": "I CAN HARDLY IMAGINE&WHAT IT MUST BE LIKE&TO FEEL THAT WAY./",
  "obj_papyrus8_209": "AFTER ALL^1, I AM&VERY GREAT./",
  "obj_papyrus8_210": "I DON'T EVER WONDER&WHAT HAVING LOTS&OF FRIENDS IS LIKE./",
  "obj_papyrus8_211": "I PITY YOU..^1.&LONELY HUMAN.../",
  "obj_papyrus8_212": "WORRY NOT!!^1!&YOU SHALL BE&LONELY NO LONGER!/",
  "obj_papyrus8_213": "I^1, THE GREAT&PAPYRUS^1, WILL BE&YOUR.../",
  "obj_papyrus8_214": " ^2.^2../",
  "obj_papyrus8_215": "NO.../",
  "obj_papyrus8_216": "NO^1, THIS IS ALL&WRONG!/",
  "obj_papyrus8_217": "I CAN'T BE YOUR&FRIEND!!!/",
  "obj_papyrus8_218": "YOU ARE A HUMAN!/",
  "obj_papyrus8_219": "I MUST CAPTURE&YOU!!!/",
  "obj_papyrus8_220": "THEN^1, I CAN FULFILL&MY LIFELONG DREAM!!!/",
  "obj_papyrus8_221": "POWERFUL^1!&POPULAR^1!&PRESTIGIOUS!!!/",
  "obj_papyrus8_222": "THAT'S PAPYRUS!!!/",
  "obj_papyrus8_223": "THE NEWEST MEMBER.../",
  "obj_papyrus8_224": "OF THE ROYAL GUARD!/%%",
  "obj_papyrus8_227": "OH..^1.&WHERE COULD THAT&HUMAN HAVE GONE./",
  "obj_papyrus8_228": "... WAIT..^1.&IT'S RIGHT IN&FRONT OF ME!!!/",
  "obj_papyrus8_229": "HELLO^1!&I WAS WORRIED THAT&YOU HAD GOTTEN LOST!/",
  "obj_papyrus8_230": "IT SURE IS A RELIEF&TO KNOW THAT&YOU'RE RIGHT HERE.../",
  "obj_papyrus8_231": "... WAIT A SECOND!!!/",
  "obj_papyrus8_232": "YOU'RE NOT SUPPOSED&TO ESCAPE!!!/",
  "obj_papyrus8_233": "GET BACK THERE!!!/%%",
  "obj_papyrus8_237": "I SUPPOSE THIS PROVES&WHAT I SAID./",
  "obj_papyrus8_238": "WE REALLY ARE BOUND&TOGETHER./",
  "obj_papyrus8_239": "TWO BONES IN THE&SKELETAL ANATOMY OF&FATE!!!/",
  "obj_papyrus8_240": "THAT'S HOW YOU APPEAR&HERE NOW.../",
  "obj_papyrus8_241": "EVEN THOUGH IT'S VERY&IMPOSSIBLE FOR YOU&TO ESCAPE./",
  "obj_papyrus8_242": "AMAZING!!!/",
  "obj_papyrus8_243": "I FEEL A SINCERE.../",
  "obj_papyrus8_244": "WAAAAAIT A SECOND!!/",
  "obj_papyrus8_245": "I STILL HAVE TO&CAPTURE YOU!!!/",
  "obj_papyrus8_246": "WHOOPSIE-DOOPSIE!!/%%",
  "obj_papyrus8_252": "BACK AGAIN^1, EH?/",
  "obj_papyrus8_253": "I SUPPOSE IT'S MY&FAULT.../",
  "obj_papyrus8_254": "I TOLD YOU BEFORE&THAT I WOULD MAKE&YOU SPAGHETTI./",
  "obj_papyrus8_255": "IT'S ONLY NATURAL&THAT YOU WOULD&WANT TO SEE ME.../",
  "obj_papyrus8_256": "IN THE DIRE HOPE&THAT I WOULD MAKE&YOU SOME./",
  "obj_papyrus8_257": "WELL..^1. I UNDERSTAND./",
  "obj_papyrus8_258": "PAPYRUS IS HUNGRY^1,&TOO!/",
  "obj_papyrus8_259": "HUNGRY FOR JUSTICE!/%%",
  "obj_papyrus8_271": "HALT^1, HUMAN!/%%",
  "obj_papyrus8_386": "I WAS NEVER ONE&  TO BEPIS./%%",
  "obj_papyrus8_414": "\\E1OH^1, I ALMOST&FORGOT TO TELL&YOU.../",
  "obj_papyrus8_415": "TO REACH THE EXIT^1,&YOU WILL HAVE&TO PASS.../",
  "obj_papyrus8_416": "\\WTHROUGH \\YTHE KING\\W'S&CASTLE./",
  "obj_papyrus8_419": "TO REACH THE EXIT^1,&YOU WILL HAVE&TO MEET.../",
  "obj_papyrus8_420": "THE KING./",
  "obj_papyrus8_422": "\\YTHE KING OF&ALL MONSTERS.../",
  "obj_papyrus8_423": "HE IS.../",
  "obj_papyrus8_424": "... WELL.../%%",
  "obj_papyrus8_441": "\\E0HE'S A BIG FUZZY&PUSHOVER!!!/",
  "obj_papyrus8_442": "EVERYBODY LOVES&THAT GUY./",
  "obj_papyrus8_443": "I AM CERTAIN IF&YOU JUST SAY.../",
  "obj_papyrus8_444": "\"EXCUSE ME^1, MR.&DREEMURR..^1. CAN I&PLEASE GO HOME?\"/",
  "obj_papyrus8_445": "HE'LL GUIDE YOU&RIGHT TO THE&BARRIER HIMSELF!/",
  "obj_papyrus8_446": "ANYWAY!!^1!&THAT'S ENOUGH&TALKING!!!/",
  "obj_papyrus8_447": "I'LL BE AT HOME&BEING A COOL&FRIEND!!!/",
  "obj_papyrus8_448": "FEEL FREE TO&COME BY AND&HANG OUT!!!/",
  "obj_papyrus8_449": "FEEL FREE TO&COME BY AND HAVE&THAT DATE!/",
  "obj_papyrus8_450": "NYEH HEH HEH HEH&HEH HEH HEH!!!/%%",
  "obj_papyrus8_515": "HEY^1, QUIT MOVING&WHILE I'M TALKING&TO YOU!/",
  "obj_papyrus8_516": "I^1, THE GREAT PAPYRUS^1,&HAVE SOME THINGS&TO SAY./",
  "obj_papyrus8_517": "FIRST^1: YOU'RE A&FREAKING WEIRDO!/",
  "obj_papyrus8_518": "NOT ONLY DO YOU&NOT LIKE PUZZLES./",
  "obj_papyrus8_519": "BUT THE WAY YOU&SHAMBLE ABOUT FROM&PLACE TO PLACE.../",
  "obj_papyrus8_520": "THE WAY YOUR HANDS&ARE ALWAYS COVERED&IN DUSTY POWDER./",
  "obj_papyrus8_521": "IT FEELS.../",
  "obj_papyrus8_522": "LIKE YOUR LIFE IS&GOING DOWN A&DANGEROUS PATH./",
  "obj_papyrus8_523": "HOWEVER!/",
  "obj_papyrus8_524": "I^1, PAPYRUS^1, SEE&GREAT POTENTIAL&WITHIN YOU!/",
  "obj_papyrus8_525": "EVERYONE CAN BE&A GREAT PERSON&IF THEY TRY!/",
  "obj_papyrus8_526": "AND ME^1, I HARDLY&HAVE TO TRY AT&ALL!!!/",
  "obj_papyrus8_527": "NYEH HEH HEH&HEH HEH HEH!!!/%%",
  "obj_papyrus8_555": "HEY^1, QUIT MOVING!/",
  "obj_papyrus8_556": "THIS IS EXACTLY&WHAT I AM TALKING&ABOUT!/",
  "obj_papyrus8_557": "HUMAN^1! I THINK&YOU ARE IN NEED&OF GUIDANCE!/",
  "obj_papyrus8_558": "SOMEONE NEEDS TO&KEEP YOU ON THE&STRAIGHT AND NARROW!/",
  "obj_papyrus8_559": "BUT WORRY NOT!&I^1, PAPYRUS.../",
  "obj_papyrus8_560": "WILL GLADLY BE&YOUR FRIEND AND&TUTOR!/",
  "obj_papyrus8_561": "I WILL TURN YOUR&LIFE RIGHT&AROUND!!!/%%",
  "obj_papyrus8_590": "I SEE YOU ARE&APPROACHING./",
  "obj_papyrus8_591": "ARE YOU OFFERING A&HUG OF ACCEPTANCE?/",
  "obj_papyrus8_592": "WOWIE!^1! MY LESSONS&ARE ALREADY&WORKING!!/",
  "obj_papyrus8_593": "I^1, PAPYRUS^1,&WELCOME YOU&WITH OPEN ARMS!/%%",
  "obj_papyrus_friendc_76": "\\E3SO^1, ASGORE.../",
  "obj_papyrus_friendc_77": "\\E0HOW ABOUT MAKING&ME A MEMBER OF&THE ROYAL GUARD?/",
  "obj_papyrus_friendc_79": "\\E2* Well^1, Papyrus^1, now&  that the war is&  over.../",
  "obj_papyrus_friendc_80": "\\E0* We might not need&  the Royal Guard&  anymore./",
  "obj_papyrus_friendc_82": "\\E7WHAT!?/",
  "obj_papyrus_friendc_83": "\\E1THEN WHAT WAS&THE POINT OF THE&HUMAN'S QUEST!?/",
  "obj_papyrus_friendc_84": "\\E3THEY JOURNEYED&ALL THAT WAY.../",
  "obj_papyrus_friendc_85": "\\E4AND I'M STILL&NOT A MEMBER OF&THE ROYAL GUARD!?/",
  "obj_papyrus_friendc_86": "\\E0TRULY^1, THIS IS&THE WORST&POSSIBLE ENDING./%%",
  "obj_papyrus_friendc_91": "\\E3IT SEEMS LIKE YOU&REALLY BOTCHED&YOUR QUEST^1, FRISK./",
  "obj_papyrus_friendc_92": "\\E0BUT^1, I^1, THE&GREAT PAPYRUS.../",
  "obj_papyrus_friendc_93": "WILL ALWAYS BE&YOUR FRIEND!!!/",
  "obj_papyrus_friendc_95": "\\E1* no matter how hard&  you try to get&  rid of him./",
  "obj_papyrus_friendc_97": "\\E1HEY!/",
  "obj_papyrus_friendc_98": "\\E0THAT'S TRUE./%%",
  "obj_papyrus_friendc_103": "\\E3FRISK^1, WHY DON'T&YOU TAKE A WALK&AROUND?/",
  "obj_papyrus_friendc_105": "\\E1* frisk^1, why don't you&  fly^1?&* it's faster./",
  "obj_papyrus_friendc_107": "\\E0YEAH^1, FRISK^1, WHY&DON'T YOU FLY?/",
  "obj_papyrus_friendc_109": "\\E1* Hmmm..^1. Flying sounds&  a little dangerous./",
  "obj_papyrus_friendc_111": "\\E3* But they CAN'T fly./",
  "obj_papyrus_friendc_113": "\\E2* Not with THAT&  attitude!/%%",
  "obj_papyrus_friendc_118": "\\E3FRISK..^1.&TAKE A HIKE./",
  "obj_papyrus_friendc_119": "\\E0HIKING IS GOOD&FOR YOUR BONES./%%",
  "obj_papyrus_guide_82": "WELCOME TO SCENIC&MY HOUSE!/",
  "obj_papyrus_guide_83": "ENJOY AND TAKE&YOUR TIME!!!/%%",
  "obj_papyrus_guide_84": "WOW!&BEING A GOOD HOST&IS A REAL WORKOUT!/%%",
  "obj_papyrus_guide_88": "\\E3I CAN'T FEEL MY&LEGS.../",
  "obj_papyrus_guide_89": "\\E0THAT MUST MEAN&I'M BEING A&GREAT HOST!!!/%%",
  "obj_papyrus_hisroom_86": "TAKE A LOOK&AROUND!/%%",
  "obj_papyrus_houseoutside_109": "SO YOU CAME&BACK TO HAVE A&DATE WITH ME!/",
  "obj_papyrus_houseoutside_110": "SO YOU CAME&BACK TO SEE ME!/",
  "obj_papyrus_houseoutside_111": "\\E3YOU MUST BE&REALLY SERIOUS&ABOUT THIS.../",
  "obj_papyrus_houseoutside_112": "\\E2I'LL HAVE TO TAKE&YOU SOMEPLACE&REALLY SPECIAL.../",
  "obj_papyrus_houseoutside_113": "\\E0A PLACE I LIKE&TO SPEND A LOT&OF TIME!!!/%%",
  "obj_papyrus_houseoutside_303": "MY HOUSE!!!/%%",
  "obj_papyrus_room_119": "MY BROTHER STARTED&A SOCK COLLECTION&RECENTLY./",
  "obj_papyrus_room_120": "\\E3HOW SADDENING.../",
  "obj_papyrus_room_121": "\\E0SOMETIMES I WONDER&WHAT HE WOULD&DO.../",
  "obj_papyrus_room_122": "WITHOUT SUCH A&COOL GUY TAKING&CARE OF HIM???/",
  "obj_papyrus_room_123": "NYEH HEH HEH!/%%",
  "obj_papyrus_room_129": "SO^1, YOU WANT&A HINT^1, HUH?/",
  "obj_papyrus_room_130": "\\E3WELL..^1.&I'VE BEEN LOOKING&AT THE PUZZLE.../",
  "obj_papyrus_room_131": "AND I THINK THE&SOLUTION.../",
  "obj_papyrus_room_132": "\\E0IS TO TURN ALL&OF THE X'S INTO&O'S!/",
  "obj_papyrus_room_133": "YOU SHOULD TRY&THAT!/",
  "obj_papyrus_room_134": "ASK AGAIN FOR&MORE GREAT HINTS!/%%",
  "obj_papyrus_room_135": "\\WMAYBE SOLVING&THE \\YLAST PUZZLE\\W &AGAIN WILL HELP./",
  "obj_papyrus_room_136": "ASK AGAIN FOR&MORE GREAT HINTS!!/%%",
  "obj_papyrus_room_157": "Error, Pepibs./%%",
  "obj_papyrus_room_161": "I ASKED UNDYNE&IF WE COULD&ALL HANG.../",
  "obj_papyrus_room_162": "\\E3BUT SHE SAID&SOMETHING WEIRD./",
  "obj_papyrus_room_163": "\\E0SHE SAID SHE&WON'T HANG OUT&WITH A MURDERER./",
  "obj_papyrus_room_164": "\\E3BUT..^1. HMM.../",
  "obj_papyrus_room_165": "\\E5I DON'T REMEMBER&MURDERERING&ANYONE.../",
  "obj_papyrus_room_166": "\\E3THOUGH I AM A&PRETTY BRUTAL&KIND OF GUY./",
  "obj_papyrus_room_167": "\\E3THEN SHE SAID&SOMETHING ABOUT&WANTING TO.../",
  "obj_papyrus_room_168": "\\E1FIGHT SOME KIND&OF BAD GUY./",
  "obj_papyrus_room_169": "\\E3BUT SHE SEEMS&VERY..^1. WEAK&FROM SOMETHING./",
  "obj_papyrus_room_170": "\\E5SHE STEPPED OUT&AND COLLAPSED IN&THE DOORWAY./",
  "obj_papyrus_room_171": "\\E0SO I'M JUST&WAITING HERE IN&CASE SHE NEEDS ME./",
  "obj_papyrus_room_172": "\\E3SINCE SHE HATES&BEING WAITED ON&HAND AND FOOT./",
  "obj_papyrus_room_173": "\\E5I THINK WE'LL&HAVE TO HANG&OUT LATER.../%%",
  "obj_papyrus_room_176": "HEY^1, I.../",
  "obj_papyrus_room_177": "\\E5REALLY DOUBT&WE'RE GOING TO&BE ABLE TO HANG./",
  "obj_papyrus_room_178": "\\E3IT'S HARD TO&IMAGINE^1, BUT.../",
  "obj_papyrus_room_179": "\\E0YOU'LL HAVE TO&SPEND TIME WITH&NOT ME./%%",
  "obj_papyrus_room_185": "HEY^1! READY TO&HANG OUT WITH&UNDYNE???/",
  "obj_papyrus_room_186": "GREAT!!^1!&ME TOO!!!/",
  "obj_papyrus_room_187": "\\E3HOWEVER^1, SHE'S&NOT HERE./",
  "obj_papyrus_room_188": "\\E0NORMALLY SHE&RETURNS AT ABOUT&THIS TIME./",
  "obj_papyrus_room_189": "\\E3SHE'S LATE&THOUGH.../",
  "obj_papyrus_room_190": "\\E3AND SHE'S NOT&ANSWERING HER&PHONE./",
  "obj_papyrus_room_191": "\\E0HOW STRANGE./",
  "obj_papyrus_room_192": "I'LL JUST WAIT&HERE UNTIL SHE&GETS HOME./",
  "obj_papyrus_room_193": "I'LL CALL YOU&WHEN SHE GETS&HERE^1, OKAY!?/%%",
  "obj_papyrus_room_196": "NOPE!^1!&SHE ISN'T HERE&YET!!!/%%",
  "obj_papyrus_room_202": "UNDYNE'S HOME^1,&BUT SHE ISN'T&FEELING WELL./",
  "obj_papyrus_room_203": "\\E5I DON'T THINK WE&CAN HANG OUT./",
  "obj_papyrus_room_204": "\\E3IT SEEMS LIKE SHE&CAUGHT HEAT-STROKE&OR SOMETHING./",
  "obj_papyrus_room_205": "SOMEONE MUST HAVE&BROUGHT HER&BACK HOME.../",
  "obj_papyrus_room_206": "\\E5BECAUSE SHE CAN&BARELY MOVE./",
  "obj_papyrus_room_207": "\\E0BUT SHE IS&MUTTERING ABOUT&DESTROYING YOU./",
  "obj_papyrus_room_208": "SO THAT'S A GOOD&VITAL SIGN./",
  "obj_papyrus_room_209": "\\E3IN ANY CASE^1, I&DON'T THINK WE&CAN HANG OUT./",
  "obj_papyrus_room_210": "\\E0I'M JUST WAITING&HERE IN CASE&SHE NEEDS ME./",
  "obj_papyrus_room_211": "SO^1, I GUESS YOU&CAN RUN ALONG./%%",
  "obj_papyrus_room_214": "UNDYNE IS SICK^1,&SO SHE CAN'T&PLAY TODAY./%%",
  "obj_papyrus_room_220": "HEY^1! READY TO&HANG OUT WITH&UNDYNE???/",
  "obj_papyrus_room_221": "GREAT!!^1!&BECAUSE SHE'S NOT&EVEN HERE./",
  "obj_papyrus_room_222": "BEING READY EARLY^1!&IT SHOWS HOW MUCH&YOU CARE!!/",
  "obj_papyrus_room_223": "\\E3EVEN IF SHE'S&NOT HERE TO SEE&THAT./%%",
  "obj_papyrus_room_226": "NOPE!^1!&SHE ISN'T HERE&YET!!!/%%",
  "obj_papyrus_room_244": "HELLO^1, MY FRIEND./",
  "obj_papyrus_room_245": "WHAT BRINGS YOU&TO PAPYRUS TOWN?/%%",
  "obj_papyrus_room_248": "HELLO..^1.&H-HOW ARE YOU^1,&MY F-FRIEND?/",
  "obj_papyrus_room_249": "\\E5I'M FEELING VERY&NOT SUSPICIOUS&TODAY./%%",
  "obj_papyrus_room_253": "HEY^1, I HAVE A&GREAT IDEA./",
  "obj_papyrus_room_254": "LET'S HANG OUT&WITH UNDYNE&LATER./",
  "obj_papyrus_room_255": "I'LL CALL YOU&WHEN I'M READY!/%%",
  "obj_papyrus_room_259": "I'M SO GLAD YOU&AND UNDYNE ARE&FRIENDS NOW./",
  "obj_papyrus_room_260": "YOU TWO GO&TOGETHER LIKE&PASTA AND BURNING!/%%",
  "obj_papyrus_room_263": "OH^1, HEY.../",
  "obj_papyrus_room_264": "\\E3YOU'RE LEAVING&SOON^1, RIGHT!?/",
  "obj_papyrus_room_265": "\\E1DON'T COME HERE&TO SAY GOODBYE!!/",
  "obj_papyrus_room_266": "\\E3GOODBYES AREN'T&ALLOWED IN MY&TOWN./",
  "obj_papyrus_room_267": "\\E0JUST SEE-YOU-&LATERS./%%",
  "obj_papyrus_room_272": "IT SEEMS UNDYNE&HAS SOMETHING&FOR YOU./",
  "obj_papyrus_room_273": "SHE'S THE PERSON&THAT'S NOT ME./%%",
  "obj_papyrus_room_278": "UNDYNE WRITES A&LOT OF LETTERS./",
  "obj_papyrus_room_279": "\\E3BUT^1, SHE CAN NEVER&SEEM TO FIND THE&RIGHT WORDS./",
  "obj_papyrus_room_280": "SO WHEN SHE GOES&TO DELIVER THEM&HERSELF.../",
  "obj_papyrus_room_281": "SHE ALWAYS QUITS&SO SHE CAN GO&BACK AND REWRITE./",
  "obj_papyrus_room_282": "\\E0THAT'S WHY SHE&ASKED YOU!!/",
  "obj_papyrus_room_283": "BECAUSE YOU HAVE&NO STANDARDS!!!/%%",
  "obj_papyrus_room_287": "ALPHYS SEEMS TO&HAVE DISAPPEARED./",
  "obj_papyrus_room_288": "DON'T WORRY^1, THAT'S&NORMAL./",
  "obj_papyrus_room_289": "YOU SHOULD GO&TO HER LAB./",
  "obj_papyrus_room_290": "I'M SUPPOSED TO&PUT THESE&NUMBERS TOGETHER./%%",
  "obj_papyrusboss_270": " ALAS^1, POOR& PAPYRUS!/%%",
  "obj_papyrusboss_272": " W-WELL^1, THAT'S& NOT WHAT I& EXPECTED.../%%",
  "obj_papyrusboss_282": " WELL^1, AT LEAST I& STILL HAVE MY& HEAD!/%%",
  "obj_papyrusboss_285": " BUT.../",
  "obj_papyrusboss_286": " ST..^1. STILL^1!& I BELIEVE IN& YOU!/",
  "obj_papyrusboss_287": " YOU CAN DO A& LITTLE BETTER!/",
  "obj_papyrusboss_288": " EVEN IF YOU& DON'T THINK SO!/",
  "obj_papyrusboss_289": " I..^1.& I PROMISE.../%%",
  "obj_papyrusboss_402": " WELL...! *HUFF^1*& IT'S CLEAR...& YOU CAN'T^1! *HUFF^1*& DEFEAT ME!!!/",
  "obj_papyrusboss_403": " YEAH!!!& I CAN SEE YOU& SHAKING IN YOUR& BOOTS!!!/",
  "obj_papyrusboss_404": " THEREFORE I^1, THE& GREAT PAPYRUS^1,& ELECT TO GRANT& YOU PITY!!/",
  "obj_papyrusboss_405": "\\X I WILL \\RSPARE\\X YOU,& HUMAN!!!/",
  "obj_papyrusboss_406": " \\XNOW'S YOUR CHANCE& TO ACCEPT MY& \\RMERCY\\X./%%",
  "obj_papyrusboss_423": "* Papyrus is sparing you.",
  "obj_papyrusboss_456": " WHAT THE HECK!/",
  "obj_papyrusboss_457": " THAT'S MY& SPECIAL ATTACK!/%%",
  "obj_papyrusboss_466": " HEY^1!& YOU STUPID DOG!/%%",
  "obj_papyrusboss_477": " DO YOU HEAR& ME!?/",
  "obj_papyrusboss_478": " STOP MUNCHING ON& THAT BONE!!!/%%",
  "obj_papyrusboss_487": " HEY!!!& WHAT ARE YOU& DOING!!!/",
  "obj_papyrusboss_488": " COME BACK HERE& WITH MY SPECIAL& ATTACK!!!/%%",
  "obj_papyrusboss_502": " .../",
  "obj_papyrusboss_503": " OH WELL./",
  "obj_papyrusboss_504": " I'LL JUST USE& A REALLY COOL& REGULAR ATTACK./%%",
  "obj_papyrusboss_514": "* Papyrus is getting ready&  for a regular attack.",
  "obj_papyrusboss_548": "  ...",
  "obj_papyrusboss_552": " OH^1, I SHOULD& HAVE BROUGHT ONE&  OF THOSE.",
  "obj_papyrusboss_558": " SO YOU'RE& SERIOUS.../",
  "obj_papyrusboss_559": " SO YOU WON'T& FIGHT.../",
  "obj_papyrusboss_560": " THEN^1, LET'S SEE& IF YOU CAN HANDLE& MY FABLED& 'BLUE ATTACK!'/%%",
  "obj_papyrusboss_561": "%%%",
  "obj_papyrusboss_570": " BEHOLD!",
  "obj_papyrusboss_571": " HMMM... I WONDER& WHAT I SHOULD& WEAR...",
  "obj_papyrusboss_572": " HOW HIGH CAN YOU& JUMP?",
  "obj_papyrusboss_573": " WHAT!? I'M NOT& THINKING ABOUT& THAT DATE THING!!",
  "obj_papyrusboss_574": " TRY HOLDING THE& 'UP' BUTTON TO& JUMP!!!",
  "obj_papyrusboss_575": "\\X YEAH!& DON'T MAKE ME& USE MY \\RSPECIAL& ATTACK\\X!",
  "obj_papyrusboss_576": " HOLD 'UP' LONGER& TO JUMP HIGHER!& JEEZ!!!",
  "obj_papyrusboss_577": " I CAN ALMOST& TASTE MY FUTURE& POPULARITY!!!",
  "obj_papyrusboss_578": " PAPYRUS:& HEAD OF THE& ROYAL GUARD!",
  "obj_papyrusboss_579": " PAPYRUS:& UNPARALLELED& SPAGHETTORE!",
  "obj_papyrusboss_580": " UNDYNE WILL BE& REALLY PROUD& OF ME!!",
  "obj_papyrusboss_581": " THE KING WILL& TRIM A HEDGE& IN THE SHAPE& OF MY SMILE!!!",
  "obj_papyrusboss_582": " MY BROTHER WILL& ... WELL, HE& WON'T CHANGE& VERY MUCH.",
  "obj_papyrusboss_583": " I'LL HAVE LOTS& OF ADMIRERS!!& BUT...",
  "obj_papyrusboss_584": " HOW WILL I& KNOW IF PEOPLE& SINCERELY LIKE& ME???",
  "obj_papyrusboss_585": " WILL ANYONE LIKE& ME AS SINCERELY& AS YOU?",
  "obj_papyrusboss_586": " SOMEONE LIKE& YOU IS REALLY& RARE...",
  "obj_papyrusboss_587": " I DON'T THINK& THEY'LL LET YOU& GO...",
  "obj_papyrusboss_588": " AND DATING MIGHT& BE KIND OF& HARD...",
  "obj_papyrusboss_589": " AFTER YOU'RE& CAPTURED AND& SENT AWAY.",
  "obj_papyrusboss_590": " URGH...& WHO CARES!& GIVE UP!!",
  "obj_papyrusboss_591": "\\X GIVE UP OR& FACE MY...& \\RSPECIAL ATTACK\\X!!!",
  "obj_papyrusboss_592": "\\X YEAH!!!& VERY SOON I WILL& USE MY& \\RSPECIAL ATTACK\\X! ",
  "obj_papyrusboss_593": "\\X NOT TOO LONG& AND I WILL& USE THAT& \\RSPECIAL ATTACK\\X!!!",
  "obj_papyrusboss_594": "\\X THIS IS YOUR& LAST CHANCE...& BEFORE MY& \\RSPECIAL ATTACK\\X!!",
  "obj_papyrusboss_595": "\\X BEHOLD...!& MY \\RSPECIAL& ATTACK\\X!",
  "obj_papyrusboss_596": " *SIGH* HERE'S AN& ABSOLUTELY& NORMAL ATTACK.",
  "obj_papyrusboss_604": " NYEH HEH HEH!",
  "obj_papyrusboss_605": " I DON'T DESERVE& SUCH HOSPITALITY& FROM YOU ...",
  "obj_papyrusboss_606": " YOUR BARBS HIDE A& HIDDEN AFFECTION^1!& YOU EMOTIONAL& CACTUS!",
