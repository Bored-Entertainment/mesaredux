  "SCR_TEXT_4263": " ",
  "SCR_TEXT_4270": " %%",
  "SCR_TEXT_4276": " %%",
  "SCR_TEXT_4282": "\\M4* BASKETBALL'S A BLAST^1, ISN'T IT^1,&  DARLING?/",
  "SCR_TEXT_4283": "\\M1* TOO BAD YOU CAN'T PLAY WITH&  THESE BALLS./",
  "SCR_TEXT_4284": "\\M4* THEY'RE MTT-BRAND FASHION&  BASKETBALLS^1.&* FOR WEARING^1, NOT PLAYING./",
  "SCR_TEXT_4285": "\\M6* YOU CAN'T GET RICH AND FAMOUS&  LIKE MOI WITHOUT BEAUTIFYING&  A FEW ORBS./",
