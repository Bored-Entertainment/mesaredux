  "obj_migospel_465": "* MIGOSPEL - ATK 28 DEF 17&* This messed-up clownbug thinks&  battle's a performance./^",
  "obj_migospel_474": "* Talking has no effect./^",
  "obj_mkid_actor_337": "* So^1, one time./",
  "obj_mkid_actor_338": "* We had a school project where&  we had to take care of&  a flower./",
  "obj_mkid_actor_339": "* The king ^1- we had to call him&  \"Mr. Dreemurr\" ^1- volunteered&  to donate his own flowers./",
  "obj_mkid_actor_340": "* He ended up coming to school&  and teaching the class about&  responsibility and stuff./",
  "obj_mkid_actor_341": "* That got me thinking.../",
  "obj_mkid_actor_342": "* YO^1!&* How COOL would it be if&  UNDYNE came to school!?/",
  "obj_mkid_actor_343": "* She could beat up ALL&  the teachers!!/%%",
  "obj_mkid_battle_207": "...",
  "obj_mkid_battle_208": "...",
  "obj_mkid_battle_209": "...",
  "obj_mkid_battle_210": "...",
  "obj_mkid_battle_215": "%%%",
  "obj_mkid_battle_450": "* Monster Kid quivers anxiously.",
  "obj_mkid_battle_479": "* MONSTER KID 2 ATK 2 DEF&* Looks like free EXP./^",
  "obj_mkid_battle_553": "Undyne..^1.&You're..^1.&You're hurt.../%%",
  "obj_mkid_battle_565": "Hurt?&It's nothing./",
  "obj_mkid_battle_566": "Next time^1, listen&when I tell you&to leave^1, okay?/%%",
  "obj_mkid_battle_574": "Undyne..^1.&I.../%%",
  "obj_mkid_battle_584": "I'll take care of&this!/",
  "obj_mkid_battle_585": "Get out of here!/%%",
  "obj_mkid_battle_632": "... heh...&\"It's nothing\".../",
  "obj_mkid_battle_633": "No..^1. s-somehow^1,&with just one&hit.../",
  "obj_mkid_battle_634": "I'm already.../",
  "obj_mkid_battle_635": "Already.../",
  "obj_mkid_battle_636": "D..^1. damn it..../%%",
  "obj_mkid_battle_655": "Papyrus..^1.&Alphys..^1.&ASGORE.../",
  "obj_mkid_battle_656": "Just like that^1,&I.../",
  "obj_mkid_battle_657": "I've failed you./%%",
  "obj_mkid_battle_689": ".../",
  "obj_mkid_battle_690": "No.../%%",
  "obj_mkid_battle_702": "My body..^1.&It feels like it's&splitting apart./",
  "obj_mkid_battle_703": "Like any instant..^1.&I'll scatter into&a million pieces./",
  "obj_mkid_battle_704": "But.../",
  "obj_mkid_battle_705": "Deep^1, deep in my&soul./",
  "obj_mkid_battle_706": "There's a burning&feeling I can't&describe./",
  "obj_mkid_battle_707": "\\E6A burning feeling&that WON'T let me&die./",
  "obj_mkid_battle_708": "\\E5This isn't just&about monsters&anymore^1, is it?/",
  "obj_mkid_battle_709": "If you get past&me^1, you'll.../",
  "obj_mkid_battle_710": "You'll destroy them&all^1, won't you?/",
  "obj_mkid_battle_711": "Monsters..^1.&Humans..^1.&Everyone.../",
  "obj_mkid_battle_712": "Everyone's hopes^1.&Everyone's dreams^1.&Vanquished in an&instant./",
  "obj_mkid_battle_713": "\\E6But I WON'T let&you do that./",
  "obj_mkid_battle_714": "Right now^1, everyone&in the world.../",
  "obj_mkid_battle_715": "\\E7I can feel their&hearts beating as&one./",
  "obj_mkid_battle_716": "And we all have&ONE goal./",
  "obj_mkid_battle_717": "\\E8To defeat YOU./",
  "obj_mkid_battle_718": "\\E7Human^1.&No^1, WHATEVER you&are./",
  "obj_mkid_battle_719": "\\E8For the sake of&the whole world.../%%",
  "obj_mkid_battle_728": "\\E9I^1, UNDYNE^1, will&strike you down!/%%",
  "obj_mkid_battle_827": "You're gonna have&to try a little&harder than THAT./%%",
  "obj_mkid_battle_883": "You.../",
  "obj_mkid_battle_884": "\\E9You're gonna have&to try a little&harder than THAT!/%%",
  "obj_mkid_goner_91": "* Yo^1!&* You're a ??? too^1, right?/%%",
  "obj_mkid_goner_95": "* Have you ever thought about&  a world where everything is&  exactly the same.../",
  "obj_mkid_goner_96": "* Except you don't exist?/",
  "obj_mkid_goner_97": "* Everything functions&  perfectly without you.../",
  "obj_mkid_goner_98": "* Ha^1, ha..^1.&* The thought terrifies me./%%",
  "obj_mkid_goner_102": "* .../%%",
  "obj_mkid_goner_107": "* An umbrella...^1?&* But it's not raining./",
  "obj_mkid_goner_108": "* Ha^1, ha.../",
  "obj_mkid_goner_109": "* You know^1, that does make&  me feel a little better&  about this./",
  "obj_mkid_goner_110": "* Thank you./",
  "obj_mkid_goner_111": "* Please forget about me./%%",
  "obj_mkid_goner_115": "* Please don't think about&  this anymore./%%",
