        if (keyboard_check_pressed(ord("R")) && instance_exists(obj_essaystuff) == false)
        {
            debug_r += 1
            if (debug_r > 5)
                game_restart()
            spec_rtimer = 1
        }
    }
    spec_rtimer += 1
    if (spec_rtimer >= 6)
        debug_r = 0
    if keyboard_check(vk_escape)
    {
        quit += 1
        if (instance_exists(obj_quittingmessage) == false)
            instance_create(0, 0, obj_quittingmessage)
    }
    else
        quit = 0
}
