  "obj_papdate_381": "\\F3 \\E2 %",
  "obj_papdate_382": "NO..^1.&COULD IT BE???/",
  "obj_papdate_383": "\\F0 \\E1 %",
  "obj_papdate_386": "YOU'VE WANTED TO&DATE ME FROM&THE VERY&BEGINNING!??/*",
  "obj_papdate_389": "YOU'VE WANTED TO&HANG OUT WITH&ME FROM THE&VERY BEGINNING!??/*",
  "obj_papdate_404": "                              &   Yes             No       &                            ",
