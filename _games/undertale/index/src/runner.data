	var room_name = _args[0];
	
	if (is_string(room_name))
	{
		var room_index = asset_get_index(room_name);
		if (room_index != -1)
			room_goto(asset_get_index(room_name));
		else
			command_writeline($"Unable to find room: \"{room_name}\"");
	}
}
