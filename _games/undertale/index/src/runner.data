  "obj_papdate_232": "\\E3.../",
  "obj_papdate_233": "\\E3OKAY^1, FORGET IT./%%",
  "obj_papdate_279": "\\E0WOWIE!!^1!&I FEEL SO&INFORMED!!!/",
  "obj_papdate_280": " %",
  "obj_papdate_281": "I THINK WE'RE&READY FOR STEP&TWO!!!/",
  "obj_papdate_282": "\\F4 \\E8 %",
  "obj_papdate_283": "\"STEP TWO..^1.&ASK THEM&ON A DATE.\"/",
  "obj_papdate_284": "\"STEP TWO..^1.&ASK THEM&TO HANG OUT.\"/",
  "obj_papdate_286": "\\E0A\\F0HEM!/",
