	                global.msg[0] = scr_gettext("SCR_TEXT_2561") //* Oh^1, that's a relief^1!/
	                global.msg[1] = scr_gettext("SCR_TEXT_2562") //* That's all I need to&  continue my fantasies^1.&* Thank you^1, stranger./%%
