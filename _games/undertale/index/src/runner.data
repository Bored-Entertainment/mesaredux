                        if (angleDiff2 > 80)
                            dirspeed = 22
                        if (angleDiff2 > 90)
                            dirspeed = 24
                        if (angleDiff2 > 100)
                            dirspeed = 25
                        if (angleDiff < 0)
                            dirspeed = (-dirspeed)
                        direction -= dirspeed
                    }
                }
            }
