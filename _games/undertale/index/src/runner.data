  "obj_papdate_967": "URRRGH!!^5!%%",
  "obj_papdate_987": "NOOOOOOOO!!^4!%%",
  "obj_papdate_1021": "HUMAN^1.&IT'S CLEAR NOW./",
  "obj_papdate_1022": "YOU'RE MADLY IN&LOVE WITH ME./",
