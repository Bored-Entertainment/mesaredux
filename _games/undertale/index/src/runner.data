  "obj_adate_1326": "\\F4I've been lying to&you!/%%",
  "obj_adate_1336": "\\F3WHAT??^1?&ABOUT WHAT???/%%",
  "obj_adate_1349": "About... well.../",
  "obj_adate_1350": "\\E2Everything!/%%",
