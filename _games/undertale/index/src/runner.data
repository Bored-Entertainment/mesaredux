        image_speed = 0.2
        if (obj_time.right && global.facing == Direction.Right)
            turned = 0
        if (obj_time.left && global.facing == Direction.Left)
            turned = 0
        if (turned == 1)
            global.facing = Direction.Up
    }
}
if obj_time.right
{
    if (movement == 1)
    {
        if (obj_time.left == 0)
        {
            turned = 1
            if (xprevious == (x - 3))
                x += 2
            else
                x += 3
            if (global.debug == true)
            {
                if keyboard_check(vk_backspace)
                    x += 5
            }
            moving = true
            image_speed = 0.2
            if (moving != true)
                image_index = 1
            if (obj_time.up && global.facing == Direction.Up)
                turned = 0
            if (obj_time.down && global.facing == Direction.Down)
                turned = 0
            if (turned == 1)
                global.facing = Direction.Right
        }
    }
}
if obj_time.down
{
    if (movement == 1)
    {
        if (obj_time.up == 0)
        {
            turned = 1
            y += 3
            if (global.debug == true)
            {
                if keyboard_check(vk_backspace)
                    y += 5
            }
            if (moving != true)
                image_index = 1
            moving = true
            image_speed = 0.2
            if (obj_time.right && global.facing == Direction.Right)
                turned = 0
            if (obj_time.left && global.facing == Direction.Left)
                turned = 0
            if (turned == 1)
                global.facing = Direction.Down
        }
    }
}
