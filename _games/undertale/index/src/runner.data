  "obj_papdate_520": "NYEH!/",
  "obj_papdate_521": "NYEH HEH HEH!!!/%%",
  "obj_papdate_535": "\\F0DON'T THINK YOU'VE&BESTED ME YET!/",
  "obj_papdate_536": "I^1, THE GREAT&PAPYRUS.../",
  "obj_papdate_539": "HAVE NEVER BEEN&BEATEN AT DATING^1,&AND I NEVER WILL!/",
  "obj_papdate_540": "JUST IN CASE&SOMEBODY HAPPENS&TO ASK ME ON&A DATE!!!/",
  "obj_papdate_541": "HAVE NEVER BEEN&BEATEN AT HANGING&OUT^1, AND I NEVER&WILL!/",
  "obj_papdate_542": "JUST IN CASE&SOMEONE WANTS&TO HANG OUT!/",
  "obj_papdate_543": "\\E0I CAN EASILY&KEEP UP WITH&YOU!!!/",
