        pollenx[i] = random(room_width)
        polleny[i] = random(room_height)
        pollensize[i] = (random(3) + 1)
        pollenhspeed[i] = (random(2) - 1)
        pollenvspeed[i] = (random(2) - 1)
        pollenalpha[i] = 0
