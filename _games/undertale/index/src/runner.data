        {
            if instance_exists(wr[(msg_num - 2)])
            {
                with (wr[(msg_num - 2)])
                    instance_destroy()
            }
        }
        if (rep >= (maxrep - 1))
            msg_timer = -400
        msg_num += 1
    }
}
