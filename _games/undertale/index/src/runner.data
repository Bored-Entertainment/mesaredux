  "SCR_TEXT_4381": " %%",
  "SCR_TEXT_4387": " %%",
  "SCR_TEXT_4392": "* AH^1, YOU UNDERSTAND./",
  "SCR_TEXT_4393": "* THIS IS A GAME WHERE YOU&  SHOULD CHECK EVERYTHING&  TWICE./",
