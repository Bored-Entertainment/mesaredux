  "obj_papdate_150": "        DATING^1  START!^5 %%",
  "obj_papdate_151": "        HANGOUT^1 START!^5 %%",
  "obj_papdate_166": "HERE WE ARE!^1!&ON OUR DATE!!/",
  "obj_papdate_167": "HERE WE ARE!^1!&HANGING OUT!!/",
  "obj_papdate_169": "\\E3I'VE ACTUALLY&NEVER DONE THIS&BEFORE./",
  "obj_papdate_170": "\\E0BUT DON'T WORRY!!!/",
  "obj_papdate_171": "YOU CAN'T SPELL&'PREPARED' WITHOUT&SEVERAL LETTERS&FROM MY NAME!!!/%%",
