  "obj_papdate_930": "\\E2AND BY EXTENSION^1,&ME!!!/",
  "obj_papdate_931": "\\E6MAYBE EVEN MORE&THAN I DO!!!/%%",
  "obj_papdate_935": "\\E3YOU MEAN.../",
  "obj_papdate_936": "\\E2YOU'RE LETTING ME&HAVE IT INSTEAD?/",
  "obj_papdate_937": "\\E2BECAUSE YOU KNOW&HOW MUCH I LOVE&PASTA.../",
  "obj_papdate_938": "\\E6IMPOSSIBLE!^1!&TAKING MY PRESENT&AND TURNING IT&AROUND ON ME!/%%",
