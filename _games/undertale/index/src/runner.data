  "obj_froggit_225": "* Froggit didn't understand&  what you said^1, but was&  flattered anyway./^",
  "obj_gameintro_fake_44": "Long ago^1, two races&ruled over Earth^1:&HUMANS and MONSTERS. \\E1 ^1 %",
  "obj_gameintro_fake_45": "One day^1, th^7ey all&disappeared without&a trace.",
  "obj_garbagepile_70": "* (Piles of garbage.)&* (There are quite a few&  brands you recognize.)/%%",
  "obj_garbagepile_71": "* (Just garbage.)/%%",
  "obj_garbagepile_72": "* (There's a pile of yellow names&  in the trash pile.)/%%",
