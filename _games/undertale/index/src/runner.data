}
␀␀␀u␀␀function string_to_hiragana()
{
	var str = argument0
	var result = ""
	var lastch = ""
	for (var i = 1; i <= string_length(str); i++)
	{
	    var ch = ord(string_char_at(str, i))
	    if (ch >= 12449 && ch <= 12534)
	        ch -= 96
	    else if (ch >= 65377 && ch <= 65439)
	    {
	        var halfkata = "ã€‚ã€Œã€ã€ãƒ»ã‚’ããƒã…ã‡ã‰ãƒ£ãƒ¥ãƒ§ãƒƒãƒ¼ã‚ã„ã†ãˆãŠã‹ããã‘ã“ã•ã—ã™ã›ããŸã¡ã¤ã¦ã¨ãªã«ã¬ã­ã®ã¯ã²ãµã¸ã»ã¾ã¿ã‚€ã‚ã‚‚ã‚„ã‚†ã‚ˆã‚‰ã‚Šã‚‹ã‚Œã‚ã‚ã‚“ã‚›ã‚œ"
	        ch = ord(string_char_at(halfkata, (ch - 65376)))
	        if (lastch != "")
	        {
	            if (ch == 12443)
	            {
	                var daku_from = "ã‹ããã‘ã“ã•ã—ã™ã›ããŸã¡ã¤ã¦ã¨ã¯ã²ãµã¸ã»"
	                var daku_to = "ãŒããã’ã”ã–ã˜ãšãœãã ã¢ã¥ã§ã©ã°ã³ã¶ã¹ã¼"
	                var pos = string_pos(lastch, daku_from)
	                if (pos != 0)
	                    ch = ord(string_char_at(daku_to, pos))
	            }
	            else if (ch == 12444)
	            {
	                var handaku_from = "ã¯ã²ãµã¸ã»"
	                var handaku_to = "ã±ã´ã·ãºã½"
	                pos = string_pos(lastch, handaku_from)
	                if (pos != 0)
	                    ch = ord(string_char_at(handaku_to, pos))
	            }
	        }
	    }
	    lastch = chr(ch)
	    result += lastch
	}
	return result;
}
␀␀␀8␀␀␀function strlen()
{
	return string_length(argument0);
