  "obj_readable_room3_207": "* (VHSes and DVDs of various&  cartoons.)/",
  "obj_readable_room3_208": "* (They are all labelled \"Human&  History.\")/%%",
  "obj_readable_room3_213": "* (It's a specifically-regular&  -sized sink.)/%%",
  "obj_readable_room3_215": "* (It's too dark to see&  near the walls.)/%%",
  "obj_readable_room3_222": "* THIS ISN'T A SHOW ABOUT&  WASHING YOUR HANDS, DARLING./",
  "obj_readable_room3_223": "* THAT'S ON WEDNESDAYS!/%%",
  "obj_readable_room3_228": "* THIS ISN'T A SHOW ABOUT&  WASHING YOUR HANDS, DARLING./",
  "obj_readable_room3_229": "* THAT'S ON WEDNESDAYS!/%%",
  "obj_readable_room3_242": "* One time^1, Alphys's..^1.&* Uh^1, friend??^1?&* Came over here./",
