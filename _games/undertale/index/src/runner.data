  "obj_flowey_bulletmaster_562": "* Flowey's DEFENSE&  dropped to 0^4! %%",
  "obj_flowey_bulletmaster_564": "%%%",
  "obj_flowey_master_1067": "* No... NO!!!/",
  "obj_flowey_master_1068": "* This CAN'T be&  happening!!!/",
  "obj_flowey_master_1069": "* You... YOU.../%%",
  "obj_flowey_master_1070": "%%%",
  "obj_flowey_master_1124": "* You^2 IDIOT^5. %%",
  "obj_flowey_master_1181": "* Hee hee hee./",
  "obj_flowey_master_1182": "* Did you REALLY&  think.../",
  "obj_flowey_master_1183": "* You could&  defeat ME!?/",
  "obj_flowey_master_1184": "\\E5* I am the GOD of&  this world./",
  "obj_flowey_master_1185": "\\E6* And YOU?/",
  "obj_flowey_master_1186": "* You're HOPELESS./",
  "obj_flowey_master_1187": "* Hopeless and&  alone.../",
  "obj_flowey_master_1188": "\\E0* Golly^1, that's&  right!/",
  "obj_flowey_master_1189": "\\E7* Your WORTHLESS&  friends.../",
  "obj_flowey_master_1190": "\\E8* ... can't save&  you now./",
  "obj_flowey_master_1191": "\\E1* Call for help^1.&* I dare you./",
  "obj_flowey_master_1192": "\\E5* Cry into the&  darkness!/",
  "obj_flowey_master_1193": "\\E8\"Mommy^1! Daddy^1!\"&\"Somebody help!\"/",
  "obj_flowey_master_1194": "\\E5* See what good&  it does you!/%%",
  "obj_flowey_master_1195": "%%%",
  "obj_flowey_master_1196": "%%%",
  "obj_flowey_master_1197": "%%%",
  "obj_flowey_master_1198": "%%%",
  "obj_flowey_master_1216": "* You..^1. uh.../",
  "obj_flowey_master_1217": "\\E4* Would you STOP that?/",
  "obj_flowey_master_1218": "\\E6* Anyway^1, YOU!/",
  "obj_flowey_master_1260": "(You called for help.^4) %%",
  "obj_flowey_master_1261": "%%%",
  "obj_flowey_master_1276": "* .../",
  "obj_flowey_master_1277": "\\E0* But nobody came./",
  "obj_flowey_master_1278": "\\E2* Boy^1!&* What a shame!/",
  "obj_flowey_master_1279": "\\E7* Nobody else.../",
  "obj_flowey_master_1280": "* Is gonna get to&  see you DIE!!!/%%",
  "obj_flowey_master_1281": "%%%",
  "obj_flowey_master_1320": "* What^4? %",
  "obj_flowey_master_1321": "\\E1* How'd you...^4? %",
  "obj_flowey_master_1322": "\\E2* Well^1, I'll jus^4t%%",
  "obj_flowey_master_1323": "%%%",
  "obj_flowey_master_1347": "\\E4* Wh..^4. %",
  "obj_flowey_master_1348": "* Where are my&  powers!^5? %%",
  "obj_flowey_master_1349": "%%%",
  "obj_flowey_master_1374": "\\E5* The souls...^5? %",
  "obj_flowey_master_1375": "* What are they&  doing^5? %%",
  "obj_flowey_master_1376": "%%%",
  "obj_flowey_master_1401": "* NO!^1! NO!!!!^4! %",
  "obj_flowey_master_1402": "* YOU CAN'T DO&  THAT!!^4! %",
  "obj_flowey_master_1403": "* YOU'RE SUPPOSED&  TO OBEY ME!^4! %",
  "obj_flowey_master_1404": "* STOP!!^1!&  STOP IT!!!!^4! %%",
  "obj_flowey_master_1405": "%%%",
  "obj_flowey_master_1422": "* STOOOOPPPP!!!!!",
  "obj_flowey_master_1423": "%%%",
  "obj_flowey_wilt_309": "* Flowey ran away.",
  "obj_flowey_wilt_348": "I knew you had it in you^3!%%",
  "obj_flowey_wilt_470": "\\M1I just can't understand.../%%",
  "obj_flowey_wilt_481": "\\M1I can't understand!/%%",
  "obj_flowey_wilt_492": "\\M1I can't understand./%%",
  "obj_flowey_wilt_503": "\\M1... why are you being.../",
  "obj_flowey_wilt_504": "\\M1... so nice to me?/%%",
  "obj_flowey_wilt_514": "\\M1... why?/%%",
  "obj_flowey_wilt_524": "\\M1...?/%%",
  "obj_flowey_wilt_534": "\\M1.../%%",
  "obj_flowey_wilt_545": "\\M1I'll kill everyone you love./%%",
  "obj_flowey_wilt_556": "\\M1I'll kill everyone./%%",
  "obj_flowey_wilt_568": "I'll kill you./%%",
  "obj_flowey_wilt_579": "\\M1If you let me live.../",
  "obj_flowey_wilt_580": "\\M1I'll come back./%%",
  "obj_flowey_wilt_591": "\\M1Sparing me won't change&anything./",
  "obj_flowey_wilt_592": "\\M1Killing me is the only&way to end this./%%",
  "obj_flowey_wilt_601": ".../",
  "obj_flowey_wilt_602": "\\E1What are you doing?/",
  "obj_flowey_wilt_603": "\\E2Do you really think I've&learned anything from this?/",
  "obj_flowey_wilt_604": "\\E3No./%%",
  "obj_floweybattle1_268": "Is this a joke^2?&Are you braindead^2?&RUN^2. INTO^2. THE.&friendliness pellets/",
  "obj_floweybattle1_269": "/",
  "obj_floweybattle1_270": "/",
  "obj_floweybattle1_271": "/",
  "obj_floweybattle1_272": "/",
  "obj_floweybattle1_273": "/",
  "obj_floweybattle1_274": "/",
  "obj_floweybattle1_275": "/",
  "obj_floweybattle1_276": "/",
  "obj_floweybattle1_277": "/",
  "obj_floweybattle1_278": "stop it",
  "obj_floweytrigger_122": "\\E1* Hello..^1.&* Are you all right?/",
  "obj_floweytrigger_123": "* You must be so lost&  and confused.../",
  "obj_floweytrigger_124": "\\E2* Ah, do not be&  afraid^1, my child./",
  "obj_floweytrigger_125": "\\W* I am \\BTORIEL\\W,&  caretaker of the&  \\RRUINS\\W./",
  "obj_floweytrigger_126": "* I pass through here&  every day to see if&  anyone has fallen down./",
  "obj_floweytrigger_127": "* You are the first&  human to come here&  in a long time./",
  "obj_floweytrigger_128": "* I will do my best&  to protect you during&  your time here./",
  "obj_floweytrigger_129": "* Come^1!&* I shall guide you&  through the catacombs./%%",
  "obj_floweytrigger_316": "\\W* Howdy^2!&* I'm\\Y FLOWEY\\W.^2 &* \\YFLOWEY\\W the \\YFLOWER\\W!/",
  "obj_floweytrigger_317": "* Hee hee hee.../",
  "obj_floweytrigger_318": "* Why'd you make me&  introduce myself?/",
  "obj_floweytrigger_319": "* It's rude to act&  like you don't&  know who I am./",
  "obj_floweytrigger_320": "* Someone ought to teach&  you proper manners./",
  "obj_floweytrigger_321": "* I guess little old me&  will have to do./",
  "obj_floweytrigger_322": "* Ready^2?&* Here we go!/%%",
  "obj_floweytrigger_327": "* Don't you have anything&  better to do?/%%",
  "obj_floweytrigger_338": "* Error/%%",
  "obj_floweytrigger_342": "* Really^1, \\[C]?/",
  "obj_floweytrigger_343": "\\E5* Well^1, do what you&  will./",
  "obj_floweytrigger_344": "\\E4* I'll be waiting for&  you!/%%",
  "obj_floweytrigger_348": "\\E0* Hey^1.&* Remember./",
  "obj_floweytrigger_349": "\\E2* DON'T kill anyone./",
  "obj_floweytrigger_350": "\\E2* .../",
  "obj_floweytrigger_351": "\\E1* I can't believe this&  is a REAL thing I&  have to remind you./",
  "obj_floweytrigger_352": "\\E0* Hee hee hee.../",
  "obj_floweytrigger_353": "* Good luck!/%%",
  "obj_floweytrigger_357": "* Remember.../",
  "obj_floweytrigger_358": "\\E1* THIS time^1, you've&  GOT to become friends&  with everyone./",
  "obj_floweytrigger_359": "\\E2* OK?/",
  "obj_floweytrigger_360": "\\E5* If you DON'T^1, you'll&  be miserable FOREVER./",
  "obj_floweytrigger_361": "\\E1* And we wouldn't want&  THAT^1, would we?/",
  "obj_floweytrigger_362": "\\E0* No..^1.&* We just want you&  to be happy^1, right?/",
  "obj_floweytrigger_363": "* Good luck. /%%",
  "obj_floweytrigger2_158": "* Error/%%",
  "obj_floweytrigger2_162": "* Hee hee hee.../",
  "obj_floweytrigger2_163": "\\E2* I hope you like your&  choice./",
  "obj_floweytrigger2_164": "* After all^1, it's not&  as if you can go&  back and change fate./",
  "obj_floweytrigger2_165": "\\E0* In this world^1, it's kill&  or be killed./",
  "obj_floweytrigger2_166": "\\E2* That old hag thought&  she could break the&  rules./",
  "obj_floweytrigger2_167": "\\E1* She tried so hard&  to save you humans./",
  "obj_floweytrigger2_168": "\\E0* But when it came&  down to it.../",
  "obj_floweytrigger2_169": "\\TF*\\E5 Hee hee.../",
  "obj_floweytrigger2_170": "\\E4* SHE COULDN'T EVEN&  SAVE HERSELF./",
  "obj_floweytrigger2_171": "* WHAT AN IDIOT!!/%%",
  "obj_floweytrigger2_175": "\\E2* Heheheheh./",
  "obj_floweytrigger2_176": "* You just can't&  get enough^1, can you!?/",
  "obj_floweytrigger2_177": "\\E4* .../",
  "obj_floweytrigger2_178": "\\E6* How many more&  times will you&  kill her?/",
  "obj_floweytrigger2_179": "* Ha ha ha ha ha.../",
  "obj_floweytrigger2_180": "\\E4*\\TF You disgusting animal./",
  "obj_floweytrigger2_181": "* You didn't even&  TRY to spare her./%%",
  "obj_floweytrigger2_186": "* Wow^1, you really&  can't get enough./",
  "obj_floweytrigger2_187": "\\E5* You kind of remind&  me of myself./%%",
  "obj_floweytrigger2_195": "* Wow^1, you're utterly&  repulsive./",
  "obj_floweytrigger2_196": "\\E6* You spared her life.../",
  "obj_floweytrigger2_197": "* Then you decided that&  just wasn't interesting&  enough for you./",
  "obj_floweytrigger2_198": "\\E7* So you murdered her&  just to see what&  would happen./",
  "obj_floweytrigger2_199": "\\E5* You killed her out&  of boredom./",
  "obj_floweytrigger2_200": "* Truly disgusting.../%%",
  "obj_floweytrigger2_203": "* Hee hee.../",
  "obj_floweytrigger2_204": "\\E4* You naive idiot./",
  "obj_floweytrigger2_205": "* Do you think you&  are the only one&  with that power?/",
  "obj_floweytrigger2_206": "\\E4* The power to reshape&  the world.../",
  "obj_floweytrigger2_207": "* Purely by your&  own determination./",
  "obj_floweytrigger2_208": "* The ability to&  play God!/",
  "obj_floweytrigger2_209": "* The ability to \"SAVE.\"/",
  "obj_floweytrigger2_210": "\\E0* I thought I was&  the only one with&  that power^1. But.../",
  "obj_floweytrigger2_211": "\\E1* I can't SAVE anymore./",
  "obj_floweytrigger2_212": "* Apparently YOUR&  desires for this&  world override MINE./",
  "obj_floweytrigger2_213": "\\E5* Well well./",
  "obj_floweytrigger2_214": "* Enjoy that power&  while you can./",
  "obj_floweytrigger2_215": "\\E4* I'll be watching./%%",
  "obj_floweytrigger2_226": "* Hahaha.../",
  "obj_floweytrigger2_227": "\\E1* You're not really human^1,&  are you?/",
  "obj_floweytrigger2_228": "\\E1* No.^2 You're empty inside^2.&* \\E4Just like me^1.&* In fact.../",
  "obj_floweytrigger2_229": "\\E8* You're \\[C],^1 right?/",
  "obj_floweytrigger2_230": "\\E0* We're still inseparable^1,&  after all these years.../",
  "obj_floweytrigger2_231": "* Listen^1.&* I have a plan to become&  all powerful./",
  "obj_floweytrigger2_232": "\\E2* Even more powerful than&  you and your stolen&  soul./",
  "obj_floweytrigger2_233": "\\E4* Let's destroy everything&  in this wretched world./",
  "obj_floweytrigger2_234": "\\E6* Everyone^1, everything in&  these \\E7worthless&  memories.../",
  "obj_floweytrigger2_235": "\\E5* Let's turn 'em all&  to dust./%%",
  "obj_floweytrigger2_245": "* Clever.&* Verrrryyy clever./",
  "obj_floweytrigger2_246": "* You think you're really&  smart^1, don't you?/",
  "obj_floweytrigger2_247": "\\E0* In this world^1, it's kill&  or be killed./",
  "obj_floweytrigger2_248": "\\E1* So you were able to&  play by your own&  rules./",
  "obj_floweytrigger2_249": "*\\E4 You spared the life&  of a single person./",
  "obj_floweytrigger2_250": "* Hee hee hee.../",
  "obj_floweytrigger2_253": "* Froggit^1, Whimsun^1.&* Vegetoid^1, Loox^1.&* Migosp^1, Moldsmal./",
  "obj_floweytrigger2_254": "* Think about those names./",
  "obj_floweytrigger2_255": "* Do you think any of&  those monsters have&  families?/",
  "obj_floweytrigger2_256": "* Do you think any of&  them have friends?/",
  "obj_floweytrigger2_257": "\\E6* Each one could have&  been someone else's&  Toriel./",
  "obj_floweytrigger2_258": "\\E7* Selfish brat./",
  "obj_floweytrigger2_259": "* Somebody is dead&  because of you./%%",
  "obj_floweytrigger2_264": "\\E2* I bet you feel&  really great./",
  "obj_floweytrigger2_265": "* You didn't kill&  anybody this time./",
  "obj_floweytrigger2_266": "\\E0* But what will you&  do if you meet a&  relentless killer?/",
  "obj_floweytrigger2_267": "* You'll die and you'll&  die and you'll&  die./",
  "obj_floweytrigger2_268": "\\E1* Until you tire of&  trying./",
  "obj_floweytrigger2_269": "\\E0* What will you do&  then?/",
  "obj_floweytrigger2_270": "\\E5* Will you kill&  out of frustration?/",
  "obj_floweytrigger2_271": "* Or will you give&  up entirely on&  this world.../",
  "obj_floweytrigger2_272": "\\E4* ... and let ME inherit&  the power to control&  it?/",
  "obj_floweytrigger2_273": "\\E5* I am the prince of&  this world's future./",
  "obj_floweytrigger2_274": "* Don't worry^1, my little&  monarch^1, my plan&  isn't regicide./",
  "obj_floweytrigger2_275": "* This is SO much&  more interesting./%%",
  "obj_floweytrigger2_283": "* But don't act so&  cocky./",
  "obj_floweytrigger2_284": "* I know what you did./",
  "obj_floweytrigger2_285": "\\E6* You murdered her./",
  "obj_floweytrigger2_286": "\\E7* And then you went&  back^1, because you&  regretted it./",
  "obj_floweytrigger2_287": "* Ha ha ha ha.../",
  "obj_floweytrigger2_288": "\\E5* You naive idiot./",
  "obj_floweytrigger2_289": "* Do you think you&  are the only one&  with that power?/",
  "obj_floweytrigger2_290": "\\E4* The power to reshape&  the world.../",
  "obj_floweytrigger2_291": "* Purely by your&  own determination./",
  "obj_floweytrigger2_292": "* The ability to&  play God!/",
  "obj_floweytrigger2_293": "* The ability to \"SAVE.\"/",
  "obj_floweytrigger2_294": "\\E0* I thought I was&  the only one with&  that power^1. But.../",
  "obj_floweytrigger2_295": "\\E1* I can't SAVE anymore./",
  "obj_floweytrigger2_296": "* Apparently YOUR&  desires for this&  world override MINE./",
  "obj_floweytrigger2_297": "\\E5* Well well./",
  "obj_floweytrigger2_298": "* Enjoy that power&  while you can./",
  "obj_floweytrigger2_299": "\\E4* I'll be watching./%%",
  "obj_forcedright_142": "* What's that smell^1?&* (Where's that smell?)/",
  "obj_forcedright_143": "* If you're a smell^1...&* (... identify yoursmellf!)/%%",
  "obj_forcedright_175": "* Hmmm..^1.&* Here's that weird smell.../",
  "obj_forcedright_176": "* It makes me want to&  eliminate./",
  "obj_forcedright_177": "* (... Eliminate YOU!)/%%",
  "obj_forcedright_220": "* Dogs can pet other dogs??^1?&* (A new world has opened&  up for us...)/",
  "obj_forcedright_221": "* Thanks^1, weird puppy!/%%",
  "obj_forcedright_224": "* Weird smells can bring&  good things..^1.&* (Friendly fun fetch!)/",
  "obj_forcedright_225": "* Thanks^1, weird smell^1!&* (It sure was fun to&  \"stick\" together!)/%%",
  "obj_friendc_event_115": "  Frisk!/",
  "obj_friendc_event_116": "  This is all just&  a bad dream...!/",
  "obj_friendc_event_117": "  Please^1, wake up...!/%%",
  "obj_friendc_event_181": "* Oh^1!&* You are awake^1!&* Thank goodness!/",
  "obj_friendc_event_183": "* W-we were so&  worried...!/",
  "obj_friendc_event_184": "* It felt like you&  were out forever!/",
  "obj_friendc_event_186": "* Yeah^1! Any longer and&  I would have freaked&  out!/",
  "obj_friendc_event_187": "\\E2* Tell us next time&  you decide to take&  a nap^1, okay!?/",
  "obj_friendc_event_189": "* yeah^1.&* you made papyrus cry&  like a baby./",
  "obj_friendc_event_191": "WHAT!^1!&I DIDN'T CRY!!^1!&I DON'T CRY!!/",
  "obj_friendc_event_192": "\\E3I JUST..^1.&CAUGHT SOMETHING&IN MY EYE./",
  "obj_friendc_event_194": "* what did you catch?/",
  "obj_friendc_event_196": "TEARS!!!/",
  "obj_friendc_event_198": "* Now^1, now./",
  "obj_friendc_event_199": "* The important part&  is that Frisk is&  all right./",
  "obj_friendc_event_200": "* Here^1, Frisk^1.&* Why not drink some&  tea?/",
  "obj_friendc_event_201": "* It'll make you feel&  better./",
  "obj_friendc_event_203": "* Errr..^1.&* How about we give&  them space^1, first?/",
  "obj_friendc_event_204": "\\E2* They must be very&  exhausted./",
  "obj_friendc_event_205": "\\E8* Though^1, from what^1,&  I am not certain./",
  "obj_friendc_event_206": "\\E1* Frisk..^1.&* We do not remember&  exactly what happened./",
  "obj_friendc_event_207": "\\E1* There was a flower..^1.&* And then^1, everything&  went white./",
  "obj_friendc_event_208": "\\E0* But now the barrier&  is gone./",
  "obj_friendc_event_209": "* When you are ready^1,&  we will all return&  to the surface./",
  "obj_friendc_event_210": "* It seems the door to&  the east will lead&  us there now./",
  "obj_friendc_event_211": "\\E2* But before then.../",
  "obj_friendc_event_212": "\\E0* Perhaps you might&  want to take a&  walk?/",
  "obj_friendc_event_213": "* You can say goodbye&  to all of your&  wonderful friends./",
  "obj_friendc_event_214": "* Do as you wish^1.&* We will all wait&  for you here./%%",
  "obj_friendscene_182": "\\E4What a miserable&creature^1, torturing&such a poor^1,&innocent, youth.../",
  "obj_friendscene_183": "\\E0Do not be afraid^1,&my child./",
  "obj_friendscene_184": "\\E0It is I^1, TORIEL^1,&your friend and&guardian./",
  "obj_friendscene_185": "\\E1At first^1, I thought&I would let you&make your journey&alone.../",
  "obj_friendscene_186": "\\E4But I could not&stop worrying about&you./",
  "obj_friendscene_187": "\\E4Your adventure must&have been so&treacherous./",
  "obj_friendscene_188": "\\E2... and ultimately^1,&it would burden you&with a horrible&choice./",
  "obj_friendscene_189": "To leave this place^1,&you would have to&take the life of&another person./",
  "obj_friendscene_190": "\\E2You would have to&defeat ASGORE./",
  "obj_friendscene_191": "\\E4However..^1.&I realized.../",
  "obj_friendscene_192": "\\E1I cannot allow that./",
  "obj_friendscene_193": "It is not right to&sacrifice someone&simply to let&someone leave here./",
  "obj_friendscene_194": "\\E4Is that not what&I have been trying to&prevent this&whole time?/",
  "obj_friendscene_195": "\\E1So^1, for now^1, let&us suspend this&battle./",
  "obj_friendscene_196": "\\E4As terrible as&ASGORE is.../",
  "obj_friendscene_197": "\\E0He deserves mercy^1,&too./%%",
  "obj_friendscene_226": "Tori..^1.&You&came&back...!/%%",
  "obj_friendscene_236": "\\E5Do not \"Tori\" me^1,&Dreemurr!/",
  "obj_friendscene_237": "\\E2You pathetic whelp./",
  "obj_friendscene_238": "If you really wanted&to free our kind.../",
  "obj_friendscene_239": "You could have gone&through the barrier&after you got ONE&SOUL.../",
  "obj_friendscene_240": "... taken six SOULs&from the humans^1, then&come back and freed&everyone peacefully./",
  "obj_friendscene_241": "\\E5But instead^1, you made&everyone live in&despair.../",
  "obj_friendscene_242": "Because you would&rather wait here^1,&meekly hoping another&human never comes./%%",
  "obj_friendscene_271": ".../",
  "obj_friendscene_272": "... Tori.../",
  "obj_friendscene_273": "You're right.../",
  "obj_friendscene_274": "I am a miserable&creature.../",
  "obj_friendscene_275": "... but^1, do you think&we can at least be&friends again?/%%",
  "obj_friendscene_301": "(Sigh.)/",
  "obj_friendscene_302": "NO^1,&Asgore./%%",
  "obj_friendscene_353": "Ngahhhhhh!!^1!&ASGORE^1! Human!!/",
  "obj_friendscene_354": "Nobody fight each&other!!!/",
  "obj_friendscene_355": "Everyone's gonna&make friends^1, or&else I'll...!!/",
  "obj_friendscene_356": "I'll.../",
  "obj_friendscene_357": ".../%%",
  "obj_friendscene_376": "Hello^1.&I am&TORIEL./",
  "obj_friendscene_377": "Are you&the&human's&friend?/",
  "obj_friendscene_378": "It is&nice to&meet&you./%%",
  "obj_friendscene_388": "Uh^1,&yeah...?/",
  "obj_friendscene_389": "Nice to&meet&you!/%%",
  "obj_friendscene_413": "Hey&ASGORE^1,&is that&your ex?/",
  "obj_friendscene_414": "Jeez^1.&That's&rough^1,&buddy./%%",
  "obj_friendscene_450": "H-hey^1!/",
  "obj_friendscene_451": "Nobody&hurt&each&other!!/",
  "obj_friendscene_452": ".../",
  "obj_friendscene_453": ".../%%",
  "obj_friendscene_477": "Oh^1!&Are you&another&friend?/",
  "obj_friendscene_478": "I am&TORIEL^1.&Hello!/%%",
  "obj_friendscene_487": "Uh^1,&h-h-hi!/",
  "obj_friendscene_488": ".../",
  "obj_friendscene_489": "(THERE'S&TWO OF&THEM???)/%%",
  "obj_friendscene_546": "HEY^1!&NOBODY FIGHT&ANYONE!/",
  "obj_friendscene_547": "IF ANYONE FIGHTS&ANYONE...!/",
  "obj_friendscene_548": "THEN I'LL!!^1!&BE FORCED!!!/",
  "obj_friendscene_549": "TO ASK UNDYNE&FOR HELP!!!/%%",
  "obj_friendscene_572": "Hello!/%%",
  "obj_friendscene_582": "OH^1!&HELLO^1, YOUR&MAJESTY!/",
  "obj_friendscene_583": "PSST^1!&HEY^1, HUMAN.../",
  "obj_friendscene_584": "DID ASGORE&SHAVE...?/",
  "obj_friendscene_585": "AND..^1.&CLONE HIMSELF????/%%",
  "obj_friendscene_631": "hey&guys..^1.&what's&up?/%%",
  "obj_friendscene_644": "That&voice&...!!/%%",
  "obj_friendscene_678": "Hello^1,&I think&we&may.../",
  "obj_friendscene_679": "Know&each&other?/%%",
  "obj_friendscene_691": "oh hey..^1.&i recognize your&voice^1, too./%%",
  "obj_friendscene_705": "I am&TORIEL./",
  "obj_friendscene_706": "So nice&to meet&you./%%",
  "obj_friendscene_717": "the&name's&sans./",
  "obj_friendscene_718": "and^1, uh^1,&same./%%",
  "obj_friendscene_733": "Oh^1!&Wait^1,&then...!/%%",
  "obj_friendscene_760": "This must be your&brother^1, Papyrus!/",
  "obj_friendscene_761": "Greetings^1, Papyrus^1!&It is so nice to&finally meet you!/",
  "obj_friendscene_762": "Your brother has&told me so much&about you./%%",
  "obj_friendscene_779": "WOWIE.../",
  "obj_friendscene_780": "I CAN'T BELIEVE&ASGORE'S CLONE&KNOWS WHO I&AM!!!/",
  "obj_friendscene_781": "THIS IS THE BEST&DAY OF MY&LIFE!!!!!!!/%%",
  "obj_friendscene_795": "Hey^1, Papyrus.../",
  "obj_friendscene_796": "What does a skeleton&tile his roof&with?/%%",
  "obj_friendscene_808": "HMMM..^1.&SNOW-PROOF ROOF&TILES???/%%",
  "obj_friendscene_819": "No^1, silly^1!&A skeleton tiles&his roof with.../",
  "obj_friendscene_820": "SHIN-gles!!!/%%",
  "obj_friendscene_846": "I CHANGED MY&MIND!!!/",
  "obj_friendscene_847": "THIS IS THE WORST&DAY OF MY LIFE!!!/%%",
  "obj_friendscene_863": "Come on^1, ASGORE^1!&It's gonna be OK!/",
  "obj_friendscene_864": "There are plenty&of fish in the&sea.../%%",
  "obj_friendscene_880": "Y-yeah^1, ASGORE!!/",
  "obj_friendscene_881": "Undyne's totally&right about that&fish thing!/",
  "obj_friendscene_882": "S-sometimes you've&just got to^1, uh.../",
  "obj_friendscene_883": "S-stop going after&furry boss monsters&and^1, uh.../",
  "obj_friendscene_884": "J-just get to know&a really cute&fish...?/",
  "obj_friendscene_885": ".../",
  "obj_friendscene_886": "It's a metaphor./%%",
  "obj_friendscene_910": "Well./",
  "obj_friendscene_911": "I think&it's a&good&analogy./%%",
  "obj_friendscene_945": "OH MY GOD!/",
  "obj_friendscene_946": "\\XWILL YOU TWO&JUST \\RSMOOCH\\X &ALREADY!?/",
  "obj_friendscene_947": "THE AUDIENCE IS&DYING FOR SOME&ROMANTIC ACTION!!!/%%",
  "obj_friendscene_962": "HEY^1, SHUT UP!!!/",
  "obj_friendscene_963": "Man^1, the nerve of&that guy!/",
  "obj_friendscene_964": "Right^1,&Alphys!??/",
  "obj_friendscene_965": ".../",
  "obj_friendscene_966": "Uh^1, Alphys?/%%",
  "obj_friendscene_982": ".../",
  "obj_friendscene_983": "No./",
  "obj_friendscene_984": "He's&right./",
  "obj_friendscene_985": "LET'S&DO&IT./%%",
  "obj_friendscene_1003": "??????????????/",
  "obj_friendscene_1004": "Well??^1? Uh??^1?&I guess??^1?&If you want to??^1?&Then????/",
  "obj_friendscene_1005": "Don't hold anything&back!!!/%%",
  "obj_friendscene_1047": "W-wait!/",
  "obj_friendscene_1048": "Not in&front of&the&human!/%%",
  "obj_friendscene_1066": "Uhh^1, right^1!&S-sorry^1, I got a&little carried&away there./%%",
  "obj_friendscene_1082": "Hee hee hee./",
  "obj_friendscene_1083": "My child^1, it&seems as if you&must stay here&for a while./",
  "obj_friendscene_1084": "\\E6But looking at&all the great&friends you have&made.../",
  "obj_friendscene_1085": "\\E0I think.../",
  "obj_friendscene_1086": "\\E7I think you will&be happy here./%%",
  "obj_friendscene_1108": "H-hey^1, that&reminds me./",
  "obj_friendscene_1109": "Papyrus..^1.&YOU called&everyone here^1,&right?/",
  "obj_friendscene_1110": "Well^1, besides^1,&uh^1, her./",
  "obj_friendscene_1111": "Uh^1, anyway..^1.&If I got here&before you.../",
  "obj_friendscene_1112": "How did you know&how to call&everybody?/%%",
  "obj_friendscene_1122": "LET'S&JUST&SAY.../%%",
  "obj_friendscene_1132": "A TINY&FLOWER&HELPED&ME./%%",
  "obj_friendscene_1146": "A tiny..^1.&flower?/%%",
  "obj_friendscene_1194": "\\E0You IDIOTS./",
  "obj_friendscene_1195": "\\E2While you guys were&having your little&pow-wow.../",
  "obj_friendscene_1196": "\\E6I took the human&SOULS!/",
  "obj_friendscene_1197": "\\E5And now^1, not only&are THOSE under my&power.../",
  "obj_friendscene_1198": "\\E6But all of your&FRIENDS' SOULS are&gonna be mine^1, too!/",
  "obj_friendscene_1199": "\\E0Hee hee hee./",
  "obj_friendscene_1200": "\\E1And you know what&the best part is?/",
  "obj_friendscene_1201": "\\E5It's all your&fault./",
  "obj_friendscene_1202": "\\E6It's all because&you MADE THEM&love you./",
  "obj_friendscene_1203": "\\E7All the time you&spent listening to&them.../",
  "obj_friendscene_1204": "\\E2Encouraging them..^1.&Caring about them.../",
  "obj_friendscene_1205": "\\E0Without that^1, they&wouldn't have come&here./",
  "obj_friendscene_1206": "\\E7And now^1, with their&souls and the humans'&together.../",
  "obj_friendscene_1207": "\\E5I will achieve my&REAL FORM./",
  "obj_friendscene_1208": "\\E0Hee hee.../",
  "obj_friendscene_1209": "\\E3Huh?/",
  "obj_friendscene_1210": "\\E1WHY am I still&doing this?/",
  "obj_friendscene_1211": "\\E7Don't you get it?/",
  "obj_friendscene_1212": "\\E0This is all just&a GAME./",
  "obj_friendscene_1213": "\\E3If you leave the&underground satisfied^1,&you'll \"win\" the&game./",
  "obj_friendscene_1214": "\\E4If you \"win^1,\" you&won't want to \"play\"&with me anymore./",
  "obj_friendscene_1215": "\\E0And what would I&do then?/",
  "obj_friendscene_1216": "\\E6But this game&between us will&NEVER end./",
  "obj_friendscene_1217": "\\E5I'll hold victory&in front of you^1,&just within your&reach.../",
  "obj_friendscene_1218": "\\E6And then tear it&away just before&you grasp it./",
  "obj_friendscene_1219": "\\E8Over^1, and over^1,&and over.../",
  "obj_friendscene_1220": "\\E5Hee hee hee./",
  "obj_friendscene_1221": "\\E1Listen./",
  "obj_friendscene_1222": "\\E0If you DO defeat&me^1, I'll give you&your \"happy ending.\"/",
  "obj_friendscene_1223": "\\E7I'll bring your&friends back./",
  "obj_friendscene_1224": "I'll destroy the&barrier./",
  "obj_friendscene_1225": "\\E0Everyone will&finally be&satisfied./",
  "obj_friendscene_1226": "\\E6But that WON'T&happen./",
  "obj_friendscene_1227": "\\E8You...!/",
  "obj_friendscene_1228": "\\E0I'll keep you here&no matter what!/%%",
  "obj_friendscene_1266": "\\E0Even if it means&killing you&1,000,000 times!!!!/%%",
  "obj_friendscene_1357": "What?/%%",
  "obj_friendscene_1375": "Do not be afraid^1,&my child.../",
  "obj_friendscene_1376": "No matter what&happens.../",
  "obj_friendscene_1377": "We will always&be there to&protect you!/%%",
  "obj_friendscene_1434": "THAT'S RIGHT^1,&HUMAN^1!&YOU CAN&WIN!!/",
  "obj_friendscene_1435": "JUST DO&WHAT I^1,&WOULD&DO.../",
  "obj_friendscene_1436": "BELIEVE&IN YOU!!!/%%",
  "obj_friendscene_1449": "Hey^1! Human^1! If&you got past&ME^1, you can&do ANYTHING!/",
  "obj_friendscene_1450": "So don't worry^1!&We're with you&all the way!/%%",
  "obj_friendscene_1463": "huh^1?&you haven't&beaten&this guy yet?/",
  "obj_friendscene_1464": "come on^1, this&weirdo's got&nothin' on you./%%",
  "obj_friendscene_1514": "Technically^1, it's&impossible for you&to beat him.../",
  "obj_friendscene_1515": "B-but..^1.&Somehow^1, I know&you can do it!!/%%",
  "obj_friendscene_1532": "Human^1, for the&future of&humans and&monsters...!/",
  "obj_friendscene_1533": "You have to stay&determined...!/%%",
  "obj_friendscene_1589": "Urrrgh..^1. NO!/",
  "obj_friendscene_1590": "Unbelievable!!/",
  "obj_friendscene_1591": "This can't be&happening...!/",
  "obj_friendscene_1592": "You..^1. YOU...!/%%",
  "obj_friendscene_1635": "I can't believe&you're all so&STUPID./%%",
  "obj_friendscene_1665": "ALL OF YOUR SOULS&ARE MINE!!!/%%",
  "obj_froggit_30": "Ribbit,&ribbit.",
  "obj_froggit_31": "Croak,&croak.",
  "obj_froggit_32": "Hop,&hop.",
  "obj_froggit_33": "Meow.",
  "obj_froggit_36": "(Blushes&deeply.)&Ribbit..",
  "obj_froggit_39": "Shiver,&shiver.",
  "obj_froggit_42": "%%%",
  "obj_froggit_184": "* Froggit doesn't seem to&  know why it's here.",
  "obj_froggit_185": "* Froggit hops to and fro.",
  "obj_froggit_186": "* The battlefield is filled&  with the smell of mustard&  seed.",
  "obj_froggit_187": "* You are intimidated by&  Froggit's raw strength^4.&* Only kidding.",
