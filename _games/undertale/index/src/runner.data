  "obj_papdate_547": "\\E0BEHOLD!!!/%%",
  "obj_papdate_573": "\\E1NYEH!&WHAT DO YOU&THINK OF MY&SECRET STYLE!?!/*",
  "obj_papdate_586": "                              &   I love it       I hate it&                            ",
  "obj_papdate_611": "\\E6NO!!!/",
  "obj_papdate_614": "A GENUINE&COMPLIMENT...!!!/%%",
  "obj_papdate_618": "YOUR HONESTY...^1!&IT SHOWS HOW&MUCH YOU REALLY&CARE!!!/%%",
  "obj_papdate_667": "\\E3HOWEVER.../",
  "obj_papdate_668": "\\XY\\E0OU DON'T TRULY&UNDERSTAND THE\\R &HIDDEN POWER\\X OF&THIS OUTFIT!!!/",
