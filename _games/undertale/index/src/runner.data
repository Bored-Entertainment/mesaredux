        }
        if (menuc[0] == 2)
        {
            menu = 3
            if (FL_BurgerPantsStatus == BurgerPantsStatus.CantTalk)
            {
                menu = 4
                sell = 20
            }
            if (FL_BurgerPantsStatus == BurgerPantsStatus.CanTalk)
            {
                menu = 4
                sell = 21
            }
        }
        if (menuc[0] == 3)
