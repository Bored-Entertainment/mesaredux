    if (facetimer > 290 && facetimer < 310)
        facey += (sin((facetimer / 10)) * 0.8)
    if (facetimer > 326 && facetimer < 345)
        facey += (sin((facetimer / 10)) * 1.5)
    if (facetimer > 390 && facetimer < 430)
    {
        facey *= 0.9
        if (facey <= 0.5)
            facex = 0
    }
    if (facetimer == 460)
        facetimer = 0
}
