  "obj_controlspear_223": "* ????????????????/%%",
  "obj_controlspear_235": "* The sugar is for&  tea^1, mmm'kay?/%%",
  "obj_controlspear_243": "* Oh^1, soda?/",
  "obj_controlspear_244": "\\E4* Actually^1, even though&  you pointed to it^1,&  you don't look happy./",
  "obj_controlspear_245": "\\E0* Heh^1, that's fine^1!&* I think soda's gross^1,&  too!/",
  "obj_controlspear_246": "\\E4* It rots your teeth..^1.&* It rots your mind.../",
  "obj_controlspear_247": "\\E1* IT ROTS YOUR FIGHTING&  SPIRIT!/",
  "obj_controlspear_248": "\\E9* ... huh^1?&* Why do I have it?/",
  "obj_controlspear_249": "\\E8* .../%%",
  "obj_controlspear_253": "* What^1?&* You wanna throw the&  spear at it?/%%",
  "obj_controlspear_261": "* Oh^1, you want some&  hot chocolate?/",
  "obj_controlspear_262": "\\E1* Wait^1, wait^1, I just&  remembered..^1.&* That container's empty./",
  "obj_controlspear_263": "\\E9* I stopped getting&  it because it was&  always a hassle.../",
  "obj_controlspear_264": "\\E6* ASGORE kept getting&  marshmallows stuck in&  his beard./%%",
  "obj_controlspear_268": "* That container's empty./%%",
  "obj_controlspear_276": "\\E9* ... tea^1, huh^1?&* Coming right up!/%%",
  "obj_controlspear_284": "* The fridge!^1?&* You want to have&  the entire fridge!?/",
  "obj_controlspear_285": "\\E1* No!/%%",
  "obj_controlspear_291": "* Believe me^1, I would&  GLADLY give you your&  fill of swords./",
  "obj_controlspear_292": "\\E9* If you weren't my&  beloved houseguest!/%%",
