	                        FL_WaterfallMushroomStatus = 2
	                    doak = 1
	                }
	            }
	            if (global.choice == 1)
	                global.msg[0] = scr_gettext("SCR_TEXT_2553") //* Is everyone out there&  like you^1?&* How terrible./%%
	        }
