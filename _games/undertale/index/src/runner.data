  "obj_adate_1006": "I START HOLLERING!!/",
  "obj_adate_1007": "UNDYNE!!!^1!&I LOVE YOU!!!/",
  "obj_adate_1008": "UNDYNE!!^1!&KISS ME AGAIN^1,&UNDYNE!!!/%%",
  "obj_adate_1023": "\\E9M\\M0-m-me^1?&Undyne???/",
  "obj_adate_1024": "\\E7Uh^1, uh^1, uh^1, uh^1,&ok!/",
  "obj_adate_1025": "\\E6I'll say what I&think she'd say^1,&and you..^1. ummm..../",
  "obj_adate_1026": "\\E5You show me what&I'm supposed to do!/",
  "obj_adate_1027": "\\E2*\\M1ahem*/",
  "obj_adate_1028": "\\E0N\\M2gahhhh!!^1!&Hey^1, Alphys!&You look cute&today!/",
  "obj_adate_1029": "\\E5Which I say often^1!&But platonically&because I would&NEVER like you./*",
  "obj_adate_1043": "   Hi Undyne!      Yo your&   Can we          one hot&   talk?           hotbaby",
  "obj_adate_1069": "Talk^1, to you^1?&Hmmm..^1.&I guess so./",
