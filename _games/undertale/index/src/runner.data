  "obj_papdate_850": "YOU HAVE NO IDEA!/",
  "obj_papdate_851": "\\E3THOUGH THIS&APPEARS TO BE&SPAGHETTI.../%%",
  "obj_papdate_864": "\\E1THIS AIN'T ANY&PLAIN OL' PASTA!/",
  "obj_papdate_865": "\\E0THIS IS AN&ARTISAN'S WORK!/",
  "obj_papdate_866": "\\E3SILKEN SPAGHETTI^1,&FINELY AGED IN&AN OAKEN CASK.../",
  "obj_papdate_867": "\\E0THEN COOKED BY&ME^1, MASTER CHEF&PAPYRUS!/",
  "obj_papdate_868": "\\E1HUMAN!!^1!&IT'S TIME TO&END THIS!!/",
