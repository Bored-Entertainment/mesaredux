  "obj_latchkey_71": "* (You took the key and&  put it on your phone's&  key-chain.)/%%",
  "obj_lemonbread_175": "But&nobody&came.",
  "obj_lemonbread_176": "Do you&think&I'm&pretty?",
  "obj_lemonbread_177": "That's&what&they all&say.",
  "obj_lemonbread_178": "Stay&here&with&me...",
  "obj_lemonbread_196": "Welcome&to my&special&hell.",
  "obj_lemonbread_200": "...",
  "obj_lemonbread_202": "Life's&flashing&before&my teeth",
  "obj_lemonbread_203": "I've&felt&this&before.",
  "obj_lemonbread_207": "%%%",
  "obj_lemonbread_429": "* Smells like sweet lemons.",
  "obj_lemonbread_433": "* You hear the melody of&  pulsating flesh.",
  "obj_lemonbread_434": "* Could this be goodbye!?",
  "obj_lemonbread_435": "* Monster has low HP.",
  "obj_lemonbread_468": "* You called for help^1.&* But nobody came./^",
  "obj_lemonbread_479": "* You hum a familiar tune^1.&* Lemon Bread's body shakes.../^",
  "obj_lemonbread_483": "* You hum a familiar tune^1.&* Nothing else happened./^",
  "obj_lemonbread_488": "* You hum a familiar tune^1.&* Lemon Bread seems to&  remember something./^",
  "obj_lemonbread_501": "* You screamed out^1.&* But nobody came./^",
  "obj_lemonbread_512": "* You flexed your arm^1.&* Lemon Bread's muscle shakes.../^",
  "obj_lemonbread_516": "* You flexed your arm^1.&* Nothing else happened./^",
  "obj_lemonbread_521": "* You flexed your arm^1.&* Lemon Bread seems to&  remember something./^",
  "obj_lemonbread_536": "* You let Lemon Bread be^1.&* Lemon Bread's teeth shake.../^",
  "obj_lemonbread_540": "* You let Lemon Bread be^1.&* Nothing else happened./^",
  "obj_lemonbread_545": "* You let Lemon Bread be^1.&* Lemon Bread seems to&  remember something./^",
  "obj_lemonbread_556": "* You cried as loud as you&  could^1.&* But nobody came./^",
  "obj_lesserdoge_204": "(Pant&pant)",
  "obj_lesserdoge_205": "(Wag&wag)",
  "obj_lesserdoge_206": "(Thinks&of&food)",
  "obj_lesserdoge_207": "(Tiny&bark)",
  "obj_lesserdoge_211": "(Pants&fast)",
  "obj_lesserdoge_214": "(Pant!&Pant!)",
  "obj_lesserdoge_215": "(Excited&noises)",
  "obj_lesserdoge_216": "(Motor&revving)",
  "obj_lesserdoge_217": "(Plane&takeoff)",
  "obj_lesserdoge_218": "(Kettle&whistle)",
  "obj_lesserdoge_219": "(...)",
  "obj_lesserdoge_220": "(Faraway&bark)",
  "obj_lesserdoge_221": "(...)",
  "obj_lesserdoge_222": "(Bark)",
  "obj_lesserdoge_223": "(Pant&pant)",
  "obj_lesserdoge_224": "%%%",
  "obj_lesserdoge_420": "* Lesser Dog cocks its head&  to one side.",
  "obj_lesserdoge_421": "* Lesser Dog thinks your&  weapon is a dog treat.",
  "obj_lesserdoge_422": "* Lesser Dog is really not&  paying attention.",
  "obj_lesserdoge_423": "* Smells like dog chow.",
  "obj_lesserdoge_424": "* Lesser Dog is barking&  excitedly.",
  "obj_lesserdoge_425": "* Lesser Dog is overstimulated.",
  "obj_lesserdoge_426": "* Lesser Dog shows no signs&  of stopping.",
  "obj_lesserdoge_427": "* Lesser Dog is lowering.",
  "obj_lesserdoge_428": "* Lesser Dog is learning&  to read.",
  "obj_lesserdoge_429": "* Lesser Dog is whining&  because it can't see&  you.",
  "obj_lesserdoge_430": "* Hello there.",
  "obj_lesserdoge_431": "* Lesser Dog is questioning&  your choices.",
  "obj_lesserdoge_432": "* Lesser Dog has gone where&  no Dog has gone before.",
  "obj_lesserdoge_433": "* Lesser Dog tucks its tail&  between its legs.",
  "obj_lesserdoge_449": "* LESSER DOG - ATK 12 DEF 2&* Wields a stone dogger made&  of pomer-granite./^",
  "obj_lesserdoge_457": "* You barely lifted your&  hand and Lesser Dog&  got excited./^",
  "obj_lesserdoge_458": "* You lightly touched the&  Dog^1.&* It's already overexcited.../^",
  "obj_lesserdoge_459": "* You pet the Dog.&* It raises its head up&  to meet your hand./^",
  "obj_lesserdoge_460": "* You pet the Dog.&* It was a good Dog./^",
  "obj_lesserdoge_461": "* You pet the Dog.&* Its excitement knows no&  bounds./^",
  "obj_lesserdoge_462": "* Critical pet!&* Dog excitement increased./^",
  "obj_lesserdoge_463": "* You have to jump up&  to pet the Dog./^",
  "obj_lesserdoge_464": "* You don't even pet it^1.&* It gets more excited./^",
  "obj_lesserdoge_465": "* There is no way to&  stop this madness./^",
  "obj_lesserdoge_466": "* Lesser Dog enters the&  realm of the clouds./^",
  "obj_lesserdoge_467": "* You call the Dog but it&  is too late^1.&* It cannot hear you./^",
  "obj_lesserdoge_468": "* .../^",
  "obj_lesserdoge_469": "* You can reach Lesser Dog&  again./^",
  "obj_lesserdoge_470": "* You pet Lesser Dog./^",
  "obj_lesserdoge_471": "* It's possible that you&  may have a problem./^",
  "obj_lesserdoge_472": "* Lesser Dog is unpettable&  but appreciates the attempt./^",
  "obj_lesserdoge_473": "* Perhaps mankind was not&  meant to pet this much./^",
  "obj_lesserdoge_474": "* It continues./^",
  "obj_lesserdoge_475": "* Lesser Dog is beyond&  your reach./^",
  "obj_lesserdoge_476": "* Really.../^",
  "obj_librarynpc_jumbler_70": "* Beautiful^1.&* An error message./%%",
  "obj_librarynpc_jumbler_73": "* That look in your eye.../",
  "obj_librarynpc_jumbler_74": "* You're someone that has&  difficulty solving Junior&  Jumble^1, aren't you?/%%",
  "obj_librarynpc_jumbler_78": "* That look in your eye.../",
  "obj_librarynpc_jumbler_79": "* You're someone that has&  trouble doing crosswords^1,&  aren't you?/%%",
  "obj_librarynpc_jumbler_84": "* That look in your eye.../",
  "obj_librarynpc_jumbler_85": "* You think Sudoku is just&  moderately challenging^1,&  don't you?/%%",
  "obj_librarynpc_jumbler_92": "* The greatest struggle of&  my life is over.../",
  "obj_librarynpc_jumbler_93": "* I just solved today's&  Junior Jumble./%%",
  "obj_librarynpc_jumbler_97": "* The greatest struggle of&  my life is over.../",
  "obj_librarynpc_jumbler_98": "* I just solved today's&  crossword./%%",
  "obj_librarynpc_lizard1_70": "* Welcome to the library^1.&* Yes^1, we know^1.&* The sign is misspelled./%%",
  "obj_librarynpc_lizard1_73": "* Yes^1, we know^1.&* The sign is misspelled./",
  "obj_librarynpc_lizard1_74": "* We have someone working on&  it!/%%",
  "obj_librarynpc_lizard1_79": "* Welcome to the library./",
  "obj_librarynpc_lizard1_80": "* This is the last day we'll&  be open^1, so make as much&  noise as you want./%%",
  "obj_librarynpc_lizard2_70": "* I love working on the&  newspaper./",
  "obj_librarynpc_lizard2_71": "* There's so little to report&  that we just fill it with&  comics and games./%%",
  "obj_librarynpc_lizard2_75": "* Yes^1.&* I illustrate all of the&  comics myself./",
  "obj_librarynpc_lizard2_76": "* Yes^1.&* I give everyone huge beautiful&  eyes and giant muscles./%%",
  "obj_librarynpc_lizard2_81": "* Oh my^1, there's so much&  news to report^1, I don't know&  where to begin!/",
  "obj_librarynpc_lizard2_82": "* How about this headline..^1.&* \"Monsters Go Free From The&  Underground.\"/",
  "obj_librarynpc_lizard2_83": "* Nah^1, that doesn't have&  enough pizazz.../",
  "obj_librarynpc_lizard2_84": "* How about \"Top 10 Monsters&  You Won't Believe Got Freed&  From The Underground?\"/%%",
  "obj_librarynpc_wordsearch_70": "* (cough, cough)/",
  "obj_librarynpc_wordsearch_71": "* When I was younger^1, my teachers&  gave me word searches when&  they ran out of assignments./",
  "obj_librarynpc_wordsearch_72": "* I thought they were a waste&  of time./",
  "obj_librarynpc_wordsearch_73": "* But look at me now.../",
  "obj_librarynpc_wordsearch_74": "* I'm the number-one word-search&  creator in the entire&  underground!/%%",
  "obj_librarynpc_wordsearch_78": "* (cough^1, cough)/",
  "obj_librarynpc_wordsearch_79": "* There's a day I just don't&  want to work./",
  "obj_librarynpc_wordsearch_80": "* It's called \"Today.\"/%%",
  "obj_librarynpc_wordsearch_85": "* This will be our newspaper's&  last issue.../",
  "obj_librarynpc_wordsearch_86": "* Why don't we just put a&  big \"THE END\" on the front&  and call it a day?/%%",
  "obj_lock_and_key_66": "* (The way is blocked by two&  padlocks.^1)&* (There's a note attached.)/",
  "obj_lock_and_key_67": "* (Howdy^1! I'm in the garden.)/",
  "obj_lock_and_key_68": "* (If you have anything you&  need to get off your chest^1,&  please don't hesitate to come.)/",
  "obj_lock_and_key_69": "* (The keys are in the kitchen&  and the hallway.)/%%",
  "obj_lock_and_key_73": "\\R* (He leaves them in the&  kitchen and the hallway.)/%%",
  "obj_lock_and_key_78": "* (You'll need both keys to&  get through.)/%%",
  "obj_lock_and_key_82": "\\R* (There are two keys.)/%%",
  "obj_lock_and_key_90": "* (You unlocked the chain.)/%%",
  "obj_lock_and_key_94": "\\R* (I unlocked the chain.)/%%",
  "obj_longsnail_64": "* Snail snail..^1.&* (A long journey extends&  in front of you...)/",
  "obj_longsnail_65": "* Snail snail..^1.&* (Reach far and stretch&  beyond the horizons.)/",
  "obj_longsnail_66": "* Snail snail^1.&* (So snaileth Sam Byool.)/%%",
  "obj_longsnail_70": "* Snail snail./",
  "obj_longsnail_71": "* (Good gosh^1, don't I look&  like a perfectly normal&  snail?)/%%",
  "obj_longsnail_76": "* Snail snail^1.&* (You reached the end of&  your extensive journey.)/",
  "obj_longsnail_77": "* Snail snail^1.&* (What a long trip^1! Remember&  to stretch your muscles.)/%%",
  "obj_loox_197": "I've got&my eye&on you.",
  "obj_loox_198": "Don't&point&that&at me.",
  "obj_loox_199": "Quit&staring&at me.",
  "obj_loox_200": "What an&eyesore.",
  "obj_loox_201": "How&about a&staring&contest?",
  "obj_loox_202": "Please&don't&pick on&me.",
  "obj_loox_205": "Finally&someone&gets it.",
  "obj_loox_209": "You rude&little&snipe!",
  "obj_loox_213": "%%%",
  "obj_loox_403": "* Loox is gazing at you.",
  "obj_loox_404": "* Loox is staring right&  through you.",
  "obj_loox_405": "* Loox gnashes its teeth.",
  "obj_loox_406": "* Smells like eyedrops.",
  "obj_loox_407": "* Loox has gone bloodshot.",
  "obj_loox_408": "* Loox doesn't care about&  fighting anymore.",
  "obj_loox_409": "* Loox is watering.",
  "obj_loox_425": "* LOOX - ATK 6 DEF 6&* Don't pick on him.&* Family name: Eyewalker/^",
  "obj_maddummy_259": "\\E1OWWWW^1, you&DUMMIES!!/",
  "obj_maddummy_260": "\\XWatch where you're&aiming your \\RMAGIC\\X &attacks!/",
  "obj_maddummy_261": "\\E3.../",
  "obj_maddummy_262": "\\XHey^1!&You^1! \\E2Forget&I said anything&about \\RMAGIC\\X!!!/%%",
  "obj_maddummy_319": "Foolish^1.&Foolish^1!&FOOLISH!/",
  "obj_maddummy_320": "Even if you attack&my vessel^1, you'll&NEVER hurt me!/",
  "obj_maddummy_321": "I'm still&incorporeal^1, you&DUMMY!!!/%%",
  "obj_maddummy_422": "Foolish.&Foolish!&FOOLISH!",
  "obj_maddummy_423": "Futile.&Futile!&FUTILE!",
  "obj_maddummy_424": "Pitiful.&Pitiful!&PITIFUL!",
  "obj_maddummy_425": "Feeble.&Feeble!&FEEBLE!",
  "obj_maddummy_429": " I'll defeat you and& take your SOUL!",
  "obj_maddummy_430": " I'll use your SOUL& to cross the barrier!",
  "obj_maddummy_431": " I'll stand in the& window of a fancy& store!",
  "obj_maddummy_432": "\\E3 THEN EVERYTHING I& WANT WILL BE MINE!",
  "obj_maddummy_433": "\\E2 Huh?& Yeah, I guess& that'll avenge my& cousin.",
  "obj_maddummy_434": "\\E0 What was their name& again...?",
  "obj_maddummy_435": " Whatever.& Whatever!& WHATEVER!!",
  "obj_maddummy_441": "DUMMY&BOTS!&MAGIC&MISSILE!",
  "obj_maddummy_442": "DUMMY&BOTS!&TRY&AGAIN!",
  "obj_maddummy_443": "DUMMY&BOTS!&You're&awful???",
  "obj_maddummy_444": "DUMMY&BOTS!&FINAL&ATTACK!",
  "obj_maddummy_459": " (Wait^1, is DUMMY& a compliment...?)",
  "obj_maddummy_465": "%%%",
  "obj_maddummy_1152": "* Mad Dummy is doing an armless&  ska dance.",
  "obj_maddummy_1153": "* Mad Dummy is bossing around&  its bullets.",
  "obj_maddummy_1154": "* Mad Dummy glares into a&  mirror^1, then turns to you&  with the same expression.",
  "obj_maddummy_1155": "* Mad Dummy is hopping mad.",
  "obj_maddummy_1156": "* Smells like a clothing&  store.",
  "obj_maddummy_1157": "* This message will NEVER&  happen.",
  "obj_maddummy_1158": "* Mad Dummy is getting cotton&  all over the dialogue box.",
  "obj_maddummy_1174": "* MAD DUMMY - ATK 30 DEF YES&* Because they're a ghost^1,&  physical attacks will fail./^",
  "obj_maddummy_1194": "* You talk to the DUMMY^1.&* .../",
  "obj_maddummy_1195": "* It doesn't seem much for&  conversation./",
  "obj_maddummy_1196": "* No one is happy with this./^",
  "obj_maddummy_1259": "* Mad Dummy is looking&  nervous.",
  "obj_maddummy_1313": "* Mad Dummy is getting cotton&  all over the dialogue box.",
  "obj_maddummy_1329": "\\E1HEY GUYS!/%%",
  "obj_maddummy_1370": "\\E0Dummies^1.&Dummies^1!&DUMMIES!/",
  "obj_maddummy_1371": "\\E1Remember how I&said NOT to&shoot at me?/",
  "obj_maddummy_1372": "\\E0Well.../",
  "obj_maddummy_1373": "\\E3FAILURES^1!&YOU'RE FIRED^1!&YOU'RE ALL BEING&REPLACED!!!/%%",
  "obj_maddummy_1414": "\\E0Hahaha^1.&Hahaha^1!&HAHAHA!/",
  "obj_maddummy_1415": "Now you'll see&my true power:/",
  "obj_maddummy_1416": "Relying on people&that aren't garbage!/%%",
  "obj_maddummy_1420": "* Mechanical whirrs fill&  the room.",
  "obj_maddummy_1464": "\\E2(N..^1. no way!)/",
  "obj_maddummy_1465": "\\E2(These guys are&even WORSE than&the other guys!)/",
  "obj_maddummy_1466": "\\E3Who cares^1.&Who cares^1!&WHO CARES!!/",
  "obj_maddummy_1467": "I DON'T NEED&FRIENDS!!!/%%",
  "obj_maddummy_1500": "\\E3I'VE GOT&KNIVES!!!/%%",
  "obj_maddummy_1539": "\\E0I'm..^1./",
  "obj_maddummy_1540": "\\E2Out of knives./",
  "obj_maddummy_1541": "\\E3BUT IT DOESN'T&MATTER!!!/",
  "obj_maddummy_1542": "YOU CAN'T HURT&ME AND I CAN'T&HURT YOU!/",
  "obj_maddummy_1543": "YOU'LL BE STUCK&FIGHTING ME.../",
  "obj_maddummy_1544": "Forever./",
  "obj_maddummy_1545": "Forever!/",
  "obj_maddummy_1546": "FOREVER!!!!/",
  "obj_maddummy_1547": "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%",
  "obj_maddummy_1548": "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%",
  "obj_maddummy_1549": "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%",
  "obj_maddummy_1550": "AHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHAHA%",
  "obj_maddummy_1613": "\\E2Wh..^1.&What the heck is&this!?/",
  "obj_maddummy_1614": "\\E3Ergh^1!&Acid rain!?!/",
  "obj_maddummy_1615": "Oh^1, FORGET IT^1!&I'm outta here!/%%",
  "obj_maddummy_1654": "... sorry^1, i&interrupted you^1,&didn't i?/",
  "obj_maddummy_1655": "as soon as i came&over^1, your friend&immediately left.../",
  "obj_maddummy_1656": "oh no..^1.&you guys looked&like you were having&fun.../",
  "obj_maddummy_1657": "oh no..^1.&i just wanted to&say hi.../",
  "obj_maddummy_1658": "oh no.................................................%%",
  "obj_maddummy_1663": "oh wait..^1. didn't you&attack me before.../",
  "obj_maddummy_1664": "uhhh..^1.&that's awkward./",
  "obj_maddummy_1665": "sorry^1.&have a nice day./%%",
  "obj_mainend_158": "* (Ring^1, ring...)/",
  "obj_mainend_160": "* heya./",
  "obj_mainend_161": "\\E1* is anyone there...?/",
  "obj_mainend_162": "\\E2* well^1, i'll just leave&  a message.../%%",
  "obj_mainend_169": "\\E1* is anyone there...?/",
  "obj_mainend_170": "\\E2* well..^1. just calling&  to say./",
  "obj_mainend_171": "\\E1* you made a snowman&  really happy./",
  "obj_mainend_172": "\\E2* ... guess i should&  say something else^1,&  too./%%",
  "obj_mainend_177": "* heya./",
  "obj_mainend_178": "\\E2* well..^1. just calling&  to say./",
  "obj_mainend_179": "\\E1* it's been a while^1.&* shouldn't you SAVE?/",
  "obj_mainend_180": "\\E2* ... guess i should&  say something else^1,&  too./%%",
  "obj_mainend_186": "\\E1* is anyone there...?/",
  "obj_mainend_187": "\\E2* well..^1. just calling&  to ask./",
  "obj_mainend_188": "\\E1* did you ever take&  off that gross&  bandage...?/",
  "obj_mainend_189": "\\E2* ... guess i should&  say something else^1,&  too./%%",
  "obj_mainend_195": "\\E1* is anyone there...?/",
  "obj_mainend_196": "\\E2* well..^1. just calling&  to ask./",
  "obj_mainend_197": "\\E1* did you ever get&  something to eat?/",
  "obj_mainend_198": "\\E2* ... guess i should&  say something else^1,&  too./%%",
  "obj_mainend_204": "\\E1* is anyone there...?/",
  "obj_mainend_205": "\\E2* well..^1. just calling&  to ask./",
  "obj_mainend_206": "\\E1* you really like to&  challenge yourself^1,&  huh...?/",
  "obj_mainend_207": "\\E2* well..^1. good job^1./",
  "obj_mainend_208": "\\E1* just promise not to&  brag about it^1,&  okay?/",
  "obj_mainend_209": "\\E2* ... guess i should&  say something else^1,&  too./%%",
  "obj_mainend_214": "* .../",
  "obj_mainend_215": "* alright^1, i've got the&  number./%%",
  "obj_mainend_250": "* so..^1.&* it's been a while./",
  "obj_mainend_251": "\\E0* the queen returned^1, and&  is now ruling over&  the underground./",
  "obj_mainend_252": "* she's enstated a new&  policy.../",
  "obj_mainend_253": "\\E3* all the humans who fall&  here will be treated&  not as enemies.../",
  "obj_mainend_254": "\\E0* but as friends./",
  "obj_mainend_255": "\\E1* it's probably for the&  best^1, anyway./",
  "obj_mainend_256": "\\E0* the human souls the king&  gathered.../",
  "obj_mainend_257": "\\E3* seem to have&  disappeared./",
  "obj_mainend_258": "\\E1* so^1, uh^1, that plan&  ain't happening any&  time soon./",
  "obj_mainend_263": "* but even though people&  are heartbroken over&  the king.../",
  "obj_mainend_264": "\\E1* ... and things are&  looking grim for our&  freedom.../",
  "obj_mainend_265": "\\E0* the queen's trying her&  best not to let us&  give up hope./",
  "obj_mainend_267": "\\E1* so^1, uh^1, hey.../",
  "obj_mainend_268": "\\E1* if we're not giving&  up down here.../",
  "obj_mainend_269": "\\E2* don't give up wherever&  you are^1, ok?/",
  "obj_mainend_270": "\\E3* who knows how long&  it will take.../",
  "obj_mainend_271": "\\E0* but we will get out&  of here./",
  "obj_mainend_272": "\\E2* that's a promise./",
  "obj_mainend_274": "SANS!!!&WHO ARE YOU&TALKING TO???/",
  "obj_mainend_276": "* oh^1, nobody./",
  "obj_mainend_278": "WHAT!^1?&NOBODY!?/",
  "obj_mainend_279": "\\E0CAN I TALK TO&THEM TOO???/",
  "obj_mainend_281": "* here^1, knock yourself&  out./%%",
  "obj_mainend_292": "WAIT A SECOND.../",
  "obj_mainend_293": "\\E1I RECOGNIZE THIS&NUMBER!!!/",
  "obj_mainend_294": "\\E0ATTENTION^1, HUMAN!/",
  "obj_mainend_295": "\\E2I^1, THE GREAT&PAPYRUS.../",
  "obj_mainend_296": "\\E0AM NOW CAPTAIN OF&THE ROYAL GUARD!/",
  "obj_mainend_297": "\\E2IT'S EVERYTHING I'VE&EVER DREAMED OF.../",
  "obj_mainend_298": "\\E3EXCEPT^1, INSTEAD&OF FIGHTING^1, WE&JUST WATER FLOWERS./",
  "obj_mainend_299": "\\E0SO THAT'S EVER-&SO-SLIGHTLY&DIFFERENT./",
  "obj_mainend_300": "\\E0AND^1, WE'RE HELPING&DR. ALPHYS&WITH HER RESEARCH!/",
  "obj_mainend_301": "\\E0SHE'S GONNA FIND A&WAY TO GET US OUT&OF HERE./",
  "obj_mainend_302": "UNDYNE IS HELPING&HER TOO!/",
  "obj_mainend_303": "\\E3THOUGH^1, TO BE&HONEST^1, HER METHOD&OF HELPING.../",
  "obj_mainend_304": "\\E2SEEMS KIND OF.../",
  "obj_mainend_305": "\\E3EXPLOSION-INDUCING./",
  "obj_mainend_306": "\\E0BUT I THINK ALPHYS&LIKES HAVING HER&AROUND./",
  "obj_mainend_307": "\\E5UH OH!!!/%%",
  "obj_mainend_311": "\\E0HEY!!^1! HUMAN!!!/",
  "obj_mainend_312": "HOW ARE YOU DOING^1?&I'M DOING FINE!!!/",
  "obj_mainend_313": "\\E3WELL, BESIDES ONE&THING.../",
  "obj_mainend_314": "\\E3THE QUEEN&DISBANDED THE&ROYAL GUARD./",
  "obj_mainend_315": "SINCE WE DON'T&HAVE TO FIGHT&HUMANS ANYMORE./",
  "obj_mainend_316": "\\E0WOW!!!/",
  "obj_mainend_317": "\\E3I HAVE NO IDEA&WHAT TO DO&WITH MY LIFE./",
  "obj_mainend_318": "\\E0BUT^1, THAT'S&OKAY!/",
  "obj_mainend_319": "BECAUSE I'M&STILL WORKING&HARD!/",
  "obj_mainend_320": "\\E4EVEN IF IT'S&ON NOTHING AT&ALL!/",
  "obj_mainend_321": "\\E0SO DON'T FEEL&BAD!/",
  "obj_mainend_322": "PAPYRUS IS FINE!/",
  "obj_mainend_323": "\\E5UNDYNE IS THE&ONE THAT'S GOT&IT BAD!/",
  "obj_mainend_324": "\\E3SHE LOST HER&JOB.../",
  "obj_mainend_325": "THEN SHE LOST&HER HOUSE.../",
  "obj_mainend_326": "\\E2IT WAS SAD..^1.&BUT WE'RE TAKING&CARE OF HER!/",
  "obj_mainend_327": "\\E0SHE LIVES ON&OUR COUCH NOW./",
  "obj_mainend_328": "IT'S LIKE A&SLEEPOVER EVERY&NIGHT!/",
  "obj_mainend_329": "A SLEEPOVER&THERE'S NO&ESCAPE FROM./",
  "obj_mainend_330": "OH^1, WE GAVE HER&A JOB^1, TOO./",
  "obj_mainend_331": "\\E3SANS HIRED HER AT&HIS ILLEGAL HOT&DOG STAND./",
  "obj_mainend_332": "\\E5SHE HATES WORKING&THERE!/",
  "obj_mainend_333": "\\E3BUT SHE MAKES&A MEAN HOT DOG./",
  "obj_mainend_334": "\\E3.../",
  "obj_mainend_335": "\\E5OH YEAH./",
  "obj_mainend_338": "I DON'T KNOW HOW&TO PUT THIS^1,&BUT.../",
  "obj_mainend_339": "\\E3SHE^1, UM^1, REALLY&HATES YOU NOW./",
  "obj_mainend_340": "\\E6EVEN MORE THAN&SHE EVER HAS./",
  "obj_mainend_341": "IT'S BECAUSE SHE&MADE FRIENDS WITH&YOU^1, THEN.../",
  "obj_mainend_342": "\\E5SHE SAID YOU&KILLED SOMEONE?/",
  "obj_mainend_343": "\\E3I KNOW^1, THAT&SOUNDS RIDICULOUS&DOESN'T IT?/",
  "obj_mainend_344": "\\E6BUT SHE FEELS SO&HURT AND BETRAYED./",
  "obj_mainend_345": "AND ANGRY AT&HERSELF^1, TOO./",
  "obj_mainend_346": "SHE SAYS.../",
  "obj_mainend_347": "SHE DOESN'T&UNDERSTAND WHY.../",
  "obj_mainend_348": "SHE EVER LET&HERSELF BECOME&FRIENDS WITH YOU./",
  "obj_mainend_349": "THAT SHE KNEW&WHAT HUMANS WERE&LIKE.../",
  "obj_mainend_350": "\\E3AND YET SHE&STILL FAILED TO&RESIST./",
  "obj_mainend_351": "\\E6MORE PEOPLE GOT&HURT BECAUSE OF&HER MISTAKE./",
  "obj_mainend_352": "\\E5I REALLY CAN'T&UNDERSTATE./",
  "obj_mainend_353": "HOW MUCH SHE&HATES YOU./",
  "obj_mainend_354": "\\E6IT PAINS ME TO&SAY THIS^1, BUT.../",
  "obj_mainend_355": "YOU SHOULD&PROBABLY NEVER&COME BACK HERE./",
  "obj_mainend_356": "\\E3IF YOU DO^1, UNDYNE&WILL DEFINITELY&DESTROY YOU./",
  "obj_mainend_357": "\\E5NOT EVEN THE QUEEN&CAN STOP HER./",
  "obj_mainend_358": "\\E6SO^1, UH..^1.&GOODBYE FOREVER./",
  "obj_mainend_359": "I'LL MISS YOU^1,&MY FRIEND./%%",
  "obj_mainend_364": "\\E5AND YOU MADE&ASGORE DISAPPEAR?/",
  "obj_mainend_365": "\\E3AND MADE ALPHYS&DISAPPEAR^1, TOO./",
  "obj_mainend_366": "\\E6SHE'S NOT VERY&HAPPY./",
  "obj_mainend_367": "SHE SAYS THINGS&LIKE.../",
  "obj_mainend_368": "\"I COULDN'T PROTECT&HER.../\"",
  "obj_mainend_369": "IT'S HARD TO GET&HER TO DO ANYTHING&NOW./",
  "obj_mainend_370": "\\E5I EVEN SUGGESTED&WE TRY TO GET&REVENGE ON YOU./",
  "obj_mainend_371": "\\E0YOU KNOW^1, SO I&COULD SEE YOU&AGAIN./",
  "obj_mainend_372": "\\E5BUT SHE JUST&LOOKED AT ME AND&SAID.../",
  "obj_mainend_373": "\\E6REVENGE WON'T BRING&ANYBODY BACK./",
  "obj_mainend_374": "\\E3I HAVE NO IDEA&WHAT YOU DID^1,&BUT.../",
  "obj_mainend_375": "\\E5CAN YOU PLEASE&BRING BACK HER&FRIENDS?/",
  "obj_mainend_376": "IF YOU MADE THEM&DISAPPEAR?/",
  "obj_mainend_377": "\\E6PLEASE.../",
  "obj_mainend_378": "UNDYNE'S NOT&DOING VERY WELL./",
  "obj_mainend_379": "BYE./%%",
  "obj_mainend_385": "\\E3SHE STILL BLAMES&YOU.../",
  "obj_mainend_386": "\\E3FOR THE&DISAPPEARANCE&OF ASGORE./",
  "obj_mainend_387": "\\E3.../",
  "obj_mainend_388": "\\E3SHE TALKS TO ME&A LOT.../",
  "obj_mainend_389": "\\E5ABOUT GETTING&REVENGE ON YOU./",
  "obj_mainend_390": "SHE HAS A&LUDICROUS PLAN.../",
  "obj_mainend_391": "TO CROSS THE&BARRIER AND&BEAT YOU UP./",
  "obj_mainend_392": "\\E3TO BE HONEST^1,&I THINK IT'S&IMPOSSIBLE./",
  "obj_mainend_393": "\\E0BUT I'D LIKE TO&BELIEVE IT'S&NOT!!!/",
  "obj_mainend_394": "CAUSE I WANT TO&GO WITH HER!/",
  "obj_mainend_395": "THEN I'D GET TO&SEE YOU AGAIN!/",
  "obj_mainend_396": "\\E3EVEN IF I'D HAVE&TO FIGHT YOU./",
  "obj_mainend_397": "\\E0WELL^1, KEEP YOUR&FINGERS CROSSED!/",
  "obj_mainend_398": "AND KEEP IN&TOUCH.../",
  "obj_mainend_399": "IT'LL MAKE OUR&PLANS EASIER./",
  "obj_mainend_400": "BYE!/%%",
  "obj_mainend_404": "\\E5AND ALPHYS'&DISAPPEARANCE^1, TOO./",
  "obj_mainend_405": "\\E3SHE'S NOT VERY&HAPPY./",
  "obj_mainend_406": "\\E6SHE SAYS THINGS&LIKE.../",
  "obj_mainend_407": "\"I COULDN'T PROTECT&HER.../\"",
  "obj_mainend_408": "IT'S HARD TO GET&HER TO DO ANYTHING&NOW./",
  "obj_mainend_409": "\\E5I EVEN SUGGESTED&WE TRY TO GET&REVENGE ON YOU./",
  "obj_mainend_410": "\\E0YOU KNOW^1, SO I&COULD SEE YOU&AGAIN./",
  "obj_mainend_411": "\\E3BUT SHE JUST&LOOKED AT ME AND&SAID.../",
  "obj_mainend_412": "\\E6REVENGE WON'T BRING&ANYBODY BACK./",
  "obj_mainend_413": "I HAVE NO IDEA&WHAT YOU DID^1,&BUT.../",
  "obj_mainend_414": "\\E5CAN YOU PLEASE&BRING BACK HER&FRIENDS?/",
  "obj_mainend_415": "IF YOU MADE THEM&DISAPPEAR?/",
  "obj_mainend_416": "\\E6PLEASE.../",
  "obj_mainend_417": "UNDYNE'S NOT&DOING VERY WELL./",
  "obj_mainend_418": "BYE./%%",
  "obj_mainend_434": "* Hey^1!&* What are you up&  to^1, punk!?/",
  "obj_mainend_435": "\\E1* Ngahhhh!/",
  "obj_mainend_437": "PLEASE DON'T NOOGIE&THE PHONE./",
  "obj_mainend_439": "\\E2* Hey^1!&* Who's in charge&  here!?/",
  "obj_mainend_441": "ME./",
  "obj_mainend_443": "* Oh..^1. yeah^1, that's&  right!/",
  "obj_mainend_444": "\\E0* I quit my job as&  leader of the Royal&  Guard./",
  "obj_mainend_445": "\\E4* Actually^1, since we&  won't be fighting&  anymore.../",
  "obj_mainend_446": "\\E1* The Royal Guard&  totally disbanded./",
  "obj_mainend_447": "\\E9* There's^1, uh^1, only&  one member now./",
  "obj_mainend_449": "BUT HE'S EXTREMELY&GOOD./",
  "obj_mainend_451": "* Yeah!^1! He is!!^1!&* C'mere!!/",
  "obj_mainend_453": "PLEASE DON'T NOOGIE&THE SKELETON./",
  "obj_mainend_455": "* Anyways^1, now I'm&  working as Alphy's&  lab assistant.../",
  "obj_mainend_456": "\\E2* We're gonna find a&  way out of this dump&  once and for all!!/",
  "obj_mainend_457": "\\E9* Oh^1, yeah^1, and I'm a&  gym teacher at the&  queen's new school./",
  "obj_mainend_458": "\\E6* Did you know I can&  bench-press seven&  children!?/",
  "obj_mainend_459": "\\E9* Awesome^1, right?/",
  "obj_mainend_460": "* .../",
  "obj_mainend_461": "\\E0* Hey./",
  "obj_mainend_462": "\\E4* I'm sorry about what&  happened with ASGORE./",
  "obj_mainend_463": "\\E4* You were just doing&  what you had to./",
  "obj_mainend_464": "* It's not your fault&  he.../",
  "obj_mainend_465": "* .../",
  "obj_mainend_466": "\\E7* Ah^1, darn it./",
  "obj_mainend_467": "* I miss the big guy./",
  "obj_mainend_469": "\\E7* .../",
  "obj_mainend_470": "\\E1* Come on^1, Undyne^1!&* Snap out of it!/",
  "obj_mainend_471": "\\E4* Uh^1, I guess I'll&  tell you how Alphys&  is doing./",
  "obj_mainend_472": "\\E0* Well^1, she's the&  same as ever./",
  "obj_mainend_473": "\\E4* Maybe a little more&  reclusive than&  normal./",
  "obj_mainend_474": "\\E7* Seems like something's&  really bothering&  her.../",
  "obj_mainend_475": "\\E1* But she can get&  through it!/",
  "obj_mainend_476": "\\E2* I'm there supporting&  her!!/",
  "obj_mainend_477": "\\E9* That's what friends&  are for^1, right?/",
  "obj_mainend_478": "\\E9* .../",
  "obj_mainend_479": "\\E0* Hey^1, where-ever you&  are.../",
  "obj_mainend_480": "\\E4* I hope it's better&  than here./",
  "obj_mainend_481": "\\E7* It took a lot of&  sacrifice for you&  to get there.../",
  "obj_mainend_482": "* So^1, where-ever you&  are.../",
  "obj_mainend_483": "\\E6* You have to try to&  be happy^1, okay!?/",
  "obj_mainend_484": "\\E2* For our sakes!/",
  "obj_mainend_485": "\\E0* We'll feel better&  knowing our trouble&  was worth it./",
  "obj_mainend_486": "\\E9* We're all with you^1!&* Everyone is^1!&* Even the queen!/",
  "obj_mainend_487": "\\E1* .../",
  "obj_mainend_488": "\\E2* HEYYY^1!&* WAIT a second!/",
  "obj_mainend_489": "\\E6* TORIEL^1!&* TORIEL^1!&* Do you wanna...?/",
  "obj_mainend_490": "\\E1* .../",
  "obj_mainend_491": "\\E9* Heh^1, she says&  she's busy./",
  "obj_mainend_493": "BUT IF SHE KNEW&WHO WE WERE&TALKING TO.../",
  "obj_mainend_495": "* we wouldn't get the&  phone back for at&  least a few hours./",
  "obj_mainend_497": "WE HAVE THE&MERCY TO SPARE&YOU FROM HER!!/",
  "obj_mainend_499": "* But call back any&  time^1, ok?!&* She'd love to talk!/",
  "obj_mainend_501": "* oh^1, whoops./",
  "obj_mainend_502": "\\E0* this thing's almost&  outta batteries./",
  "obj_mainend_503": "\\E1* so^1, hate to cut this&  short^1, but.../",
  "obj_mainend_504": "\\E2* be seeing you^1, ok^1,&  buddy?/",
  "obj_mainend_506": "BYE BYE FOR NOW!/",
  "obj_mainend_508": "* See ya^1, punk!/%%",
  "obj_mainend_524": "* H-hey^1, Undyne^1, are&  you okay...?/",
  "obj_mainend_526": "* I'm fine^1.&* Why don't you talk&  for a while?/",
  "obj_mainend_528": "* U..^1. uh^1, okay!/%%",
  "obj_mainend_541": "* Man^1, she's tsundere.../",
  "obj_mainend_542": "\\E1* .../",
  "obj_mainend_543": "\\E2* .../",
  "obj_mainend_544": "\\E7* Um^1, hi.../",
  "obj_mainend_545": "\\E4* S-sorry^1, I hate&  talking on the&  phone./",
  "obj_mainend_546": "\\E3* I don't really know&  what to say./",
  "obj_mainend_547": "\\E1* .../",
  "obj_mainend_548": "\\E7* Hey^1, why didn't you&  tell me the queen&  was so cute?/",
  "obj_mainend_549": "\\E3* Uh^1, I mean^1, uh.../",
  "obj_mainend_550": "\\E6* Mettaton's doing OK!/",
  "obj_mainend_551": "* And^1! Um!/",
  "obj_mainend_552": "\\E6* I'm trying to figure&  a way for us to&  get out of here!/",
  "obj_mainend_553": "\\E4* B-but I kinda have&  no idea what I'm&  doing./",
  "obj_mainend_554": "\\E0* I'll figure it out&  eventually^1, though./",
  "obj_mainend_555": "\\E3* The queen is a lot&  different from&  ASGORE.../",
  "obj_mainend_556": "\\E7* She actually checks to&  see if I'm doing&  anything./",
  "obj_mainend_557": "\\E0* She's really turned&  this whole place&  around!/",
  "obj_mainend_558": "\\E2* .../",
  "obj_mainend_559": "\\E3* Oh^1!&* Hey^1!&* Wait a second!/",
  "obj_mainend_560": "\\E0* Hey^1! TORIEL^1!&* Do you wanna talk&  to...?/",
  "obj_mainend_561": "\\E1* .../",
  "obj_mainend_562": "\\E0* Well^1, she says she's&  busy./",
  "obj_mainend_564": "* Oh^1, she SAYS she's&  busy./",
  "obj_mainend_566": "IF SHE KNEW WHO&WE WERE TALKING&TO.../",
  "obj_mainend_568": "* we wouldn't get the&  phone back for at&  least a few hours./",
  "obj_mainend_570": "WE HAVE THE&MERCY TO SPARE&YOU FROM HER!!/",
  "obj_mainend_572": "* B-but^1, if you want&  to^1, call and talk&  to her any time./",
  "obj_mainend_574": "* Yeah^1!&* She'd be happy to&  hear from ya!/",
  "obj_mainend_576": "* oh^1, whoops./",
  "obj_mainend_577": "\\E0* this thing's almost&  outta batteries./",
  "obj_mainend_578": "\\E1* so^1, hate to cut this&  short^1, but.../",
  "obj_mainend_579": "\\E2* be seeing you^1, ok^1,&  buddy?/",
  "obj_mainend_581": "BYE BYE FOR NOW!/",
  "obj_mainend_583": "* See ya^1, punk!/",
  "obj_mainend_585": "* G-good..^1.&* Good.../",
  "obj_mainend_586": "\\E4* Hey^1, why do I&  have to be the one&  to hang up?/",
  "obj_mainend_587": "\\E7* Eheheh..^1.&* I hate goodbyes.../",
  "obj_mainend_588": "\\E3* Um^1, we'll see you&  again someday!/%%",
  "obj_mainend_612": "* (Click...)/%%",
  "obj_mainend_650": "* so..^1.&* it's been a while./",
  "obj_mainend_651": "\\E0* the queen returned^1, and&  attempted to resume&  ruling the underground./",
  "obj_mainend_652": "* she enstated a new&  policy.../",
  "obj_mainend_653": "\\E3* all the humans who fall&  here would be treated&  not as enemies.../",
  "obj_mainend_654": "\\E0* but as friends./",
  "obj_mainend_655": "\\E3* .../",
  "obj_mainend_656": "\\E1* but people REALLY&  didn't like that&  policy./",
  "obj_mainend_665": "\\E0* because of you^1, not&  only was the king&  gone.../",
  "obj_mainend_666": "\\E3* but the human souls&  had gone missing as&  well.../",
  "obj_mainend_667": "* along with the lives&  of countless citizens./",
  "obj_mainend_669": "* along with the life&  of.../",
  "obj_mainend_671": "* along with the life&  of undyne^1, their&  greatest hero./",
  "obj_mainend_673": "* along with the lives&  of countless citizens./",
  "obj_mainend_674": "* nobody wanted to see&  that happen ever again./",
  "obj_mainend_675": "\\E0* so the people started&  a rebellion to&  overthrow the queen./",
  "obj_mainend_676": "\\E2* but^1, she^1, uh^1, pretty&  much gave up peacefully&  when she realized./",
  "obj_mainend_677": "\\E1* so she went back&  to the ruins./",
  "obj_mainend_678": "\\E0* the underground's&  basically an uneasy&  anarchy now./",
  "obj_mainend_679": "\\E0* everyone's trying to&  live life like they&  always have.../",
  "obj_mainend_680": "\\E3* but it's not really&  easy^1, you know?/",
  "obj_mainend_681": "* when all of your&  hope has pretty much&  been thrown away.../%%",
  "obj_mainend_682": "* .../%%",
  "obj_mainend_688": "\\E1* undyne spearheaded&  the revolution^1, of&  course./",
  "obj_mainend_691": "\\E3* she was pretty mad&  after what happened&  to asgore./",
  "obj_mainend_695": "\\E3* she was pretty mad&  after what happened&  to asgore and alphys./",
  "obj_mainend_697": "\\E1* she threw the queen&  out of the castle&  with her strength./",
  "obj_mainend_698": "\\E0* then she became the&  empress of the&  underground.../",
  "obj_mainend_699": "* and banished the&  queen back to the&  ruins./",
  "obj_mainend_700": "\\E1* seems like undyne's..^1.&* hmmm.../",
  "obj_mainend_701": "\\E3* even more vehement&  about destroying&  humanity than ASGORE./",
  "obj_mainend_702": "\\E1* .../%%",
  "obj_mainend_716": "\\E2* but hey^1!&* it's not all bad!/",
  "obj_mainend_717": "\\E0* she's not so lonely&  anymore./",
  "obj_mainend_718": "\\E1* me and papyrus go&  and visit her.../",
  "obj_mainend_719": "\\E0* we bring her books&  from the library^1,&  or play games.../",
  "obj_mainend_720": "\\E2* we've even convinced&  her to leave&  sometimes./",
  "obj_mainend_721": "\\E1* as long as me or&  papyrus stay behind&  to watch for humans./",
  "obj_mainend_722": "\\E2* but papyrus loves&  doing that./",
  "obj_mainend_724": "YEAH!!^1!&I LOVE STANDING IN&FOR THE QUEEN!!!/",
  "obj_mainend_725": "I'VE BEEN PRACTICING&FOR WHEN A HUMAN&COMES./",
  "obj_mainend_726": "I'M GOING TO BE&A GREAT MOM!!!/",
  "obj_mainend_727": "\\E3BY THE WAY^1,&WHO ARE YOU&TALKING TO?/",
  "obj_mainend_729": "* oh^1, nobody./",
  "obj_mainend_731": "OH, COOL^1.&TELL THEM I SAY&HI!!!/",
  "obj_mainend_733": "* papyrus says hi./",
  "obj_mainend_734": "\\E0* well^1, i hope things&  are better where&  you are./",
  "obj_mainend_735": "\\E2* later./%%",
  "obj_mainend_740": "\\E2* but hey^1!&* it's not all bad!/",
  "obj_mainend_741": "\\E1* when the queen went&  back to the ruins.../",
  "obj_mainend_742": "\\E2* i decided to go&  with her./",
  "obj_mainend_743": "\\E1* and i took out some&  books from the&  library^1, too./",
  "obj_mainend_744": "\\E1* so she won't have&  to read the same&  ones./",
  "obj_mainend_745": "\\E0* she's a good roomie^1.&* we have a lot of&  fun./",
  "obj_mainend_746": "\\E1* .../",
  "obj_mainend_747": "\\E1* you know./",
  "obj_mainend_748": "\\E1* sometimes the queen&  talks about.../",
  "obj_mainend_749": "\\E0* how she'd like to&  see you again./",
  "obj_mainend_750": "\\E1* isn't that nice?/",
  "obj_mainend_751": "\\E3* .../",
  "obj_mainend_752": "\\E3* i don't have the&  heart to tell her&  what you did./",
  "obj_mainend_753": "\\E0* do you know how she'd&  react?/",
  "obj_mainend_754": "\\E3* if i told her that&  'cause she protected&  you.../",
  "obj_mainend_755": "\\E4* ... you went on to&  kill my brother...?/",
  "obj_mainend_756": "\\E3* .../",
  "obj_mainend_757": "\\E1* anyway^1, never come&  back here./",
  "obj_mainend_758": "\\E0* you are not welcome./",
  "obj_mainend_759": "\\E2* later./%%",
  "obj_mainend_784": "* since you left^1,&  things down here.../",
  "obj_mainend_785": "\\E3* are different./",
  "obj_mainend_786": "* with ASGORE gone.../",
  "obj_mainend_787": "\\E0* undyne became the&  ruler of the&  underground./",
  "obj_mainend_788": "\\E3* she's decided to&  destroy every human&  that comes here./",
  "obj_mainend_789": "\\E3* and since the human&  souls disappeared.../",
  "obj_mainend_790": "\\E0* she's also looking&  for a new way to&  break the barrier.../",
  "obj_mainend_791": "* and when she does^1,&  she's going to wage&  war on humanity./",
  "obj_mainend_792": "\\E1* i mean^1, that was&  asgore's plan^1, too./",
  "obj_mainend_793": "\\E2* but he was really^1,&  uh^1, bad at it./",
  "obj_mainend_794": "\\E0* undyne has also&  expanded the royal&  guard massively./",
  "obj_mainend_795": "* she says the first&  thing she'll do after&  we get out of here.../",
  "obj_mainend_796": "* is take her army.../",
  "obj_mainend_797": "\\E3* and personally hunt&  you down and destroy&  you./",
  "obj_mainend_801": "\\E1* meanwhile.../",
  "obj_mainend_802": "* i've been knocking&  on the door to&  the RUINs.../",
  "obj_mainend_803": "\\E3* but the woman that's&  there hasn't been&  answering me./",
  "obj_mainend_804": "\\E1* maybe she's not&  feeling well?/",
  "obj_mainend_805": "\\E3* heh./",
  "obj_mainend_806": "\\E4* or maybe she's not&  feeling anything at&  all...?/",
  "obj_mainend_807": "\\E4* you'd better watch&  yourself^1, kid./",
  "obj_mainend_808": "\\E4* things are lookin&  real bad for you./%%",
  "obj_mainend_813": "\\E1* meanwhile.../",
  "obj_mainend_814": "\\E3* i've been knocking on&  the door to the&  RUINS.../",
  "obj_mainend_815": "\\E3* but that woman hasn't&  been answering me.../",
  "obj_mainend_816": "\\E1* maybe she's not&  feeling well?/",
  "obj_mainend_818": "HEY^1, SANS^1, WHO ARE&YOU TALKING TO?/",
  "obj_mainend_820": "* oh^1, just the human./",
  "obj_mainend_822": "OH^1, COOL./",
  "obj_mainend_823": "\\E3.../",
  "obj_mainend_824": "\\E5WAIT, DID YOU&SAY THE HUMAN!?/",
  "obj_mainend_825": "\\E0CAN I TALK TO&THEM???/",
  "obj_mainend_827": "* sure^1, knock yourself&  out./",
  "obj_mainend_829": "HEY!!^1!&UNDYNE'S THE&EMPRESS NOW!!/",
  "obj_mainend_830": "IT'S AMAZING!!!/",
  "obj_mainend_831": "AND SHE APPOINTED&ME TO BE.../",
  "obj_mainend_832": "THE MOST IMPORTANT&ROYAL POSITION!!!/",
  "obj_mainend_833": "\\E3.../",
  "obj_mainend_834": "\\E3THAT'S IT^1.&THAT'S LITERALLY&THE TITLE./",
  "obj_mainend_835": "\\E0WHAT DO I DO?/",
  "obj_mainend_836": "\\E3SHE TOLD ME TO^1,&UM.../",
  "obj_mainend_837": "\\E3STAND AROUND AND&LOOK CUTE./",
  "obj_mainend_838": "\\E0WELL!!^1!&THAT'S THE PERFECT&JOB FOR ME!!!/",
  "obj_mainend_839": "I DO THAT ALL THE&TIME^1, WITHOUT&TRYING!!/",
  "obj_mainend_840": "FINALLY!^1!&I'M IMPORTANT./",
  "obj_mainend_841": "AND IT'S ALL&THANKS TO YOU,/",
  "obj_mainend_842": "AND THE HORRIBLE&THINGS YOU DID./",
  "obj_mainend_843": "THANK YOU^1, HUMAN!/",
  "obj_mainend_844": "COME BACK AND&VISIT SOMETIME!!/",
  "obj_mainend_845": "\\E3WAIT..^1.&UNDYNE WOULD&PROBABLY KILL YOU./",
  "obj_mainend_846": "\\E0BUT..^1.&YOU'D GET TO&SEE ME./",
  "obj_mainend_847": "SO YOU GOTTA&RISK IT!!!/",
  "obj_mainend_848": "YOU GOTTA!!!/",
  "obj_mainend_849": "SEE YOU SOON./%%",
  "obj_mainend_875": "* so^1, it's been a&  while./",
  "obj_mainend_876": "\\E1* since you left^1, things&  have..^1.&* gotten interesting./",
  "obj_mainend_877": "\\E0* with ASGORE gone^1, the&  people looked to&  undyne to rule.../",
  "obj_mainend_878": "\\E3* but she was nowhere&  to be found./",
  "obj_mainend_879": "\\E2* so mettaton just&  kind of..^1.&* took over?/",
  "obj_mainend_880": "\\E1* he's brainwashed&  everyone with his&  stupid TV show./",
  "obj_mainend_881": "* and made the&  underground into his&  personal paradise./",
  "obj_mainend_882": "\\E3* it's honestly..^1.&* kinda disturbing./",
  "obj_mainend_883": "\\E1* as for me^1?&* oh^1, yeah.../",
  "obj_mainend_884": "\\E2* i'm his agent./%%",
  "obj_mainend_896": "\\E0* HEY THERE^1, DARLING!/",
  "obj_mainend_897": "* THANK YOU SO MUCH FOR&  YOUR HARD WORK.../",
  "obj_mainend_898": "* THANKS TO YOU, THE&  UNDERGROUND IS MORE&  EXCITING THAN EVER!/",
  "obj_mainend_899": "\\E7* OOH LA LA...&* STATUES... MONUMENTS&  TO MY BEAUTY.../",
  "obj_mainend_900": "\\E6* FLOWERS IN THE&  ARRANGEMENT OF MY&  NAME.../",
  "obj_mainend_901": "\\E5* HEDGES IN THE SHAPE&  OF MY SMILE.../",
  "obj_mainend_902": "\\E8* UNDER MY RULE, THE&  UNDERGROUND'S PROBLEMS&  ARE OVER, BABY!/",
  "obj_mainend_903": "\\E7* CROWDING?&* DREARINESS???/",
  "obj_mainend_904": "\\E9* WHO NEEDS THE SUN&  WHEN YOU'VE GOT&  THE SPOTLIGHT!!?/",
  "obj_mainend_905": "\\E1* ECONOMIC COLLAPSE?&* EDUCATION PROBLEMS?&* WHAT!?/",
  "obj_mainend_906": "\\E8* EVERYTHING'S COVERED&  IN GOLDEN GLITTER!/",
  "obj_mainend_907": "\\E6* THERE ARE NO&  PROBLEMS, BEAUTIFUL!/",
  "obj_mainend_908": "\\E0* AND, I'VE ENSTATED&  A NEW POLICY ON&  HUMANITY./",
  "obj_mainend_909": "\\E1* IF A HUMAN FALLS DOWN&  HERE.../",
  "obj_mainend_910": "\\E6* THEY CAN JOIN MY&  FAN CLUB FOR FREE!/",
  "obj_mainend_911": "\\E1* OH, YOU MIGHT BE&  WONDERING ABOUT&  ALPHYS./",
  "obj_mainend_912": "\\E0* DON'T WORRY!/",
  "obj_mainend_913": "\\E9* I BUILT A STATUE&  OF HER, TOO./",
  "obj_mainend_914": "\\E1* .../",
  "obj_mainend_915": "\\E3* REALLY THOUGH.&* I REALIZED I WAS.../",
  "obj_mainend_916": "\\E4* NOT THE GREATEST&  TO HER./",
  "obj_mainend_917": "\\E1* SO I WENT TO&  APOLOGIZE./",
  "obj_mainend_918": "\\E9* AND, TO ASK HER&  TO HELP ME RULE./",
  "obj_mainend_919": "\\E1* .../",
  "obj_mainend_920": "\\E3* BUT I COULDN'T FIND&  HER./",
  "obj_mainend_921": "\\E4* TRUST ME.&* I LOOKED./",
  "obj_mainend_922": "\\E3* .../",
  "obj_mainend_923": "\\E1* ANYWAY./",
  "obj_mainend_924": "\\E2* I HOPE YOUR LIFE&  AFTER MEETING ME.../",
  "obj_mainend_925": "\\E7* HAS BEEN WORTH LIVING./",
  "obj_mainend_926": "\\E6* IT MUST BE A STRUGGLE./",
  "obj_mainend_927": "\\E0* PLEASE, THINK OF ME&  ALWAYS./",
  "obj_mainend_928": "\\E5* JUST CONSTANTLY.&* THINK OF ME POSING.&* BEAUTIFULLY.../",
  "obj_mainend_929": "\\E6* OH YESSSS!!!/",
  "obj_mainend_933": "\\E6* OH YESSSS!!!/%%",
  "obj_mainend_937": "\\E2* OH^1, MY OTHER AGENT&  WANTS TO TALK./",
  "obj_mainend_939": "HEY!!^1!&IT'S ME^1, PAPYRUS!!/",
  "obj_mainend_940": "\\E2IMAGINE ME WEARING&COOL GLASSES^1, AND&A SUIT./",
  "obj_mainend_941": "\\E0AND IMAGINE SANS&WEARING SUNGLASSES&BEING A BOUNCER./",
  "obj_mainend_942": "THAT'S OUR LIFE..^1.&IT'S SO COOL!!!/",
  "obj_mainend_943": "THINGS HAVE GOTTEN&WAY BETTER SINCE&YOU CAME HERE!!!/",
  "obj_mainend_944": "\\E3WELL^1, MINUS THE&FACT THAT&EVERYTHING SUCKS.../",
  "obj_mainend_945": "\\E5FOR ANYONE THAT&DOESNT WORSHIP&METTATON./",
  "obj_mainend_946": "\\E3AND MINUS THE FACT&THAT MY FRIEND&UNDYNE IS MISSING./",
  "obj_mainend_947": "WHO KNOWS WHERE&SHE WENT./",
  "obj_mainend_948": "SHE NEVER LIKED&METTATON'S SHOW./",
  "obj_mainend_949": "\\E3PEOPLE WHO DON'T&TEND TO KIND OF.../",
  "obj_mainend_950": "\\E5DISAPPEAR./",
  "obj_mainend_951": "\\E6I MISS HER A&LOT SOMETIMES./",
  "obj_mainend_952": "\\E0IF YOU SEE HER^1,&CAN YOU TELL HER&I SAID HI?/",
  "obj_mainend_953": "THANKS^1!&SEE YOU LATER!/%%",
  "obj_mainend_984": "\\E3* so.^1.&* it's been a while./",
  "obj_mainend_985": "* since you left.../",
  "obj_mainend_986": "\\E1* things have gotten&  really strange./",
  "obj_mainend_987": "\\E0* overnight^1, a bunch of&  people mysteriously&  disappeared./",
  "obj_mainend_988": "\\E3* as well as the&  human souls./",
  "obj_mainend_989": "\\E3* people were heart-&  broken. everyone they&  looked up to.../",
  "obj_mainend_990": "* everything they were&  relying on^1, in one&  night, disappeared./",
  "obj_mainend_991": "* everyone clamored to&  elect a new ruler as&  fast as possible./",
  "obj_mainend_992": "\\E1* so^1, uh..^1.&* by process of&  elimination.../",
  "obj_mainend_993": "\\E2* papyrus became the&  ruler?/",
  "obj_mainend_994": "\\E1* why doesn't he talk&  to you about this.../",
  "obj_mainend_996": "\\E0HELLO!!^1!&HUMAN!!!/",
  "obj_mainend_997": "\\E3IT'S STRANGE./",
  "obj_mainend_998": "\\E3ASGORE^1, ALPHYS^1,&METTATON^1, AND&UNDYNE WENT AWAY./",
  "obj_mainend_999": "\\E0SANS SAYS THEY&WENT ON VACATION./",
  "obj_mainend_1000": "I HOPE THEY'RE&HAVING FUN!!!/",
  "obj_mainend_1001": "\\E3OH YEAH./",
  "obj_mainend_1002": "\\E0I'M THE RULER OF&THE UNDERGROUND&NOW!!!/",
  "obj_mainend_1003": "EVERYTHING IS&IMPROVING A LOT&HERE./",
  "obj_mainend_1004": "PRODUCTIVITY IS UP!/",
  "obj_mainend_1005": "BECAUSE I TELL&EVERYONE TO KEEP&WORKING./",
  "obj_mainend_1006": "AND^1, NO ONE GOES&HUNGRY!!!/",
  "obj_mainend_1007": "BECAUSE I COOK&EVERYONE&SPAGHETTI./",
  "obj_mainend_1008": "\\E3MEANWHILE^1, MY&BROTHER HANDLES&THE PAPERWORK./",
  "obj_mainend_1009": "\\E3STRANGELY..^1.&HE SEEMS TO BE&WORKING HARD?/",
  "obj_mainend_1010": "\\E3THIS SOUNDS MESSED&UP..^1. BUT.../",
  "obj_mainend_1011": "\\E5I'M PROUD..^1.&OF HIM???/",
  "obj_mainend_1012": "OH NO!!!!/",
  "obj_mainend_1013": "\\E0AS FOR OUR HUMAN&POLICY.../",
  "obj_mainend_1014": "\\E3WE'VE DECIDED^1, UM./",
  "obj_mainend_1015": "SANS^1, WHAT WAS IT?/",
  "obj_mainend_1017": "\\E2* we can't judge&  humans to be all&  good or all bad./",
  "obj_mainend_1019": "\\E0RIGHT^1!&SO IT'S CASE-BY-&CASE!/",
  "obj_mainend_1020": "IF THEY'RE EVIL..^1.&WE GIVE THEM&PUZZLES!/",
  "obj_mainend_1021": "IF THEY'RE GOOD..^1.&WE ALSO GIVE&THEM PUZZLES!/",
  "obj_mainend_1022": "THAT SEEMS TO BE&THE BEST WAY!/",
  "obj_mainend_1023": "\\E0.../",
  "obj_mainend_1024": "\\E3.../",
  "obj_mainend_1025": "IS SANS GONE?/",
  "obj_mainend_1026": "\\E6YOU KNOW.../",
  "obj_mainend_1027": "DON'T TELL MY&BROTHER, BUT.../",
  "obj_mainend_1028": "DESPITE THE&IMPROVEMENTS&WE'VE MADE.../",
  "obj_mainend_1029": "SOMETIMES THIS JOB&IS KIND OF HARD./",
  "obj_mainend_1030": "SINCE THE KING&WENT AWAY.../",
  "obj_mainend_1031": "LOTS OF PEOPLE&JUST WANT TO&GIVE UP./",
  "obj_mainend_1032": "SOMETIMES, EVEN MY&BEST&ENCOURAGEMENT.../",
  "obj_mainend_1033": "DOESN'T WORK./",
  "obj_mainend_1034": "AND^1, AND^1, I MISS&UNDYNE^1, TOO./",
  "obj_mainend_1035": "SHE NEVER ANSWERS&MY PHONE CALLS.../",
  "obj_mainend_1036": "\\E5SHE MUST BE& HAVING A LOT OF&FUN ON VACATION./",
  "obj_mainend_1037": "\\E6I JUST WISH SHE'D&SEND A POSTCARD./",
  "obj_mainend_1038": ".../",
  "obj_mainend_1039": "\\E5BUT HEY!!!/",
  "obj_mainend_1040": "\\E4I WON'T GIVE UP!/",
  "obj_mainend_1041": "I CAN'T GIVE UP!/",
  "obj_mainend_1042": "I HAVE TO MAKE&EVERYONE GIVE UP&GIVING UP!/",
  "obj_mainend_1043": "\\E0WE'LL GET OUT&OF HERE^1, SLOWLY!!!/",
  "obj_mainend_1044": "THEN WE CAN ALL&HANG OUT AGAIN!!!/",
  "obj_mainend_1045": "\\E0NYEH HEH HEH!!!/%%",
  "obj_mainend_1055": "\\E3* it's been a while^1,&  huh?/",
  "obj_mainend_1056": "* .../",
  "obj_mainend_1057": "* things have gotten&  pretty bad here./",
  "obj_mainend_1058": "\\E0* everyone considered a&  leader disappeared&  overnight./",
  "obj_mainend_1059": "\\E1* it's gotten so quiet./",
  "obj_mainend_1060": "\\E3* there's a bad feeling&  hanging over&  everyone./",
  "obj_mainend_1061": "* like everyone's just&  going to die here^1,&  trapped in the dark.../",
  "obj_mainend_1062": "\\E2* ... i bet you're&  wondering why i'm&  not the ruler./",
  "obj_mainend_1063": "\\E1* eh./",
  "obj_mainend_1064": "\\E1* i'm not cut out&  for something like&  that./",
  "obj_mainend_1065": "\\E2* i like to take it&  easy^1, you know?/",
  "obj_mainend_1066": "\\E2* .../",
  "obj_mainend_1067": "\\E3* ... that's a joke./",
  "obj_mainend_1068": "\\E3* this is what happens&  when people like me&  take it easy./",
  "obj_mainend_1069": "* .../",
  "obj_mainend_1070": "\\E4* see ya./%%",
  "obj_mainend_1074": "\\E0* hey^1, at least things&  are less crowded./",
  "obj_mainend_1075": "\\E1* 'cause of all the&  people you killed./",
  "obj_mainend_1076": "\\E2* hope that was a good&  experience for you./",
  "obj_mainend_1077": "\\E3* .../",
  "obj_mainend_1078": "\\E2* just kidding^1.&* i don't really hope&  that./",
  "obj_mainend_1079": "\\E4* go to hell./%%",
  "obj_mainend_1092": "\\E3* it's been a while^1,&  huh?/",
  "obj_mainend_1093": "* .../",
  "obj_mainend_1094": "\\E1* it seems a number of&  important people&  disappeared overnight./",
  "obj_mainend_1095": "* but no one else was&  harmed./",
  "obj_mainend_1096": "\\E0* the people were&  confused^1.&* it was complete bedlam./",
  "obj_mainend_1097": "\\E3* somehow^1, at the end of&  the day.../",
  "obj_mainend_1098": "\\E1* a small^1, white dog&  became president of&  the underground./",
  "obj_mainend_1099": "\\E0* it sleeps on the&  throne and does&  absolutely nothing./",
  "obj_mainend_1100": "\\E1* strangely^1, it seems&  this is the best&  life for everyone./",
  "obj_mainend_1101": "\\E2* thanks./%%",
  "obj_mainend_1112": "\\E3* it's been a while^1,&  huh?/",
  "obj_mainend_1113": "* .../",
  "obj_mainend_1114": "\\E1* i'll be honest./",
  "obj_mainend_1115": "\\E2* i have no idea what&  happened for you&  to get here./",
  "obj_mainend_1116": "\\E1* this is actually some&  sort of error-&  handling message./",
  "obj_mainend_1117": "\\E3* so^1, if you're getting&  this ending.../",
  "obj_mainend_1118": "\\E1* tell whoever made the&  game^1, okay?/",
  "obj_mainend_1119": "\\E2* they'll fix it^1, or&  if it's a novel&  situation.../",
  "obj_mainend_1120": "\\E1* they might even add&  another ending to&  the game./",
  "obj_mainend_1121": "\\E3* chances are^1, though.../",
  "obj_mainend_1122": "\\E4* you're just a dirty&  hacker^1, aren't you?/",
  "obj_mainend_1123": "\\E1* yeah^1, get outta here./%%",
  "obj_mainend_1136": "\\E1* H..^1. hey./",
  "obj_mainend_1137": "\\E0* So..^1. you're the one&  who killed all my&  friends./",
  "obj_mainend_1139": "\\E1* I just called to tell&  you./",
  "obj_mainend_1141": "\\E0* I hate you./",
  "obj_mainend_1143": "\\E1* Yet..^1. strangely..^1.&* It's because of you^1,&  that.../",
  "obj_mainend_1145": "\\E2* That I was forced to&  become a better&  person./",
  "obj_mainend_1147": "\\E0* When I first saw you&  hurting people.../",
  "obj_mainend_1148": "* I just sat there^1.&* Watching you./",
  "obj_mainend_1149": "\\E1* I felt so guilty knowing&  I hadn't do anything&  to stop you./",
  "obj_mainend_1150": "\\E3* I felt like all I&  do was.../",
  "obj_mainend_1151": "\\E4* Was hope you would&  destroy me^1, too./",
  "obj_mainend_1152": "\\E1* But when Undyne called^1,&  with crazed desperation&  in her voice.../",
  "obj_mainend_1153": "\\E0* I..^1.&* I realized I had to do&  something./",
  "obj_mainend_1154": "\\E1* Even if it meant&  everybody would.../",
  "obj_mainend_1155": "* Have to learn the&  truth about me./",
  "obj_mainend_1156": "\\E2* It's strange^1.&* You know?/",
  "obj_mainend_1157": "\\E5* Even after all the&  bad things I did./",
  "obj_mainend_1158": "* People treated me like&  a hero./",
  "obj_mainend_1159": "\\E2* And then they..^1.&* Asked me to run&  everything./",
  "obj_mainend_1160": "\\E5* So I'm trying my&  best^1, here./",
  "obj_mainend_1161": "\\E2* I think I have some&  good policies^1, but^1,&  y-you know.../",
  "obj_mainend_1162": "\\E1* Talking to people&  still makes me&  nervous./",
  "obj_mainend_1163": "\\E0* I'm no ASGORE^1,&  you know?/",
  "obj_mainend_1164": "\\E2* .../",
  "obj_mainend_1165": "\\E4* God..^1.&* I miss everyone./",
  "obj_mainend_1166": "\\E3* Now that they're&  gone^1, it.../",
  "obj_mainend_1167": "* It feels so clear what&  I should have done./",
  "obj_mainend_1168": "\\E3* What I should have&  said./",
  "obj_mainend_1169": "\\E6* Undyne..^1.&* Asgore.../",
  "obj_mainend_1170": "* Mettaton.../",
  "obj_mainend_1171": "\\E5* At least Sans is&  still here./",
  "obj_mainend_1172": "\\E4* He's..^1.&* He's a good guy^1.&* And with him around.../",
  "obj_mainend_1173": "\\E4* I.../",
  "obj_mainend_1174": "\\E2* Sigh./",
  "obj_mainend_1175": "\\E1* You know^1.&* Just daydreaming here^1.&* But.../",
  "obj_mainend_1176": "\\E5* I really should have&  killed you when I&  had the chance./%%",
  "obj_mandog_251": "Take my&wife...&'s fleas.",
  "obj_mandog_252": "Don't&touch my&hot dog.",
  "obj_mandog_253": "No. 2&Nuzzle&Champs&'98!!",
  "obj_mandog_254": "Let's&kick&human&tail!!",
  "obj_mandog_259": "Hm?&What's&that&smell?",
  "obj_mandog_260": "What!&Smells&like a&...",
  "obj_mandog_264": "Paws off&you&smelly&human.",
  "obj_mandog_267": "Wow!!!&Pet by&another&pup!!!",
  "obj_mandog_272": "Stop!&Don't&touch&her!",
  "obj_mandog_273": "What&about&me......&........",
  "obj_mandog_280": "Whine.",
  "obj_mandog_281": "Whimper.",
  "obj_mandog_284": "%%%",
  "obj_mandog_474": "* Dogamy is brokenhearted.",
  "obj_mandog_490": "* DOGAMY - ATK 14 DEF 5&* Husband of Dogaressa.&* Knows only what he smells./^",
  "obj_mandog_498": "* The Dogs sniff you again.../",
  "obj_mandog_499": "* But you smell just as&  weird as before!/^",
  "obj_mandog_500": "* The Dogs sniff you again.../",
  "obj_mandog_501": "* After rolling in the dirt^1,&  you smell all right!/^",
  "obj_mandog_502": "* The Dogs already know you&  smell fine./^",
  "obj_mandog_503": "* Dogamy won't even lift&  up his snout./^",
  "obj_mandog_513": "* Dogamy just growls at&  you./^",
  "obj_mandog_516": "* The Dogs are too suspicious&  of your smell./^",
  "obj_mandog_517": "* You pet Dogamy./^",
  "obj_mandog_527": "* You roll around in the&  dirt and snow./",
  "obj_mandog_528": "* You smell like a weird&  puppy./^",
  "obj_memoryhead_166": "Come&join&the&fun.",
  "obj_memoryhead_167": "It's a&real&get&together",
  "obj_memoryhead_168": "Lorem&ipsum&docet",
  "obj_memoryhead_169": "Become&one of&us!",
  "obj_memoryhead_171": "Come&join&the&fun.",
  "obj_memoryhead_181": "That's&a&shame.",
  "obj_memoryhead_182": "Oh&well.",
  "obj_memoryhead_183": "Be&seeing&you.",
  "obj_memoryhead_188": "Then,&hold&still.",
  "obj_memoryhead_189": "Just&a&moment.",
  "obj_memoryhead_190": "You'll&be with&us&shortly.",
  "obj_memoryhead_195": "%%%",
  "obj_memoryhead_420": "* But nobody came.",
  "obj_memoryhead_421": "* But nobody came.",
  "obj_memoryhead_422": "* But nobody came.",
  "obj_memoryhead_423": "* But nobody came.",
  "obj_memoryhead_424": "* Smells like batteries.",
  "obj_memoryhead_425": "* Seems like it doesn't&  care anymore.",
  "obj_memoryhead_426": "* Monster has low HP.",
  "obj_memoryhead_461": "* No data available./^",
  "obj_memoryhead_472": "* The enemy put a piece of&  itself in your inventory./^",
  "obj_memoryhead_474": "* But your inventory was full./^",
  "obj_memoryhead_484": "* AT - \\[1] DF - \\[2] /^",
  "obj_memoryhead_493": "* You take out your CELL PHONE^1.&* You can hear voices through&  the receiver...!/^",
  "obj_memoryhead_511": "* MEMORYHEAD/^",
  "obj_mett_bossintro_174": "Ohhhh my./",
  "obj_mett_bossintro_175": "If you flipped my&switch, that can&only mean one&thing./",
  "obj_mett_bossintro_176": "You're desperate&for the premiere&of my new body./",
  "obj_mett_bossintro_177": "How rude.../",
  "obj_mett_bossintro_178": "Lucky for you,&I've been aching&to show this off&for a long time./",
  "obj_mett_bossintro_179": "So..^1. as thanks^1,&I'll give you a&handsome reward./",
  "obj_mett_bossintro_180": "I'll make your&last living&moments.../%%",
  "obj_mett_bossintro_213": "ABSOLUTELY beautiful!/%%",
  "obj_mettaton_neo_449": "* Stage lights are blaring.",
  "obj_mettaton_neo_461": "* Stage lights are blaring.",
  "obj_mettaton_neo_482": "* METTATON NEO - 90 ATK 9 DEF&* Dr. Alphys's greatest&  invention./^",
  "obj_mettaton_neo_535": "\\E6G...&GUESS SHE SHOULD&HAVE WORKED MORE&ON THE DEFENSES.../",
  "obj_mettaton_neo_536": "\\E6.../",
  "obj_mettaton_neo_537": "\\E6YOU MAY HAVE&DEFEATED ME...&BUT.../",
  "obj_mettaton_neo_538": "\\E4I KNOW.&I CAN TELL FROM&THAT STRIKE, DARLING./",
  "obj_mettaton_neo_539": "\\E5YOU WERE HOLDING&BACK./",
  "obj_mettaton_neo_540": "\\E6YES, ASGORE WILL&FALL EASILY TO&YOU.../",
  "obj_mettaton_neo_541": "\\E5BUT YOU WON'T&HARM HUMANITY,&WILL YOU?/",
  "obj_mettaton_neo_542": "\\E1YOU AREN'T&ABSOLUTELY EVIL./",
  "obj_mettaton_neo_543": "\\E5IF YOU WERE&TRYING TO BE,&THEN YOU MESSED UP./",
  "obj_mettaton_neo_544": "\\E0AND SO LATE INTO&THE SHOW, TOO./",
  "obj_mettaton_neo_545": "\\E0HA... HA.&AT LEAST NOW,&I CAN REST EASY./",
  "obj_mettaton_neo_546": "\\E3KNOWING ALPHYS AND&THE HUMANS WILL&LIVE ON...!/%%",
  "obj_mettaton_neo_550": "\\E6GH.../",
  "obj_mettaton_neo_551": "\\E5GUESS YOU DON'T&WANNA JOIN MY&FAN CLUB...?/%%",
  "obj_mettaton_npc_63": "* Capital wenisberry./%%",
  "obj_mettaton_npc_69": "\\W* \\YMILK^1, SUGAR^1, \\WAND\\Y EGGS\\W!&* YOU SHOULD BE ABLE TO FIND&  THEM ON THE BACK COUNTER!/%%",
  "obj_mettaton_npc_77": "* GREAT JOB^1!&* JUST PUT THEM IN THE MIDDLE&  OF THIS COUNTER!/%%",
  "obj_mettaton_npc_82": "* WHAT'S THE MATTER?&* NOT A CAN FAN?&* THAT'S TOO BAD!/",
  "obj_mettaton_npc_83": "* MTT-BRAND USES ONLY THE&  FRESHEST ARTIFICIAL INGREDIENTS&  AND CHEMICALS!/%%",
  "obj_mettatonb_quiz_255": "LET'S START WITH&AN EASY ONE!!/%%",
  "obj_mettatonb_quiz_258": "HERE'S YOUR TERRIFIC&PRIZE!/%%",
  "obj_mettatonb_quiz_262": "ENOUGH ABOUT YOU.&LET'S TALK ABOUT ME!/%%",
  "obj_mettatonb_quiz_266": "HERE'S ANOTHER EASY&ONE FOR YOU!/%%",
  "obj_mettatonb_quiz_270": "DON'T 'COUNT'&ON YOUR VICTORY.../%%",
  "obj_mettatonb_quiz_274": "LET'S PLAY MEMORY&GAME./%%",
  "obj_mettatonb_quiz_278": "BUT CAN YOU GET&THIS ONE???/%%",
  "obj_mettatonb_quiz_282": "HERE'S A SIMPLE&ONE./%%",
  "obj_mettatonb_quiz_286": "TIME TO BREAK OUT&THE BIG GUNS!!/%%",
  "obj_mettatonb_quiz_294": "%%%",
  "obj_mettatonb_quiz_490": "* Mettaton.",
  "obj_mettatonb_quiz_514": "* METTATON - ATK 30 DEF 255&* His metal body renders him&  invulnerable to attack./^",
  "obj_mettatonb_quiz_524": "* Screaming is against the&  rules./^",
  "obj_mettatonb_second_256": "THIS IS IT, DARLING!&SAY GOODBYE!/%%",
  "obj_mettatonb_second_265": "HA!&THAT BUTTON WON'T&SAVE YOU NOW, DARLING!/%%",
  "obj_mettatonb_second_268": "YOU WOULDN'T DARE&USE THE [ACT] COMMAND&AND PRESS THAT&BUTTON!/%%",
  "obj_mettatonb_second_271": "THAT'S RIGHT!&DON'T PRESS IT!&I'LL DESTROY YOU!/%%",
  "obj_mettatonb_second_274": "WITHOUT THAT BUTTON,&YOU ARE INCHING&CLOSER AND CLOSER&TO YOUR DEMISE!/%%",
  "obj_mettatonb_second_277": "ANY MINUTE NOW!&    /%%",
  "obj_mettatonb_second_280": "ANY... MINUTE...&....NOW!/%%",
  "obj_mettatonb_second_284": ".............&............/%%",
  "obj_mettatonb_second_290": "..........&...(COUGH)/%%",
  "obj_mettatonb_second_299": "OH!!!&THAT YELLOW GLOW...!/%%",
  "obj_mettatonb_second_300": "TOOK YOU LONG&ENOUGH!/%%",
  "obj_mettatonb_second_542": "* Mettaton.",
  "obj_mettatonb_second_564": "* METTATON - ATK 30 DEF 255&* His metal body STILL renders&  him invulnerable to attack./^",
  "obj_mettatonb_second_574": "* You yell..^1.&* Nothing happened./^",
  "obj_mettatonb_second_579": "* You press the yellow button^1.&* The phone is resonating with&  Mettaton's presence...!/^",
  "obj_mettatonb_second_640": "IS THAT YOUR PHONE?&YOU'D BETTER ANSWER&IT!/%%",
  "obj_mettatonb_second_652": "H-hey!!&Th-this seems bad,&but don't worry!!/",
  "obj_mettatonb_second_653": "Th-there's one last&thing I installed&on your phone...!/",
  "obj_mettatonb_second_654": "\\WYou see that\\Y &yellow button\\W...?/",
  "obj_mettatonb_second_655": "Go to this phone's&[[ACT]] menu and&press it!!!/%%",
  "obj_mettatonb_second_662": "* Your phone's [[ACT]] menu is&  glowing.",
  "obj_mettatonb_second_703": "Now press \\*Z!!!",
  "obj_mettatonb_second_746": "OOOH!/",
  "obj_mettatonb_second_747": "OOOOOOOH!/",
  "obj_mettatonb_second_748": "YOU'VE DEFEATED ME!!/",
  "obj_mettatonb_second_749": "HOW CAN THIS BE,&YOU WERE STRONGER&THAN I THOUGHT, ETC./%%",
  "obj_mettatonb_second_757": "WHATEVER.",
  "obj_mettatonb_third_214": "THIS IS IT, DARLING!&SAY GOODBYE!/%%",
  "obj_mettatonb_third_224": "YES, I WAS THE ONE&THAT RE-ARRANGED&THE CORE!/",
  "obj_mettatonb_third_225": "I WAS THE ONE THAT&HIRED EVERYONE TO&KILL YOU!/",
  "obj_mettatonb_third_226": "THAT, HOWEVER, WAS A&SHORT-SIGHTED PLAN./",
  "obj_mettatonb_third_227": "YOU KNOW WHAT WOULD&BE A HUNDRED TIMES&BETTER?/",
  "obj_mettatonb_third_228": "KILLING YOU MYSELF!!/%%",
  "obj_mettatonb_third_233": "LISTEN, DARLING.&I'VE SEEN YOU FIGHT./",
  "obj_mettatonb_third_234": "YOU'RE WEAK./",
  "obj_mettatonb_third_235": "IF YOU CONTINUE&FORWARD, ASGORE WILL&TAKE YOUR SOUL./",
  "obj_mettatonb_third_236": "AND WITH YOUR SOUL,&ASGORE WILL DESTROY&HUMANITY./%%",
  "obj_mettatonb_third_241": "BUT IF I GET YOUR&SOUL, I CAN STOP&ASGORE'S PLAN!/",
  "obj_mettatonb_third_242": "I CAN SAVE HUMANITY&FROM DESTRUCTION!/%%",
  "obj_mettatonb_third_247": "THEN, USING YOUR SOUL,&I'LL CROSS THROUGH&THE BARRIER.../",
  "obj_mettatonb_third_248": "AND BECOME THE STAR&I'VE ALWAYS DREAMED&OF BEING!/",
  "obj_mettatonb_third_249": "HUNDREDS, THOUSANDS.../",
  "obj_mettatonb_third_250": "NO!&MILLIONS OF HUMANS&WILL WATCH ME!/%%",
  "obj_mettatonb_third_255": "GLITZ! GLAMOUR!&I'LL FINALLY HAVE&IT ALL!/",
  "obj_mettatonb_third_256": "SO WHAT IF A FEW&PEOPLE HAVE TO DIE?/",
  "obj_mettatonb_third_257": "THAT'S SHOW BUSINESS,&BABY!/%%",
  "obj_mettatonb_third_523": "* Mettaton.",
  "obj_mettatonb_third_545": "* METTATON - ATK 30 DEF 255&* Seriously^1, his metal body&  is invulnerable!/^",
  "obj_mettatonb_third_555": "* This is probably what you'll&  do if things continue in&  this manner./^",
  "obj_mettatonb_third_560": "* You tell Mettaton that there's&  a mirror behind him./%%",
  "obj_mettatonb_third_644": "U..uh... I can't see&what's going on in&there, but.../",
  "obj_mettatonb_third_645": "D-d-don't give up,&okay!?/",
  "obj_mettatonb_third_646": "Th... there's o-one&l-l-last way to beat&Mettaton.../",
  "obj_mettatonb_third_647": "It's... um... it's.../",
  "obj_mettatonb_third_648": "This is a work in-&progress, so don't&judge it too hard.../",
  "obj_mettatonb_third_649": "But, you know how&Mettaton always faces&f-f-forward?/",
  "obj_mettatonb_third_650": "That's because&there's a switch&on his backside./",
  "obj_mettatonb_third_651": "S-s-so if y-y-you&c-c-can turn him&around... um.../",
  "obj_mettatonb_third_652": "And, umm... press&th-th-th-the&switch.../",
  "obj_mettatonb_third_653": "He'll be... um...&He'll be.../",
  "obj_mettatonb_third_654": "Vulnerable./",
  "obj_mettatonb_third_655": "Well, g-g-gotta go!/%%",
  "obj_mettatonb_third_688": "* Seems like a good time to&  turn Mettaton around.",
  "obj_mettatonb_third_820": "OH???&A MIRROR???/",
  "obj_mettatonb_third_821": "RIGHT, I HAVE TO&LOOK PERFECT FOR&OUR GRAND FINALE!/%%",
  "obj_mettatonb_third_831": "HMMM...&I DON'T SEE IT...&WHERE IS IT...?/%%",
  "obj_mettatonb_third_848": "DID YOU./",
  "obj_mettatonb_third_849": "JUST FLIP./",
  "obj_mettatonb_third_850": "MY SWITCH?/%%",
  "obj_mettatonb_third_943": "THAT WORTHLESS PEA-&SHOOTER WON'T WORK&ON ME, DARLING. ^3 %",
  "obj_mettatonb_third_944": "DON'T YOU UNDERSTAND&WHAT ACTING IS!?^3 %%",
  "obj_mettatonb_third_952": "* Mettaton.",
  "obj_mettatonex_167": ".../%%",
  "obj_mettatonex_190": "Lights!&Camera!&Action!/%%",
  "obj_mettatonex_196": "Drama!&Romance!&Blood-&shed!/%%",
  "obj_mettatonex_202": "I'm the&idol&everyone&craves!/%%",
  "obj_mettatonex_208": "Smile&for the&camera!/%%",
  "obj_mettatonex_214": "Oooh, it's time&for a pop quiz!/",
  "obj_mettatonex_215": "I hope you brought&a keyboard.../",
  "obj_mettatonex_215_console": "Have fun with that&on-screen keyboard.../",
  "obj_mettatonex_216": "This one's an&essay question!/%%",
  "obj_mettatonex_222": "Your essay really&showed everyone&your heart./",
  "obj_mettatonex_223": "Why don't I show&you mine?/%%",
  "obj_mettatonex_231": "Ooooh,&I'm just&warming&up!/%%",
  "obj_mettatonex_237": "But how are you&on the dance floor!?/%%",
  "obj_mettatonex_244": "Can you&keep up&the&pace!?/%%",
  "obj_mettatonex_253": "Lights!&Camera&Bombs!/%%",
  "obj_mettatonex_259": "Things&are&blowing&up!/%%",
  "obj_mettatonex_267": "Time for our union-&regulated break!/%%",
  "obj_mettatonex_274": "We've grown so&distant, darling.../",
  "obj_mettatonex_275": "How about another&heart-to-heart?/%%",
  "obj_mettatonex_285": "A.. arms?&Wh... who needs arms&with legs like&these?/",
  "obj_mettatonex_286": "I'm still going&to win!/%%",
  "obj_mettatonex_297": "Come on&...!/%%",
  "obj_mettatonex_307": "The show&...&must go&on!/%%",
  "obj_mettatonex_317": "Dr...&Drama!&A...&Action!/%%",
  "obj_mettatonex_329": "\\E5L... lights...&C... camera.../",
  "obj_mettatonex_330": "Enough of this!&Do you really want&humanity to perish!?/",
  "obj_mettatonex_331": "\\E7... or do you just&believe in yourself&that much?/%%",
  "obj_mettatonex_353": "Haha, how inspiring!/",
  "obj_mettatonex_354": "Well, darling!&It's either me&or you!/",
  "obj_mettatonex_355": "\\E4But I think we both&already know who's&going to win./",
  "obj_mettatonex_356": "\\E8Witness the true&power of humanity's&star!/%%",
  "obj_mettatonex_368": "... then.../",
  "obj_mettatonex_369": "\\E8Are YOU the star?/",
  "obj_mettatonex_370": "Can you really&protect humanity!?/%%",
  "obj_mettatonex_638": "* Mettaton.",
  "obj_mettatonex_639": "* Mettaton.",
  "obj_mettatonex_640": "* Mettaton.",
  "obj_mettatonex_641": "* Mettaton.",
  "obj_mettatonex_642": "* Smells like Mettaton.",
  "obj_mettatonex_644": "* Mettaton has low HP.",
  "obj_mettatonex_677": "* METTATON EX - ATK 47 DEF 47&* His weak point is his&  heart-shaped core./^",
  "obj_mettatonex_691": "* You say you aren't going&  to get hit at ALL./",
  "obj_mettatonex_692": "* Ratings gradually increase&  during Mettaton's turn./^",
  "obj_mettatonex_706": "* You posed dramatically^1.&* The audience nods./^",
  "obj_mettatonex_708": "* Despite being hurt^1, you&  posed dramatically^1.&* The audience applauds./^",
  "obj_mettatonex_710": "* Despite being wounded^1, you&  posed dramatically^1.&* The audience gasps./^",
  "obj_mettatonex_712": "* With the last of your power^1,&  you pose dramatically^1.&* The audience screams./^",
  "obj_mettatonex_726": "* You turn and scoff at the&  audience./",
  "obj_mettatonex_727": "* They're rooting for your&  destruction this turn!/^",
  "obj_mettatonex_770": "H.. ha.../",
  "obj_mettatonex_771": "So I was wrong./",
  "obj_mettatonex_772": "Darling.../",
  "obj_mettatonex_773": "\\E1You really are&strong enough to&get past ASGORE./",
  "obj_mettatonex_774": "\\E0Well then.../",
  "obj_mettatonex_775": "It's time for&you to go./",
  "obj_mettatonex_776": "\\E0Don't worry about&me./",
  "obj_mettatonex_777": "I might seem like&I'm dying now^1,&but.../",
  "obj_mettatonex_778": "\\E1Dr. Alphys can&always repair me./",
  "obj_mettatonex_779": "\\E0And... besides.../",
  "obj_mettatonex_780": "Even if I'm not&cut out to be&a star.../",
  "obj_mettatonex_781": "\\E1I still got to&perform for a&human, didn't I?/",
  "obj_mettatonex_782": "So, thank you,&darling.../%%",
  "obj_mettatonex_804": "\\E1You've been a&great audience!/%%",
  "obj_mettatonex_836": "OOH^1, LOOK AT&THESE RATINGS!!!/",
  "obj_mettatonex_837": "\\E6THIS IS THE MOST&VIEWERS I'VE EVER&HAD!!!/",
  "obj_mettatonex_838": "WE'VE REACHED THE&VIEWER CALL-IN&MILESTONE!/",
  "obj_mettatonex_839": "\\E8ONE LUCKY VIEWER&WILL HAVE THE CHANCE&TO TALK TO ME.../",
  "obj_mettatonex_840": "\\E7... BEFORE I LEAVE&THE UNDERGROUND&FOREVER!!/",
  "obj_mettatonex_841": "\\E9LET'S SEE WHO&CALLS IN FIRST!/%%",
  "obj_mettatonex_866": "\\E0HI^1, YOU'RE ON TV!/",
  "obj_mettatonex_867": "WHAT DO YOU HAVE&TO SAY ON THIS^1,&OUR LAST SHOW???/%%",
  "obj_mettatonex_880": "...../",
  "obj_mettatonex_881": "oh......../",
  "obj_mettatonex_882": "\\E1hi..^1.&mettaton.../",
  "obj_mettatonex_883": "i really liked&watching your show.../",
  "obj_mettatonex_884": "my life is pretty&boring..^1. but.../",
  "obj_mettatonex_885": "seeing you on the&screen..^1. brought&excitement to my&life..^1. vicariously/",
  "obj_mettatonex_886": "i can't tell^1, but..^1.&i guess this is&the last episode...?/",
  "obj_mettatonex_887": "\\E3i'll miss you..^1.&mettaton....../",
  "obj_mettatonex_888": "... oh...^1. i didn't&mean to talk so&long.../",
  "obj_mettatonex_889": "\\E2oh........../%%",
  "obj_mettatonex_900": "NO^1, WAIT^1!&WAIT^1, BL.../",
  "obj_mettatonex_901": "\\E1H..^1.&THEY ALREADY HUNG&UP./",
  "obj_mettatonex_902": "\\E3.../",
  "obj_mettatonex_903": "\\E0I'LL TAKE ANOTHER&CALLER!!!/%%",
  "obj_mettatonex_915": "\\E1Mettaton^1, your show&made us so happy!/%%",
  "obj_mettatonex_928": "Mettaton^1, I don't&know what I'll&watch without you./%%",
  "obj_mettatonex_941": "Mettaton^1, there's&a Mettaton-shaped&hole in my Mettaton-&shaped heart./%%",
  "obj_mettatonex_964": "\\E3AH..^1. I.../",
  "obj_mettatonex_965": "I SEE.../",
  "obj_mettatonex_966": "\\E4.../",
  "obj_mettatonex_967": "EVERYONE..^1.&THANK YOU SO MUCH./",
  "obj_mettatonex_968": ".../",
  "obj_mettatonex_969": "\\E0DARLING./",
  "obj_mettatonex_970": "\\E1PERHAPS..^1. IT MIGHT BE&BETTER IF I STAY&HERE FOR A WHILE./",
  "obj_mettatonex_971": "\\E2HUMANS ALREADY HAVE&STARS AND IDOLS^1,&BUT MONSTERS.../",
  "obj_mettatonex_972": "\\E0THEY ONLY HAVE ME./",
  "obj_mettatonex_973": "\\E1IF I LEFT..^1.&THE UNDERGROUND WOULD&LOSE ITS SPARK./",
  "obj_mettatonex_974": "\\E3I'D LEAVE AN ACHING&VOID THAT CAN NEVER&BE FILLED./",
  "obj_mettatonex_975": "\\E0SO..^1. I THINK I'LL&HAVE TO DELAY MY&BIG DEBUT./",
  "obj_mettatonex_976": "\\E2BESIDES./",
  "obj_mettatonex_977": "\\E1YOU'VE PROVEN TO&BE VERY STRONG./",
  "obj_mettatonex_978": "\\E0PERHAPS..^1. EVEN STRONG&ENOUGH TO GET PAST&ASGORE./",
  "obj_mettatonex_979": "\\E0I'M SURE YOU'LL BE&ABLE TO PROTECT&HUMANITY./",
  "obj_mettatonex_980": "\\E4HA^1, HA.../",
  "obj_mettatonex_981": "IT'S ALL FOR THE&BEST^1, ANYWAY./",
  "obj_mettatonex_982": "\\E3THE TRUTH IS^1, THIS&FORM'S ENERGY&CONSUMPTION IS.../",
  "obj_mettatonex_983": "INEFFICIENT./",
  "obj_mettatonex_984": "IN A FEW MOMENTS^1,&I'LL RUN OUT OF&BATTERY POWER^1, AND.../",
  "obj_mettatonex_985": "\\E4WELL./",
  "obj_mettatonex_986": "\\E0I'LL BE ALRIGHT./",
  "obj_mettatonex_987": "\\E5KNOCK 'EM DEAD^1,&DARLING./",
  "obj_mettatonex_988": "\\E0AND EVERYONE..^1.&THANK YOU./",
  "obj_mettatonex_989": "YOU'VE BEEN A&GREAT AUDIENCE!/%%",
  "obj_mettboss_event_170": "* REALLY^1?&* WHERE?/%%",
  "obj_mettboss_event_187": "* CLEVER..^1.&* VERY CLEVER./%%",
  "obj_mettboss_event_230": "* OH YES.&* THERE YOU ARE, DARLING./",
  "obj_mettboss_event_231": "* IT'S TIME TO HAVE OUR&  LITTLE SHOWDOWN./",
  "obj_mettboss_event_232": "* IT'S TIME TO FINALLY STOP&  THE \"MALFUNCTIONING\" ROBOT./",
  "obj_mettboss_event_233": "* ... NOT!!!/",
  "obj_mettboss_event_234": "* MALFUNCTION?&* REPROGRAMMING?&* GET REAL./",
  "obj_mettboss_event_235": "* THIS WAS ALL JUST A BIG&  SHOW./",
  "obj_mettboss_event_236": "* AN ACT./",
  "obj_mettboss_event_237": "* ALPHYS HAS BEEN PLAYING&  YOU FOR A FOOL THE&  WHOLE TIME./",
  "obj_mettboss_event_238": "* AS SHE WATCHED YOU ON THE&  SCREEN^1, SHE GREW ATTACHED&  TO YOUR ADVENTURE./",
  "obj_mettboss_event_239": "* SHE DESPERATELY WANTED TO&  BE A PART OF IT./",
  "obj_mettboss_event_240": "* SO SHE DECIDED TO INSERT&  HERSELF INTO YOUR STORY./",
  "obj_mettboss_event_241": "* SHE REACTIVATED PUZZLES^1.&* SHE DISABLED ELEVATORS^1.&* SHE ENLISTED ME TO TORMENT YOU./",
  "obj_mettboss_event_242": "* ALL SO SHE COULD SAVE&  YOU FROM DANGERS THAT&  DIDN'T EXIST./",
  "obj_mettboss_event_243": "* ALL SO YOU WOULD THINK&  SHE'S THE GREAT PERSON.../",
  "obj_mettboss_event_244": "* THAT SHE'S NOT./",
  "obj_mettboss_event_245": "* AND NOW^1, IT'S TIME FOR&  HER FINEST HOUR./",
  "obj_mettboss_event_247": "* AT THIS VERY MOMENT,&  ALPHYS IS WAITING OUTSIDE&  THE ROOM./",
  "obj_mettboss_event_248": "* DURING OUR \"BATTLE,\" SHE&  WILL INTERRUPT./",
  "obj_mettboss_event_249": "* SHE WILL PRETEND TO&  \"DEACTIVATE\" ME, \"SAVING\" YOU&  ONE FINAL TIME./",
  "obj_mettboss_event_250": "* FINALLY.&* SHE'LL BE THE HEROINE OF&  YOUR ADVENTURE./",
  "obj_mettboss_event_251": "* YOU'LL REGARD HER SO HIGHLY&  SHE'LL EVEN BE ABLE TO&  CONVINCE YOU NOT TO LEAVE./",
  "obj_mettboss_event_252": "* ... OR NOT./",
  "obj_mettboss_event_253": "* YOU SEE, I'VE HAD ENOUGH OF&  THIS PREDICTABLE CHARADE./",
  "obj_mettboss_event_254": "* I HAVE NO DESIRE TO HARM&  HUMANS.&* FAR FROM IT, ACTUALLY./",
  "obj_mettboss_event_255": "* MY ONLY DESIRE IS TO&  ENTERTAIN./",
  "obj_mettboss_event_256": "* AFTER ALL, THE AUDIENCE&  DESERVES A GOOD SHOW,&  DON'T THEY?/",
  "obj_mettboss_event_257": "* AND WHAT'S A GOOD SHOW.../",
  "obj_mettboss_event_258": "* WITHOUT A PLOT TWIST?/%%",
  "obj_mettboss_event_263": "* MY^1, MY^1.&* SO YOU'VE FINALLY ARRIVED./",
  "obj_mettboss_event_264": "* AFTER OUR FIRST MEETING^1, I&  REALIZED..^1.&* SOMETHING GHASTLY./",
  "obj_mettboss_event_265": "* YOU'RE NOT JUST A THREAT&  TO MONSTERS..^1.&* BUT HUMANITY^1, AS WELL./",
  "obj_mettboss_event_266": "* OH MY^1.&* THAT'S AN ISSUE./",
  "obj_mettboss_event_267": "* YOU SEE^1, I CAN'T BE A&  STAR WITHOUT AN AUDIENCE./",
  "obj_mettboss_event_268": "* AND BESIDES.../",
  "obj_mettboss_event_269": "* THERE ARE SOME PEOPLE..^1.&* I WANT TO PROTECT./%%",
  "obj_mettboss_event_303": "* H-hey!!^1!&* Wh-wh-what's going on!?/",
  "obj_mettboss_event_304": "* Th-th-the door just&  locked itself!/%%",
  "obj_mettboss_event_321": "\\M1* SORRY^1, FOLKS^1!&* THE OLD PROGRAM'S BEEN&  CANCELLED!!!/",
  "obj_mettboss_event_322": "* BUT WE'VE GOT A FINALE&  THAT WILL DRIVE YOU WILD!!/%%",
  "obj_mettboss_event_341": "\\M5* REAL DRAMA!!&* REAL ACTION!!&* REAL BLOODSHED!!/",
  "obj_mettboss_event_342": "* ON OUR NEW SHOW.../",
  "obj_mettboss_event_343": "* \"ATTACK OF THE KILLER&  ROBOT!\"/%%",
  "obj_mettboss_event_411": "* AH HA HA^1.&* EAGER, AS ALWAYS, EH?/",
  "obj_mettboss_event_412": "* BUT DON'T TOUCH THAT DIAL.&* THERE'S SOMETHING YOU&  HAVEN'T ACCOUNTED FOR./",
  "obj_mettboss_event_413": "* AS ANY TRUE FAN WOULD KNOW,&  I WAS FIRST CREATED AS&  A HUMAN ERADICATION ROBOT./",
  "obj_mettboss_event_414": "* IT WAS ONLY AFTER BECOMING A&  STAR THAT I WAS GIVEN A&  MORE... PHOTOGENIC BODY./",
  "obj_mettboss_event_415": "* HOWEVER./",
  "obj_mettboss_event_416": "* THOSE ORIGINAL FUNCTIONS&  HAVE NEVER BEEN FULLY&  REMOVED.../",
  "obj_mettboss_event_417": "* COME ANY CLOSER, AND&  I'LL BE FORCED TO SHOW&  YOU.../",
  "obj_mettboss_event_418": "\\M5* MY TRUE FORM!/%%",
  "obj_mettboss_event_443": "\\M0* FINE THEN!/",
  "obj_mettboss_event_444": "\\M5* RRRRREADY^1?&* IIIIIIIT'S SHOWTIME!!!/%%",
  "obj_mettdestroyed_event_169": "* I..^1. I managed to open&  the lock^1!&* Are you two.../%%",
  "obj_mettdestroyed_event_197": "* Oh my god./%%",
  "obj_mettdestroyed_event_222": "* Mettaton!/",
  "obj_mettdestroyed_event_223": "\\E1* Mettaton^1, are you.../%%",
  "obj_mettdestroyed_event_244": "* H..^1. hey.../",
  "obj_mettdestroyed_event_245": "* D..^1. don't worry&  about it.../",
  "obj_mettdestroyed_event_246": "* I can always.../",
  "obj_mettdestroyed_event_247": "\\E5* I can always build&  a different robot!/",
  "obj_mettdestroyed_event_248": "\\E6* .../",
  "obj_mettdestroyed_event_249": "\\E5* Why don't you go&  on ahead?/%%",
  "obj_mettdestroyed_event_254": "* ... thank GOD^1, it's just&  the batteries./",
  "obj_mettdestroyed_event_255": "\\E9* Mettaton^1, if you were&  gone^1, I would have..^1.&* I would have.../",
  "obj_mettdestroyed_event_256": "\\E8* .../",
  "obj_mettdestroyed_event_257": "\\E6* I m-mean^1, h-hey^1, it's&  n-^1no problem^1, you&  know?/",
  "obj_mettdestroyed_event_258": "\\E5* He's just a robot^1, if&  you messed it up^1, I&  c-could always.../",
  "obj_mettdestroyed_event_259": "\\E6* J-just build another./",
  "obj_mettdestroyed_event_260": "\\E4* .../",
  "obj_mettdestroyed_event_261": "* Why don't you go&  on ahead?/%%",
  "obj_metteggs_58": "* (You found the eggs.)/%%",
  "obj_mettmilk_58": "* (You found the milk.)/%%",
