if (image_yscale > 1 && image_xscale > 1)
{
    for (j = 1; j <= image_yscale; j += 1)
    {
        if (j < image_yscale)
            draw_sprite(spr_waterfall_midleft, (siner / 5), x, (y + (j * 20)))
        if (j == image_yscale)
            draw_sprite(spr_waterfall_bottomleft, (siner / 5), x, ((y + (j * 20)) - 20))
        for (i = 1; i <= image_xscale; i += 1)
        {
