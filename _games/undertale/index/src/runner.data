  "obj_actiontable_69": "YEAH^1!!&THAT'S RIGHT!/",
  "obj_actiontable_70": "SANTA!!!!/%%",
  "obj_actiontable_72": "* (Action figures of many&  sexy robots.)/%%",
  "obj_actiontable_76": "* (Action figures of many&  sexy robots.)/%%",
  "obj_adate_125": "        DATING^1  STAR^5T^2.^2.^2.^3?%%",
  "obj_adate_142": "Uhhh^1, sorry^2!&I'm still getting&dressed!/%%",
  "obj_adate_170": "H-how do I look?/",
  "obj_adate_171": "My friend helped me&pick out this&dress./",
  "obj_adate_172": "\\E1S\\M0he's got a great&sense of.../",
  "obj_adate_173": "\\E0Um^1, anyway^1!&Let's do this thing!/%%",
