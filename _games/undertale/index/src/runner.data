  "SCR_TEXT_4299": " %%",
  "SCR_TEXT_4304": "* IT SEEMS OUR REPORTER IS DRAWN&  TO SPORTS LIKE MOTHS TO A&  FLAMING BASKETBALL HOOP./",
  "SCR_TEXT_4305": "\\M2* (REPORT THIS ONE?)& &         Report      Look More\\C",
  "SCR_TEXT_4306": " ",
