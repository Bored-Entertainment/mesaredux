  "obj_womandog_247": "(Don't,&actually&...)",
  "obj_womandog_248": "(He&means&me.)",
  "obj_womandog_249": "(Of&course&we were&second.)",
  "obj_womandog_250": "(Do&humans&have&tails?)",
  "obj_womandog_256": "(Smell&mystery)",
  "obj_womandog_257": "(Are you&actually&a little&puppy!?)",
  "obj_womandog_261": "(Beware&of&dog.)",
