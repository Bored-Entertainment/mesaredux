  "obj_adate_199": "H-h-hey^1, w-w-wait!/",
  "obj_adate_200": "Actually^1, we still&can't start the&date yet!!!/%%",
  "obj_adate_209": "        DATING..^1.  STOP^4?%%",
  "obj_adate_221": "Umm^1, I've gotta give&you items to raise&your affection&statistic^1, first!/",
  "obj_adate_222": "That'll increase the&chance of a successful&outcome to the&date!/",
  "obj_adate_223": "\\E6Right...?/",
  "obj_adate_224": "\\E0Anyway^1, d-don't worry^1!&I'm prepared!/",
  "obj_adate_225": "\\E5I-I've been&stockpiling gifts&in anticipation&for a date like this!/",
  "obj_adate_226": "\\E7F\\M6-first^1, I've got.../",
  "obj_adate_227": "\\E5Some metal armor&polish!/",
  "obj_adate_228": "\\E3.../",
  "obj_adate_229": "\\E6Um^1, maybe you can't&use that./",
  "obj_adate_230": "\\E5But!!!/",
  "obj_adate_231": "I also brought some&waterproof cream for&your scales!/",
  "obj_adate_232": "\\E3Your^1, uh..^1.&Scales.../",
  "obj_adate_233": "\\E6Uh^1, well^1, how about.../",
  "obj_adate_234": "This magical spear&repair kit^1, that I.../",
  "obj_adate_235": "\\E7Um.../",
  "obj_adate_236": "\\E5Hey^1, let's forget&about the items!/",
  "obj_adate_237": "\\E0L\\M0et's just start&the date!/%%",
  "obj_adate_301": "        DATING!^1!  START!^3!%%",
  "obj_adate_314": "Yeah!!^1!&Let's^1, uh^1, date!/%%",
  "obj_adate_352": "... uh.../",
  "obj_adate_353": "\\E4Do you..^3. like..^3.&Anime...^2?/*",
  "obj_adate_367": "                              &   Yes             No       &                            ",
  "obj_adate_391": "H-hey^1!&Me too!!/%%",
  "obj_adate_396": "Oh./%%",
  "obj_adate_414": "Hey^1!&Let's!^1!&Go somewhere!!!/",
  "obj_adate_415": "\\E7But where's a good&place to go on&a date...?/",
  "obj_adate_416": "\\E2.../",
  "obj_adate_417": "\\E0I've got it!!!/",
  "obj_adate_418": "\\E5Let's go to the&garbage dump!!!/%%",
  "obj_adate_476": "Here we are!/",
  "obj_adate_477": "This is where Undyne&and I come all&the time.../",
  "obj_adate_478": "\\E1We find all sorts&of great stuff&here./",
  "obj_adate_479": "\\E5Heh^1, she's&really.../",
  "obj_adate_480": "\\E6Uh.../%%",
  "obj_adate_503": "Oh no./",
  "obj_adate_504": "\\E9That's her over&there./",
  "obj_adate_505": "\\M4I c-can't let her&see me on a date&with you!/",
  "obj_adate_506": "\\E6Why...?/",
  "obj_adate_507": "\\M0Because^1, uh..^1.&Well.../",
  "obj_adate_508": "\\E9Oh no^1, here she&comes!!/%%",
  "obj_adate_556": " Hey!^1!& There you are!!/",
  "obj_adate_557": "\\F2 I^1, uh^1, realized^1,& if you deliver that&  thing.../",
  "obj_adate_558": "\\F3 It might be a bad& idea./",
  "obj_adate_559": "\\F4 So I'm gonna do& it!!^1!& Give it to me!!!/",
  "obj_adate_560": "\\F3 Huh!^1?& You don't have it!?/",
  "obj_adate_561": "\\F4 Ngggaaahhh!!/",
  "obj_adate_562": " Have you at least& seen her!?/*",
  "obj_adate_576": "                              &   Yeah            Nope     &                            ",
  "obj_adate_602": " Yes?/",
  "obj_adate_603": "\\F6 So she's somewhere& around here.../",
