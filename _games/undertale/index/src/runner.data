        if (FL_DisableAlphysStatuses == 1)
            donotcall = 1
    }
    if (donotcall == 0)
        snd_play(snd_textnoise)
    if (donotcall == 0)
    {
        mb = instance_create(obj_mainchara.x, (obj_mainchara.y - 10), obj_musblcon)
        instance_create(0, 0, obj_dialoguer)
        global.interact = 1
    }
}
