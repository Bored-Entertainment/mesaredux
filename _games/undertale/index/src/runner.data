            if instance_exists(cb_a[i])
            {
                cb_a[i].x = x
                cb_a[i].y = y
            }
            with (cb_a[i])
            {
                if (abs(aa) < 1.7)
                    aa *= 1.02
                x += lengthdir_x(85, image_angle)
                y += lengthdir_y(85, image_angle)
            }
        }
        if (x > 1000 || x < -400)
            instance_destroy()
    }
}
