    {
        draw_set_color(c_fuchsia)
        rpy[i] = (rp[i] * 0.0075)
        rpy[(i + 1)] = (rp[(i + 1)] * 0.0075)
        draw_line_width(((x + 10) + (i * 20)), ((y + 130) - rpy[i]), ((x + 30) + (i * 20)), ((y + 130) - rpy[(i + 1)]), 2)
    }
